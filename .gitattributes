# Embedded shader source uses literal newlines in its composition rules.
# Keep those literals consistent even with core.autocrlf=true on Windows.
*.gd text eol=lf
*.gdshader text eol=lf
*.gdshaderinc text eol=lf

# Keep the offline RT shader manifest reproducible on Windows checkouts too.
*.hlsl text eol=lf
*.hlsli text eol=lf
game/src/game/fx/shaders/*_NOTICES.txt text eol=lf
game/src/game/fx/shaders/*_build.json text eol=lf
tools/build_water_rt_shaders.py text eol=lf
tools/build_path_sharc.py text eol=lf
tools/build_path_rtxdi.py text eol=lf
engine_patches/rtxdi-sdk.json text eol=lf

# Unified patch context deliberately prefixes tab-indented code with a space.
engine_patches/**/*.patch -whitespace

# Windows launchers need native command-file line endings.
*.cmd text eol=crlf
dev.ps1 text eol=crlf
tools/development.py text eol=lf
manifests/development.json text eol=lf
engine_patches/**/*.patch text eol=lf
tools/windows/Prepare-PT-Diagnostics.ps1 text eol=crlf

# Retain literal patch context and diagnostic logs as validation evidence.
docs/validation/path-tracing-stability-2026-10-23/*.patch -whitespace
docs/validation/path-tracing-stability-2026-10-23/**/*.log -whitespace
docs/validation/shader-preparation-2026-10-23/**/*.log -text -whitespace
