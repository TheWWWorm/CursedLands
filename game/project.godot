; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

warnings/check_invalid_track_paths=false
warnings/check_angle_interpolation_type_conflicting=false

[application]

config/name="Cursed Lands"
config/icon="res://icon.svg"
run/main_scene="res://scenes/main.tscn"
run/flush_stdout_on_print=true
config/features=PackedStringArray("4.7")
config/version="1.0.3-experimental.3"
config/project_settings_override.android="user://renderer.cfg"

[autoload]

GameData="*res://src/ei/game_data.gd"
TouchInput="*res://src/platform/touch_input.gd"
PadInput="*res://src/platform/pad_input.gd"

[debug]

file_logging/enable_file_logging=true
file_logging/enable_file_logging.web=false
file_logging/max_log_files=10

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/handheld/orientation=6

[input_devices]

sensors/enable_gyroscope=true

pointing/emulate_mouse_from_touch=false
joypads/ignore_joypad_on_unfocused_application=true

[dotnet]

project/assembly_name="Evil Islands Remake (PoC)"

[gui]

timers/tooltip_delay_sec=1000000.0

[rendering]

; Keep figure parameters resident across zone transitions.
limits/global_shader_variables/buffer_size=262144

renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
rendering_device/driver.windows="d3d12"
rendering_device/fallback_to_opengl3=true
limits/opengl/max_lights_per_object.mobile=4
limits/opengl/max_lights_per_object.web=4
lights_and_shadows/directional_shadow/size.mobile=1024
lights_and_shadows/directional_shadow/size.web=1024
lights_and_shadows/positional_shadow/atlas_size.mobile=1024
lights_and_shadows/positional_shadow/atlas_size.web=1024
anti_aliasing/quality/msaa_3d.mobile=0
anti_aliasing/quality/msaa_3d.web=0
anti_aliasing/quality/screen_space_aa.mobile=0
anti_aliasing/quality/screen_space_aa.web=0
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=5
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=5
textures/default_filters/anisotropic_filtering_level=4
environment/ssao/quality=3
environment/ssao/half_size=false
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/use_debanding=true
environment/volumetric_fog/volume_size=128
environment/volumetric_fog/volume_depth=96
anti_aliasing/quality/screen_space_aa=2
lights_and_shadows/positional_shadow/atlas_size=8192
