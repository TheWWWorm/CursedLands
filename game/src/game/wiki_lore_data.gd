				"prototypes": [
					"human mercenary kania archer"
				],
				"locations": [
					"bz8k"
				],
				"names": {
					"en": "Mairana",
					"ru": "Майрана",
					"de": "Mairana"
				},
				"name_hashes": [
					"99212705c5a3e9e6b6966d741f6d2ac733d6ea60ce4ad4905e75cab0585e40de",
					"43d1096f82fa0c4078f8ef8a64b66312a65f22df9c77f7432b6831a1be0ea398"
				]
			},
			"character/merc7": {
				"kind": "character",
				"sections": [
					{
						"heading": "Biography",
						"text": "Kharad once hunted people like the fugitives of the Last Shelter. Disillusioned by his Khadaganian superiors, he now seeks revenge and offers his fighting skills to Zak. Loyalty to the brotherhood and his unfinished quarrel with the authorities keep him in Suslanger.",
						"sources": [
							"briefing n8_7",
							"briefing n1_7",
							"briefing n10_7"
						]
					}
				],
				"role": "Companion",
				"actors": [
					"merc7"
				],
				"name_key": "pers merc7",
				"id": "merc7",
				"placements": [
					{
						"zone": "bz14h",
						"actor": "merc7",
						"prototype": "human mercenary hadagan warrior"
					}
				],
				"prototypes": [
					"human mercenary hadagan warrior"
				],
				"locations": [
					"bz14h"
				],
				"names": {
					"en": "Kharad",
					"ru": "Харад",
					"de": "Kharad"
				},
				"name_hashes": [
					"1f42ab183f3233f5a6e1bfd9ebc8c8e4778b61797b02aeaffb1f04d609fbb66c",
					"c29a7bb5141af6682439583cfab3164fad1bce10fffa8899809323b0f50aecfe"
				]
			},
			"character/merc8": {
				"kind": "character",
				"sections": [
					{
						"heading": "Biography",
						"text": "Fayrakh is a magician of the Last Shelter who sees Zak’s journey as a chance to hurt enemies on the surface. He offers magical aid without disguising his taste for revenge. His work with Kehel can delay his departure, and he ultimately prefers the Shelter to life on Gipath.",
						"sources": [
							"briefing n8_8",
							"briefing n11_8",
							"briefing n10_8"
						]
					}
				],
				"role": "Companion",
				"actors": [
					"merc8"
				],
				"name_key": "pers merc8",
				"id": "merc8",
				"placements": [
					{
						"zone": "bz14h",
						"actor": "merc8",
						"prototype": "human mercenary hadagan thief"
					}
				],
				"prototypes": [
					"human mercenary hadagan thief"
				],
				"locations": [
					"bz14h"
				],
				"names": {
					"en": "Fayrakh",
					"ru": "Файрах",
					"de": "Fayrakh"
				},
				"name_hashes": [
					"adc6cac98d8bbcff2906c62b28a6d66f62d0165b82e1e84be0c8a18331b6307e",
					"57782a1667bb65b7c13913ce287f749fb5d7db94d65b8c0431c6bd82bc55a77e"
				]
			},
			"character/merc9": {
				"kind": "character",
				"sections": [
					{
						"heading": "Biography",
						"text": "Brissen is a knight allied with the Woodsfolk who describes his life as service to good. He offers to accompany Zak after hearing of him from Grey Leaf. His methods are less gentle than his ideals sound: he explains how the Woodsfolk intimidate witnesses who might recognise him in the city.",
						"sources": [
							"briefing n8_9",
							"briefing n1_9",
							"briefing n3_9"
						]
					}
				],
				"role": "Companion",
				"actors": [
					"merc9"
				],
				"name_key": "pers merc9",
				"id": "merc9",
				"placements": [
					{
						"zone": "bz9k",
						"actor": "merc9",
						"prototype": "human mercenary kania paladin"
					}
				],
				"prototypes": [
					"human mercenary kania paladin"
				],
				"locations": [
					"bz9k"
				],
				"names": {
					"en": "Brissen",
					"ru": "Бриссен",
					"de": "Brissen"
				},
				"name_hashes": [
					"e621d1a59b319adc911badad3a801acc97b7f0d83a0332e48d32341c57f139a8",
					"4eb1548703a217944d3e3b584af9191470306f47357fef8b45c6aeaf7b3e248e"
				]
			},
			"character/merc10": {
				"kind": "character",
				"sections": [
					{
						"heading": "Biography",
						"text": "Sahilia is a thief living in the Last Shelter. Her stolen Joon antiquities give Zak a lead to the collector Baluddin, while her knowledge of hiding places and wealthy houses opens other opportunities. She can accompany him, but asks to return to Suslanger rather than stay on Gipath, where she would have few profitable targets.",
						"sources": [
							"briefing vo64",
							"briefing vo65",
							"briefing n10_10"
						]
					}
				],
				"role": "Companion",
				"actors": [
					"merc10"
				],
				"name_key": "pers merc10",
				"id": "merc10",
				"placements": [
					{
						"zone": "bz14h",
						"actor": "merc10",
						"prototype": "human mercenary hadagan rogue"
					}
				],
				"prototypes": [
					"human mercenary hadagan rogue"
				],
				"locations": [
					"bz14h"
				],
				"names": {
					"en": "Sahilia",
					"ru": "Сахиля",
					"de": "Sahilia"
				},
				"name_hashes": [
					"7d7c1981d3e183d9cd31711d9652e7adb009ad1580a5e2482180b94c5625badf",
					"1e142a1617679fda8640c5b367bcf8b3521747d4b0b2115ea094cf1714e94fa7"
				]
			},
			"allod/gipat": {
				"kind": "allod",
				"sections": [
					{
						"heading": "Setting",
						"text": "Gipath is an unclaimed allod of scattered ruins, mountains and wilderness. Its small human village shares the island with goblins, orcs and lizardmen. The apparent remoteness hides older history: Joon remains, the Dead City and the dwelling of a Great Magician all lie on the same island.",
						"sources": [
							"allod gipat",
							"zone gz9g",
							"briefing z11_1"
						]
					},
					{
						"heading": "Events in Cursed Lands",
						"text": "[[character/hero]] begins his search for his identity here. The village leaders’ disputes, [[character/witch]]’s advice and encounters with the island’s other peoples lead him to [[character/rick]]. Gipath is also the destination of his return: the truth about At-Zako and the struggle against the Curse bring the story back beneath its ruins.",
						"sources": [
							"briefing s1",
							"briefing r36",
							"briefing r72_4",
							"briefing r72_6"
						]
					}
				],
				"name_key": "allod gipat",
				"id": "gipat"
			},
			"allod/ingos": {
				"kind": "allod",
				"sections": [
					{
						"heading": "Setting",
						"text": "Ingos belongs to Cania. Its thinly populated provinces leave room for independent communities and the Woodsfolk. A governor and city guards represent imperial authority, but the original gazetteer stresses the inhabitants’ independence. Snowy country, mines, forests and older underground ruins surround the city.",
						"sources": [
							"allod ingos",
							"zone gz11k",
							"zone gz12k"
						]
					},
					{
						"heading": "The search for the Princess",
						"text": "Zak comes to Ingos to find one of the surviving Joons. Court rivalries, Karansul’s schemes and the displaced Green Clan complicate the search. The imprisoned [[character/deva]] is found in the mines, while [[character/magess]]’s jealousy helps explain her disappearance. Lu-a-Jalla’s account then sends Zak onward to Suslanger.",
						"sources": [
							"briefing r36",
							"briefing d55",
							"briefing r54"
						]
					}
				],
				"name_key": "allod ingos",
				"id": "ingos"
			},
			"allod/suslanger": {
				"kind": "allod",
				"sections": [
					{
						"heading": "Setting",
						"text": "Suslanger is a dry Khadaganian allod with little cultivable land. A river, lake, dams and irrigation channels sustain its settlements. Imperial decrees are enforced by guards and informers. Beyond that order lie necromancers’ laboratories, Wormface caverns and the hidden refuge of escaped slaves.",
						"sources": [
							"allod suslanger",
							"zone gz16h",
							"zone gz17h"
						]
					},
					{
						"heading": "The trail of At-Zako",
						"text": "Zak’s arrival leads to imprisonment by [[character/karh]], escape with [[character/nalo]]’s help and shelter under [[character/glav]]. His investigation passes from a collector of Joon antiquities to necromancers and a dead scientist. Their clues reveal how the missing Joon escaped and supply the amulet that ultimately points back to Gipath.",
						"sources": [
							"briefing kr60",
							"briefing kr61",
							"briefing gl64",
							"briefing jf67",
							"briefing sn69",
							"briefing sn69_1",
							"briefing r72_1"
						]
					}
				],
				"name_key": "allod suslanger",
				"id": "suslanger"
			},
			"map/bz1g": {
				"kind": "map",
				"sections": [
					{
						"heading": "Setting",
						"text": "The village is Gipath’s only human settlement. Here Erfar names Zak the Chosen, Gort commands the guards and Babur offers his craft. It is both Zak’s first refuge and the centre of the local conspiracy he eventually exposes.",
						"sources": [
							"zone bz1g",
							"briefing s1",
							"briefing s25_1"
						]
					}
				],
				"name_key": "zone bz1g",
				"id": "bz1g"
			},
			"map/bz2g": {
				"kind": "map",
				"sections": [
					{
						"heading": "Setting",
						"text": "Estera’s secluded cave is a place of advice, bargaining and magical instruction. The witch helps Zak investigate his missing memory, while Airy and Naya connect the cave with the wider life of the village.",
						"sources": [
							"zone bz2g",
							"briefing z1",
							"briefing n8_3"
						]
					}
				],
				"name_key": "zone bz2g",
				"id": "bz2g"
			},
			"map/bz3g": {
				"kind": "map",
				"sections": [
					{
						"heading": "Setting",
						"text": "The Old Dragon’s dwelling brings Zak face to face with a powerful, knowledgeable creature. The dragon’s information forms part of the search for the Great Magician; the meeting is a negotiation, not merely a monster encounter.",
						"sources": [
							"zone bz3g",
							"briefing dr22"
						]
					}
				],
				"name_key": "zone bz3g",
				"id": "bz3g"
			},
			"map/bz4g": {
				"kind": "map",
				"sections": [
					{
						"heading": "Setting",
						"text": "The Khadaganian expedition has established a foothold on Gipath in pursuit of the meteorite. Zak’s capture connects its officers, the Hermit Lizard and the struggle over the island’s secrets.",
						"sources": [
							"zone bz4g",
							"briefing ha29",
							"briefing l30"
						]
					}
				],
				"name_key": "zone bz4g",
				"id": "bz4g"
			},
			"map/bz5g": {
				"kind": "map",
				"sections": [
					{
						"heading": "Setting",
						"text": "The Hermit Lizard’s home is a refuge with its own urgent problem: access to water. His bargain with Zak links a rescue, the orcs’ dam and the difficult route toward the Great Magician.",
						"sources": [
							"zone bz5g",
							"briefing l34"
						]
					}
				],
				"name_key": "zone bz5g",
				"id": "bz5g"
			},
			"map/bz6g": {
				"kind": "map",
				"sections": [
					{
						"heading": "Setting",
						"text": "Shei-Var’s settlement is an orc power centre in the Sands. Airy’s captivity and the chief’s ritual plans bring Zak here. The settlement also offers a different perspective on village life through Eila, a human who chose to learn magic among the orcs.",
						"sources": [
							"zone bz6g",
							"briefing sh40",
							"briefing n8_4"
						]
					}
				],
				"name_key": "zone bz6g",
				"id": "bz6g"
			},
			"map/bz7g": {
				"kind": "map",
				"sections": [
					{
						"heading": "Setting",
						"text": "Tka-Rik’s underground dwelling is the turning point between Zak’s local search and his journey across the allods. Here the magician asks him to find surviving Joons, receives his discoveries and finally helps reveal the truth about At-Zako.",
						"sources": [
							"zone bz7g",
							"briefing r36",
							"briefing r54",
							"briefing r72_4"
						]
					}
				],
				"name_key": "zone bz7g",
				"id": "bz7g"
			},
			"map/bz8k": {
				"kind": "map",
				"sections": [
					{
						"heading": "Setting",
						"text": "The city concentrates Ingos’ official power and commerce. The governor, his captain and court magician shape Zak’s search for the Princess, while merchants and potential companions provide leads and assistance.",
						"sources": [
							"zone bz8k",
							"briefing r36",
							"briefing n8_5",
							"briefing n8_6"
						]
					}
				],
				"name_key": "zone bz8k",
				"id": "bz8k"
			},
			"map/bz9k": {
				"kind": "map",
				"sections": [
					{
						"heading": "Setting",
						"text": "The Green Clan’s home introduces Zak to the Woodsfolk and their distrust of outsiders. Their troubles, including the fate of their elder, become part of the search through Ingos.",
						"sources": [
							"zone bz9k",
							"briefing n8_9"
						]
					}
				],
				"name_key": "zone bz9k",
				"id": "bz9k"
			},
			"map/bz10k": {
				"kind": "map",
				"sections": [
					{
						"heading": "Setting",
						"text": "The Green Clan’s new residence reflects its displacement during the Ingos story. It continues to connect Zak with the Woodsfolk and Brissen, whose ideal of service to good exists beside the clan’s harsher methods.",
						"sources": [
							"zone bz10k",
							"briefing n8_9",
							"briefing n3_9"
						]
					}
				],
				"name_key": "zone bz10k",
				"id": "bz10k"
			},
			"map/bz11k": {
				"kind": "map",
				"sections": [
					{
						"heading": "Setting",
						"text": "This meeting place in the abandoned mines is associated with the imprisoned Lu-a-Jalla. Her rescue turns the search for the Princess into the search for her beloved At-Zako and opens the next stage of Zak’s journey.",
						"sources": [
							"zone bz11k",
							"briefing d55",
							"briefing r54"
						]
					}
				],
				"name_key": "zone bz11k",
				"id": "bz11k"
			},
			"map/bz13h": {
				"kind": "map",
				"sections": [
					{
						"heading": "Setting",
						"text": "The fortress is Zak’s first encounter with Suslanger’s coercive order. Kardaur controls his captivity, while the enslaved Odalisque offers a chance of escape. The conversation reveals both the authority of the fortress and resentment within its walls.",
						"sources": [
							"zone bz13h",
							"briefing kr60",
							"briefing kr61"
						]
					}
				],
				"name_key": "zone bz13h",
				"id": "bz13h"
			},
			"map/bz14h": {
				"kind": "map",
				"sections": [
					{
						"heading": "Setting",
						"text": "The Last Shelter is a concealed community of fugitives led by Brother Khatul. Its smith, fighters, thieves and disgraced necromancer help Zak investigate Suslanger. Solidarity and fear of discovery shape their decisions, while the Faceless Brother hides a danger within the refuge.",
						"sources": [
							"zone bz14h",
							"briefing gl64",
							"briefing s64",
							"briefing ne64_1"
						]
					}
				],
				"name_key": "zone bz14h",
				"id": "bz14h"
			},
			"map/bz15h": {
				"kind": "map",
				"sections": [
					{
						"heading": "Setting",
						"text": "Kholai’s tower is the setting for a bargain with an outcast necromancer. A dead scientist’s summoned spirit supplies the fragmentary testimony that changes Zak’s understanding of the missing Joon.",
						"sources": [
							"zone bz15h",
							"briefing sn67",
							"briefing sn69",
							"briefing sn69_1"
						]
					}
				],
				"name_key": "zone bz15h",
				"id": "bz15h"
			},
			"map/bz16h": {
				"kind": "map",
				"sections": [
					{
						"heading": "Setting",
						"text": "The secret trading place allows Zak to meet Baluddin, a collector of Joon antiquities. Information gained through Sahilia’s theft leads to the collector’s account of At-Zako and the imperial scholars who took him away.",
						"sources": [
							"zone bz16h",
							"briefing vo64",
							"briefing jf67"
						]
					}
				],
				"name_key": "zone bz16h",
				"id": "bz16h"
			},
			"map/bz18h": {
				"kind": "map",
				"sections": [
					{
						"heading": "Setting",
						"text": "This cave meeting exposes the Faceless Brother’s identity. Erfar tells Zak about his past on Suslanger, his meteorite scheme and the ambush he has arranged. It closes the village conspiracy’s thread far from the village itself.",
						"sources": [
							"zone bz18h",
							"briefing s71",
							"briefing s71_1"
						]
					}
				],
				"name_key": "zone bz18h",
				"id": "bz18h"
			}
		},
		"lost_in_astral": {
			"character/hero": {
				"kind": "character",
				"sections": [
					{
						"heading": "A fugitive from Jigran",
						"text": "[[character/hero]] is the Joon protagonist of Lost in Astral. He escaped from [[character/firez]] on [[allod/jigran]], leaving his family enslaved, and hopes to return to free them. A recruiter’s promise of work instead leads to his enslavement on [[allod/suslanger]]. In the slave pen he meets [[character/merc2]], who saves him after a beating, gives him the short name Kir and helps plan their escape.",
						"sources": [
							"briefing brief_0",
							"briefing brief_1",
							"briefing brief_2",
							"briefing brief_119"
						]
					},
					{
						"heading": "The road home",
						"text": "Kir and Kel seek refuge, information about the Joons and a route to Gipath’s [[character/rick]]. The magician has not heard of Jigran, but the Magic Orb points them toward [[allod/ingos]]. There they become involved in the investigation of Brissen’s murder. [[character/kmage]] eventually identifies an old passage to Jigran, and Kir chooses to follow it with Kel rather than turn back.",
						"sources": [
							"briefing brief_41",
							"briefing brief_118",
							"briefing brief_149",
							"briefing brief_251",
							"briefing brief_254"
						]
					},
					{
						"heading": "Return to Jigran",
						"text": "Back on Jigran, Kir aids [[character/baron]] against Firez, frees the elder [[character/junofil]] and rescues [[character/deva]], the woman he remembered from childhood. Kel’s death while retrieving Tai-Ilara’s belongings makes him confront the difference between that childhood attachment and Kel’s loyalty. Firez later reveals that he too is a Joon and claims that his necromancy was meant to protect their people from the Curse. This is Firez’s justification, not an endorsement of his actions.",
						"sources": [
							"briefing brief_304",
							"briefing brief_340",
							"briefing brief_341",
							"briefing brief_342",
							"briefing brief_345",
							"briefing brief_349"
						]
					}
				],
