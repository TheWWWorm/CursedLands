					"5f010163df7f1f082b1eb370f3769bc9873172128cb035ad8ecdc8eebcc4e589"
				]
			},
			"character/merc6": {
				"kind": "character",
				"sections": [
					{
						"heading": "Biography",
						"text": "Mairana is an Ingos archer who offers Zak protection outside the city walls. She seeks the experience needed to enter the Mercenaries’ Guild rather than immediate pay. Ingos remains her home, and she declines to leave it when Zak’s search moves on.",
						"sources": [
							"briefing n8_6",
							"briefing n1_6",
							"briefing n10_6"
						]
					}
				],
				"role": "Companion",
				"actors": [
					"merc6"
				],
				"name_key": "pers merc6",
				"id": "merc6",
				"placements": [
					{
						"zone": "bz8k",
						"actor": "merc6",
						"prototype": "human mercenary kania archer"
					}
