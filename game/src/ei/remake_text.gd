	"Internet games: %d": ["Игры в интернете: %d", "Internetspiele: %d"],
	"Could not reach the game directory.": ["Не удалось связаться с каталогом игр.", "Das Spieleverzeichnis ist nicht erreichbar."],
	"Could not list your game. Check the directory and public address.": ["Не удалось добавить игру. Проверьте каталог и внешний адрес.", "Dein Spiel konnte nicht eingetragen werden. Prüfe das Verzeichnis und die öffentliche Adresse."],
	"Your game is listed on the internet.": ["Ваша игра добавлена в каталог интернета.", "Dein Spiel ist im Internet eingetragen."],
	"List my hosted game publicly": ["Добавить мой сервер в открытый каталог", "Mein gehostetes Spiel öffentlich eintragen"],
	"Public join address (blank: detect IP and port)": ["Внешний адрес игры (пусто: определить IP и порт)", "Öffentliche Spieladresse (leer: IP und Port erkennen)"],
	"Your router must allow connections to the game's port.": ["Роутер должен пропускать подключения к порту игры.", "Dein Router muss Verbindungen zum Spielport zulassen."],
	"This game uses another protocol.": ["У этой игры другая версия протокола.", "Dieses Spiel verwendet ein anderes Protokoll."],
	"Browser players need a wss:// game address.": ["Для игры в браузере нужен адрес с wss://.", "Browser-Spieler brauchen eine Spieladresse mit wss://."],
	"Use address": ["Выбрать адрес", "Adresse übernehmen"],
}
