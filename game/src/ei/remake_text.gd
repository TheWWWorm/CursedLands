class_name RemakeText
extends RefCounted
## Translations of the remake's own texts (options, co-op screen, setup,
## messages) — texts.res has none of them. The original has no language
## choice: the language follows the edition supplied (`detect`, run by
## GameData._open_text_archives): code page 1251 → Russian, the German
## texts.res (umlauts) → German, else English. Before any game data is open
## (the first-run setup screen) the system locale picks among the three.
## Keys are the English texts; a missing one stays English. Format arguments
## are filled in by the caller after `t`.

static var lang := _os_lang()


static func _os_lang() -> String:
	var l := OS.get_locale_language()
	return l if l in ["ru", "de"] else "en"


## The edition's language from its texts.res (EIText.code_page already set):
## English and German are both Windows-1252; the English "string" entries have
## no ä ö ü ß Ä Ö Ü at all, the German ones thousands.
static func detect(texts: EIResArchive) -> String:
	if texts == null:
		return _os_lang()
	if EIText.code_page == 1251:
		return "ru"
	var umlauts := 0
	for n: String in texts.entries:
		if not n.begins_with("string "):
			continue
		for b in texts.read(n):
			if b in [0xc4, 0xd6, 0xdc, 0xe4, 0xf6, 0xfc, 0xdf]:
				umlauts += 1
	return "de" if umlauts >= 50 else "en"


## The text `en` in the edition's language.
static func t(en: String) -> String:
	if lang == "en":
		return en
	var tr: Array = TEXTS.get(en, [])
	var i := 0 if lang == "ru" else 1
	return String(tr[i]) if tr.size() > i and String(tr[i]) != "" else en


## `t` of each element (e.g. a [label, tip] pair).
static func tl(list: Array) -> Array:
	return list.map(func(s): return t(String(s)))


