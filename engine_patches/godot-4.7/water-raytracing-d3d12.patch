+RID RenderingDevice::_shader_create_from_spirv_and_dxil(const Ref<RDShaderSPIRV> &p_spirv, const Dictionary &p_dxil, const String &p_shader_name) {
+	ERR_FAIL_COND_V(p_spirv.is_null(), RID());
+	ERR_FAIL_COND_V(!has_feature(SUPPORTS_RAYTRACING_PIPELINE), RID());
+	Vector<ShaderStageSPIRVData> stages;
+	HashMap<ShaderStage, Vector<uint8_t>> libraries;
+	for (int i = SHADER_STAGE_RAYGEN; i < SHADER_STAGE_MAX; i++) {
+		ShaderStage stage = ShaderStage(i);
+		ERR_FAIL_COND_V_MSG(!p_spirv->get_stage_compile_error(stage).is_empty(), RID(), "Invalid DXR shader reflection.");
+		ShaderStageSPIRVData data;
+		data.shader_stage = stage;
+		data.spirv = p_spirv->get_stage_bytecode(stage);
+		if (data.spirv.is_empty()) { continue; }
+		ERR_FAIL_COND_V(!p_dxil.has(i) || p_dxil[i].get_type() != Variant::PACKED_BYTE_ARRAY, RID());
+		Vector<uint8_t> dxil = p_dxil[i];
+		ERR_FAIL_COND_V_MSG(dxil.size() < 32 || memcmp(dxil.ptr(), "DXBC", 4) != 0, RID(), "Invalid DXIL library.");
+		stages.push_back(data);
+		libraries[stage] = dxil;
+	}
+	ERR_FAIL_COND_V(stages.is_empty() || stages.size() != p_dxil.size(), RID());
+	Ref<RenderingShaderContainer> container = driver->get_shader_container_format().create_container();
+	ERR_FAIL_COND_V(!container->set_code_from_spirv_and_dxil(p_shader_name, stages, libraries), RID());
+	return shader_create_from_bytecode(container->to_bytes());
+}
