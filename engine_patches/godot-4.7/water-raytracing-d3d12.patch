+// DXR backend for the existing RenderingDevice ray-tracing command graph.
+// Native DXIL libraries use SPIR-V reflection and the existing descriptor ABI.
+#include "rendering_device_driver_d3d12.h"
+
+// The pinned DirectX-Headers provides Device5's MinGW UUID but omits these
+// three DXR interfaces. Match their stable IIDs from d3d12.h.
+#ifdef __MINGW32__
+__CRT_UUID_DECL(ID3D12GraphicsCommandList4, 0x8754318e, 0xd3a9, 0x4541, 0x98, 0xcf, 0x64, 0x5b, 0x50, 0xdc, 0x48, 0x74)
+__CRT_UUID_DECL(ID3D12StateObject, 0x47016943, 0xfca8, 0x4594, 0x93, 0xea, 0xaf, 0x25, 0x8b, 0x55, 0x34, 0x6d)
+__CRT_UUID_DECL(ID3D12StateObjectProperties, 0xde5fa827, 0x9bf9, 0x4f26, 0x89, 0xff, 0xd7, 0xf5, 0x6f, 0xde, 0x38, 0x60)
+#endif
+
+using Microsoft::WRL::ComPtr;
+
+bool RenderingDeviceDriverD3D12::_acceleration_structure_allocate(AccelerationStructureInfo *p_info) {
+	D3D12_RAYTRACING_ACCELERATION_STRUCTURE_PREBUILD_INFO sizes = {};
+	raytracing_device->GetRaytracingAccelerationStructurePrebuildInfo(&p_info->inputs, &sizes);
+	ERR_FAIL_COND_V(!sizes.ResultDataMaxSizeInBytes || sizes.ScratchDataSizeInBytes > UINT32_MAX, false);
+	p_info->scratch_size = uint32_t(sizes.ScratchDataSizeInBytes);
+	p_info->buffer = buffer_create(sizes.ResultDataMaxSizeInBytes,
+			BUFFER_USAGE_ACCELERATION_STRUCTURE_STORAGE_BIT | BUFFER_USAGE_STORAGE_BIT | BUFFER_USAGE_DEVICE_ADDRESS_BIT,
+			MEMORY_ALLOCATION_TYPE_GPU, UINT64_MAX);
+	return p_info->buffer != BufferID();
+}
+
+RDD::AccelerationStructureID RenderingDeviceDriverD3D12::blas_create(VectorView<AccelerationStructureGeometry> p_geometries, BitField<AccelerationStructureFlagBits> p_flags) {
+	ERR_FAIL_NULL_V(raytracing_device.Get(), AccelerationStructureID());
+	auto *info = memnew(AccelerationStructureInfo);
+	info->geometries.resize(p_geometries.size());
+	for (uint32_t i = 0; i < p_geometries.size(); i++) {
+		const auto &g = p_geometries[i];
+		auto &desc = info->geometries[i];
+		desc = {};
+		desc.Type = D3D12_RAYTRACING_GEOMETRY_TYPE_TRIANGLES;
+		desc.Flags = D3D12_RAYTRACING_GEOMETRY_FLAGS(uint64_t(g.flags));
+		desc.Triangles.VertexBuffer.StartAddress = buffer_get_device_address(g.vertex_buffer) + g.vertex_offset;
+		desc.Triangles.VertexBuffer.StrideInBytes = g.vertex_stride;
+		desc.Triangles.VertexCount = g.vertex_count;
+		desc.Triangles.VertexFormat = RD_TO_D3D12_FORMAT[g.vertex_format].general_format;
+		info->input_buffers.push_back(g.vertex_buffer);
+		if (g.index_buffer != BufferID()) {
+			desc.Triangles.IndexBuffer = buffer_get_device_address(g.index_buffer) + g.index_offset;
+			desc.Triangles.IndexCount = g.index_count;
+			desc.Triangles.IndexFormat = g.index_format == INDEX_BUFFER_FORMAT_UINT16 ? DXGI_FORMAT_R16_UINT : DXGI_FORMAT_R32_UINT;
+			info->input_buffers.push_back(g.index_buffer);
+		}
+	}
+	info->inputs.Type = D3D12_RAYTRACING_ACCELERATION_STRUCTURE_TYPE_BOTTOM_LEVEL;
+	info->inputs.Flags = D3D12_RAYTRACING_ACCELERATION_STRUCTURE_BUILD_FLAGS(uint64_t(p_flags));
+	info->inputs.DescsLayout = D3D12_ELEMENTS_LAYOUT_ARRAY;
+	info->inputs.NumDescs = info->geometries.size();
+	info->inputs.pGeometryDescs = info->geometries.ptr();
+	if (!_acceleration_structure_allocate(info)) { memdelete(info); return AccelerationStructureID(); }
+	return AccelerationStructureID(info);
+}
+
+RDD::AccelerationStructureID RenderingDeviceDriverD3D12::tlas_create(uint32_t p_max_instance_count, BitField<AccelerationStructureFlagBits> p_flags) {
+	ERR_FAIL_NULL_V(raytracing_device.Get(), AccelerationStructureID());
+	auto *info = memnew(AccelerationStructureInfo);
+	info->inputs.Type = D3D12_RAYTRACING_ACCELERATION_STRUCTURE_TYPE_TOP_LEVEL;
+	info->inputs.Flags = D3D12_RAYTRACING_ACCELERATION_STRUCTURE_BUILD_FLAGS(uint64_t(p_flags));
+	info->inputs.DescsLayout = D3D12_ELEMENTS_LAYOUT_ARRAY;
+	info->inputs.NumDescs = MAX(1u, p_max_instance_count);
+	if (!_acceleration_structure_allocate(info)) { memdelete(info); return AccelerationStructureID(); }
+	return AccelerationStructureID(info);
+}
+
+void RenderingDeviceDriverD3D12::acceleration_structure_instance_write(uint8_t *r_driver_instance, const AccelerationStructureInstance &p_instance) {
+	auto *desc = reinterpret_cast<D3D12_RAYTRACING_INSTANCE_DESC *>(r_driver_instance);
+	*desc = {};
+	for (uint32_t row = 0; row < 3; row++) {
+		for (uint32_t col = 0; col < 3; col++) { desc->Transform[row][col] = p_instance.transform.basis.rows[row][col]; }
+		desc->Transform[row][3] = p_instance.transform.origin[row];
+	}
+	desc->InstanceID = p_instance.id;
+	desc->InstanceMask = p_instance.mask;
+	desc->InstanceContributionToHitGroupIndex = p_instance.hit_sbt_offset;
+	desc->Flags = uint64_t(p_instance.flags);
+	if (p_instance.blas) {
+		auto *blas = reinterpret_cast<AccelerationStructureInfo *>(p_instance.blas.id);
+		desc->AccelerationStructure = buffer_get_device_address(blas->buffer);
+	}
+}
+
+void RenderingDeviceDriverD3D12::acceleration_structure_free(AccelerationStructureID p_acceleration_structure) {
+	auto *info = reinterpret_cast<AccelerationStructureInfo *>(p_acceleration_structure.id);
+	buffer_free(info->buffer);
+	memdelete(info);
+}
+
+uint32_t RenderingDeviceDriverD3D12::acceleration_structure_get_scratch_size_bytes(AccelerationStructureID p_acceleration_structure) {
+	return reinterpret_cast<AccelerationStructureInfo *>(p_acceleration_structure.id)->scratch_size;
+}
+
+void RenderingDeviceDriverD3D12::_build_acceleration_structure(CommandBufferID p_cmd_buffer, AccelerationStructureInfo *p_info, BufferID p_scratch_buffer) {
+	auto *cmd = reinterpret_cast<CommandBufferInfo *>(p_cmd_buffer.id);
+	ComPtr<ID3D12GraphicsCommandList4> list;
+	cmd->cmd_list->QueryInterface(list.GetAddressOf());
+	ERR_FAIL_NULL(list.Get());
+	if (!barrier_capabilities.enhanced_barriers_supported) {
+		for (BufferID buffer : p_info->input_buffers) {
+			_resource_transition_batch(cmd, reinterpret_cast<BufferInfo *>(buffer.id), 0, 1, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+		}
+		_resource_transition_batch(cmd, reinterpret_cast<BufferInfo *>(p_scratch_buffer.id), 0, 1, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+		_resource_transitions_flush(cmd);
+		// A rebuild can follow reads from the preceding trace, and separate
+		// structures can reuse the same scratch allocation. Order both hazards.
+		auto barrier = CD3DX12_RESOURCE_BARRIER::UAV(nullptr);
+		list->ResourceBarrier(1, &barrier);
+	}
+	D3D12_BUILD_RAYTRACING_ACCELERATION_STRUCTURE_DESC desc = {};
+	desc.Inputs = p_info->inputs;
+	desc.DestAccelerationStructureData = buffer_get_device_address(p_info->buffer);
+	desc.ScratchAccelerationStructureData = buffer_get_device_address(p_scratch_buffer);
+	list->BuildRaytracingAccelerationStructure(&desc, 0, nullptr);
+	// Legacy resources keep their AS state throughout their lifetime. Serialize
+	// builds and later traces even on devices without enhanced barriers.
+	if (!barrier_capabilities.enhanced_barriers_supported) {
+		auto barrier = CD3DX12_RESOURCE_BARRIER::UAV(reinterpret_cast<BufferInfo *>(p_info->buffer.id)->resource);
+		list->ResourceBarrier(1, &barrier);
+	}
+}
+
+void RenderingDeviceDriverD3D12::command_build_blas(CommandBufferID p_cmd_buffer, AccelerationStructureID p_acceleration_structure, BufferID p_scratch_buffer) {
+	_build_acceleration_structure(p_cmd_buffer, reinterpret_cast<AccelerationStructureInfo *>(p_acceleration_structure.id), p_scratch_buffer);
+}
+
+void RenderingDeviceDriverD3D12::command_build_tlas(CommandBufferID p_cmd_buffer, AccelerationStructureID p_acceleration_structure, BufferID p_scratch_buffer, BufferID p_instance_buffer, uint32_t p_instance_offset, uint32_t p_instance_count) {
+	auto *info = reinterpret_cast<AccelerationStructureInfo *>(p_acceleration_structure.id);
+	info->inputs.NumDescs = p_instance_count;
+	// RD retains an instance buffer even when every instance is hidden. Keep
+	// a valid address for zero-count builds as well (including through VKD3D).
+	info->inputs.InstanceDescs = buffer_get_device_address(p_instance_buffer) + (p_instance_count ? p_instance_offset : 0);
+	info->input_buffers.clear();
+	info->input_buffers.push_back(p_instance_buffer);
+	_build_acceleration_structure(p_cmd_buffer, info, p_scratch_buffer);
+}
+
+RDD::RaytracingPipelineID RenderingDeviceDriverD3D12::raytracing_pipeline_create(VectorView<PipelineShader> p_shaders, VectorView<uint32_t> p_raygen_shader_indices, VectorView<uint32_t> p_miss_shader_indices, VectorView<HitGroup> p_hit_groups, uint32_t p_max_trace_recursion_depth, ShaderID p_layout_defining_shader) {
+	ERR_FAIL_NULL_V(raytracing_device.Get(), RaytracingPipelineID());
+	ERR_FAIL_COND_V(p_max_trace_recursion_depth > D3D12_RAYTRACING_MAX_DECLARABLE_TRACE_RECURSION_DEPTH, RaytracingPipelineID());
+	const auto *layout = reinterpret_cast<const ShaderInfo *>(p_layout_defining_shader.id);
+	LocalVector<Char16String> names;
+	names.resize(p_shaders.size());
+	LocalVector<D3D12_EXPORT_DESC> exports;
+	LocalVector<D3D12_DXIL_LIBRARY_DESC> libraries;
+	LocalVector<D3D12_HIT_GROUP_DESC> hits;
+	LocalVector<Char16String> hit_names;
+	exports.resize(p_shaders.size()); libraries.resize(p_shaders.size());
+	hits.resize(p_hit_groups.size()); hit_names.resize(p_hit_groups.size());
+	LocalVector<D3D12_STATE_SUBOBJECT> subobjects;
+	subobjects.resize(p_shaders.size() + p_hit_groups.size() + 3);
+	uint32_t index = 0;
+	for (uint32_t i = 0; i < p_shaders.size(); i++) {
+		ERR_FAIL_COND_V(p_shaders[i].specialization_constants.size() != 0, RaytracingPipelineID());
+		const auto *shader = reinterpret_cast<const ShaderInfo *>(p_shaders[i].shader.id);
+		ERR_FAIL_COND_V(!shader->stages_bytecode.has(p_shaders[i].shader_stage), RaytracingPipelineID());
+		const auto &code = shader->stages_bytecode[p_shaders[i].shader_stage];
+		names[i] = ("ei_ray_" + itos(i)).utf16();
+		exports[i] = { reinterpret_cast<LPCWSTR>(names[i].ptr()), L"main", D3D12_EXPORT_FLAG_NONE };
+		libraries[i] = { { code.ptr(), SIZE_T(code.size()) }, 1, &exports[i] };
+		subobjects[index++] = { D3D12_STATE_SUBOBJECT_TYPE_DXIL_LIBRARY, &libraries[i] };
+	}
+	for (uint32_t i = 0; i < p_hit_groups.size(); i++) {
+		const auto &group = p_hit_groups[i];
+		hit_names[i] = ("ei_hit_" + itos(i)).utf16();
+		auto &hit = hits[i]; hit = {};
+		hit.HitGroupExport = reinterpret_cast<LPCWSTR>(hit_names[i].ptr());
+		hit.Type = group.intersection_shader_index == UINT32_MAX ? D3D12_HIT_GROUP_TYPE_TRIANGLES : D3D12_HIT_GROUP_TYPE_PROCEDURAL_PRIMITIVE;
+		if (group.closest_hit_shader_index != UINT32_MAX) { hit.ClosestHitShaderImport = reinterpret_cast<LPCWSTR>(names[group.closest_hit_shader_index].ptr()); }
+		if (group.any_hit_shader_index != UINT32_MAX) { hit.AnyHitShaderImport = reinterpret_cast<LPCWSTR>(names[group.any_hit_shader_index].ptr()); }
+		if (group.intersection_shader_index != UINT32_MAX) { hit.IntersectionShaderImport = reinterpret_cast<LPCWSTR>(names[group.intersection_shader_index].ptr()); }
+		subobjects[index++] = { D3D12_STATE_SUBOBJECT_TYPE_HIT_GROUP, &hit };
+	}
+	// The water payload is 72 bytes; leave room for filtering metadata. This
+	// experimental import API supports payloads up to 128 bytes and 32-byte attributes.
+	D3D12_RAYTRACING_SHADER_CONFIG shader_config = { 128, 32 };
+	D3D12_RAYTRACING_PIPELINE_CONFIG pipeline_config = { p_max_trace_recursion_depth };
+	ID3D12RootSignature *root = layout->root_signature.Get();
+	subobjects[index++] = { D3D12_STATE_SUBOBJECT_TYPE_RAYTRACING_SHADER_CONFIG, &shader_config };
+	subobjects[index++] = { D3D12_STATE_SUBOBJECT_TYPE_RAYTRACING_PIPELINE_CONFIG, &pipeline_config };
+	subobjects[index++] = { D3D12_STATE_SUBOBJECT_TYPE_GLOBAL_ROOT_SIGNATURE, &root };
+	D3D12_STATE_OBJECT_DESC desc = { D3D12_STATE_OBJECT_TYPE_RAYTRACING_PIPELINE, index, subobjects.ptr() };
+	auto *pipeline = memnew(RaytracingPipelineInfo);
+	HRESULT result = raytracing_device->CreateStateObject(&desc, IID_PPV_ARGS(pipeline->state.GetAddressOf()));
+	if (FAILED(result)) {
+		memdelete(pipeline);
+		ERR_FAIL_V_MSG(RaytracingPipelineID(), vformat("DXR pipeline creation failed: 0x%08x", uint32_t(result)));
+	}
+	pipeline->state.As(&pipeline->properties);
+	if (!pipeline->properties) { memdelete(pipeline); return RaytracingPipelineID(); }
+	pipeline->shader = layout;
+	for (uint32_t i = 0; i < p_raygen_shader_indices.size(); i++) { pipeline->groups.push_back(names[p_raygen_shader_indices[i]]); }
+	for (uint32_t i = 0; i < p_miss_shader_indices.size(); i++) { pipeline->groups.push_back(names[p_miss_shader_indices[i]]); }
+	for (const auto &name : hit_names) { pipeline->groups.push_back(name); }
+	return RaytracingPipelineID(pipeline);
+}
+
+void RenderingDeviceDriverD3D12::raytracing_pipeline_free(RaytracingPipelineID p_pipeline) {
+	memdelete(reinterpret_cast<RaytracingPipelineInfo *>(p_pipeline.id));
+}
+
+bool RenderingDeviceDriverD3D12::raytracing_pipeline_get_shader_group_handles(RaytracingPipelineID p_pipeline, uint32_t p_group_index_offset, VectorView<uint32_t> p_group_indices, uint8_t *r_data, uint32_t p_data_stride_bytes) {
+	const auto *pipeline = reinterpret_cast<const RaytracingPipelineInfo *>(p_pipeline.id);
+	ERR_FAIL_COND_V(p_data_stride_bytes < D3D12_SHADER_IDENTIFIER_SIZE_IN_BYTES, false);
+	for (uint32_t i = 0; i < p_group_indices.size(); i++) {
+		uint32_t index = p_group_index_offset + p_group_indices[i];
+		ERR_FAIL_COND_V(index >= pipeline->groups.size(), false);
+		const void *identifier = pipeline->properties->GetShaderIdentifier(reinterpret_cast<LPCWSTR>(pipeline->groups[index].ptr()));
+		ERR_FAIL_NULL_V(identifier, false);
+		memcpy(r_data + i * p_data_stride_bytes, identifier, D3D12_SHADER_IDENTIFIER_SIZE_IN_BYTES);
+	}
+	return true;
+}
+
+void RenderingDeviceDriverD3D12::command_bind_raytracing_pipeline(CommandBufferID p_cmd_buffer, RaytracingPipelineID p_pipeline) {
+	auto *cmd = reinterpret_cast<CommandBufferInfo *>(p_cmd_buffer.id);
+	const auto *pipeline = reinterpret_cast<const RaytracingPipelineInfo *>(p_pipeline.id);
+	ComPtr<ID3D12GraphicsCommandList4> list;
+	cmd->cmd_list->QueryInterface(list.GetAddressOf());
+	ERR_FAIL_NULL(list.Get());
+	list->SetPipelineState1(pipeline->state.Get());
+	list->SetComputeRootSignature(pipeline->shader->root_signature.Get());
+	cmd->compute_root_signature_crc = pipeline->shader->root_signature_crc;
+	cmd->compute_pso = nullptr; cmd->graphics_pso = nullptr;
+	cmd->nir_compute_runtime_data_root_param_idx = UINT32_MAX;
+}
+
+void RenderingDeviceDriverD3D12::command_bind_raytracing_uniform_set(CommandBufferID p_cmd_buffer, UniformSetID p_uniform_set, ShaderID p_shader, uint32_t p_set_index) {
+	command_bind_compute_uniform_sets(p_cmd_buffer, VectorView<UniformSetID>(&p_uniform_set, 1), p_shader, p_set_index, 1, 0);
+}
+
+void RenderingDeviceDriverD3D12::command_trace_rays(CommandBufferID p_cmd_buffer, const ShaderBindingTable &p_raygen_sbt, const ShaderBindingTable &p_miss_sbt, const ShaderBindingTable &p_hit_sbt, uint32_t p_width, uint32_t p_height, uint32_t p_depth) {
+	auto *cmd = reinterpret_cast<CommandBufferInfo *>(p_cmd_buffer.id);
+	ComPtr<ID3D12GraphicsCommandList4> list;
+	cmd->cmd_list->QueryInterface(list.GetAddressOf());
+	ERR_FAIL_NULL(list.Get());
+	if (!barrier_capabilities.enhanced_barriers_supported) {
+		for (const auto *table : { &p_raygen_sbt, &p_miss_sbt, &p_hit_sbt }) {
+			if (table->buffer) { _resource_transition_batch(cmd, reinterpret_cast<BufferInfo *>(table->buffer.id), 0, 1, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE); }
+		}
+		_resource_transitions_flush(cmd);
+	}
+	D3D12_DISPATCH_RAYS_DESC desc = {};
+	desc.RayGenerationShaderRecord = { buffer_get_device_address(p_raygen_sbt.buffer) + p_raygen_sbt.offset, p_raygen_sbt.size };
+	if (p_miss_sbt.buffer) { desc.MissShaderTable = { buffer_get_device_address(p_miss_sbt.buffer) + p_miss_sbt.offset, p_miss_sbt.size, p_miss_sbt.stride }; }
+	if (p_hit_sbt.buffer) { desc.HitGroupTable = { buffer_get_device_address(p_hit_sbt.buffer) + p_hit_sbt.offset, p_hit_sbt.size, p_hit_sbt.stride }; }
+	desc.Width = p_width; desc.Height = p_height; desc.Depth = p_depth;
+	list->DispatchRays(&desc);
+}
