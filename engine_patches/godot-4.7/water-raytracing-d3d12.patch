+bool RenderingShaderContainerD3D12::set_code_from_spirv_and_dxil(const String &p_shader_name, Span<RDC::ShaderStageSPIRVData> p_spirv, const HashMap<RDC::ShaderStage, Vector<uint8_t>> &p_dxil) {
+#if NIR_ENABLED
+	ReflectShader reflected;
+	ERR_FAIL_COND_V(reflect_spirv(p_shader_name, p_spirv, reflected) != OK, false);
+	ERR_FAIL_COND_V(reflection_data.pipeline_type != RDC::PIPELINE_TYPE_RAYTRACING, false);
+	// The native shader must use the same set/binding register mapping as NIR.
+	// Push/specialization constants need DXIL reflection/patching of their own.
+	ERR_FAIL_COND_V(reflection_data.push_constant_size || reflection_data.specialization_constants_count || reflection_data.has_dynamic_buffers, false);
+	reflection_data_d3d12.nir_runtime_data_root_param_idx = UINT32_MAX;
+	for (int i = 0; i < reflection_binding_set_uniforms_data.size(); i++) {
+		const ReflectionBindingData &binding = reflection_binding_set_uniforms_data[i];
+		ReflectionBindingDataD3D12 &native = reflection_binding_set_uniforms_data_d3d12.ptrw()[i];
+		native.dxil_stages = binding.stages;
+		native.has_sampler = binding.type == RDC::UNIFORM_TYPE_SAMPLER || binding.type == RDC::UNIFORM_TYPE_SAMPLER_WITH_TEXTURE;
+		switch (binding.type) {
+			case RDC::UNIFORM_TYPE_SAMPLER: native.resource_class = RES_CLASS_INVALID; break;
+			case RDC::UNIFORM_TYPE_UNIFORM_BUFFER: native.resource_class = RES_CLASS_CBV; break;
+			case RDC::UNIFORM_TYPE_IMAGE: native.resource_class = RES_CLASS_UAV; break;
+			case RDC::UNIFORM_TYPE_STORAGE_BUFFER: native.resource_class = binding.writable ? RES_CLASS_UAV : RES_CLASS_SRV; break;
+			case RDC::UNIFORM_TYPE_TEXTURE:
+			case RDC::UNIFORM_TYPE_SAMPLER_WITH_TEXTURE:
+			case RDC::UNIFORM_TYPE_ACCELERATION_STRUCTURE: native.resource_class = RES_CLASS_SRV; break;
+			default: ERR_FAIL_V_MSG(false, "Unsupported native DXR binding.");
+		}
+	}
+	shaders.resize(p_spirv.size());
+	for (uint32_t i = 0; i < p_spirv.size(); i++) {
+		auto stage = p_spirv[i].shader_stage;
+		ERR_FAIL_COND_V(!p_dxil.has(stage), false);
+		const Vector<uint8_t> &bytes = p_dxil[stage];
+		Shader &shader = shaders.ptrw()[i];
+		shader.shader_stage = stage;
+		shader.code_decompressed_size = bytes.size();
+		shader.code_compressed_bytes.resize(bytes.size());
+		uint32_t length = 0;
+		ERR_FAIL_COND_V(!compress_code(bytes.ptr(), bytes.size(), shader.code_compressed_bytes.ptrw(), &length, &shader.code_compression_flags), false);
+		shader.code_compressed_bytes.resize(length);
+	}
+	return _generate_root_signature(reflected.stages_bits);
+#else
+	return false;
+#endif
+}
