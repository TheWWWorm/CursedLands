diff --git a/drivers/d3d12/ei_device_diagnostics_d3d12.cpp b/drivers/d3d12/ei_device_diagnostics_d3d12.cpp
new file mode 100644
--- /dev/null
+++ b/drivers/d3d12/ei_device_diagnostics_d3d12.cpp
@@ -0,0 +1,170 @@
+// Opt-in Windows diagnostics for device removal. Normal rendering does not
+// enable DRED, the debug layer, GPU validation, or InfoQueue collection.
+#include "rendering_context_driver_d3d12.h"
+#include "rendering_device_driver_d3d12.h"
+
+using Microsoft::WRL::ComPtr;
+
+void STDMETHODCALLTYPE RenderingDeviceDriverD3D12::_diagnostic_message_func(D3D12_MESSAGE_CATEGORY p_category, D3D12_MESSAGE_SEVERITY p_severity, D3D12_MESSAGE_ID p_id, LPCSTR p_description, void *p_context) {
+	if (p_severity > D3D12_MESSAGE_SEVERITY_WARNING || !p_context) {
+		return;
+	}
+	// This can run on a D3D worker thread while the runtime holds internal locks.
+	// Defer Godot logging, script backtraces and extension error handlers until
+	// outside the callback, where re-entry into the renderer is permitted.
+	auto *driver = static_cast<RenderingDeviceDriverD3D12 *>(p_context);
+	MutexLock lock(driver->diagnostic_messages_mutex);
+	if (driver->diagnostic_messages.size() < 4096) {
+		driver->diagnostic_messages.push_back({ p_category, p_severity, p_id, String::utf8(p_description ? p_description : "") });
+	} else if (driver->diagnostic_messages_dropped != UINT32_MAX) {
+		driver->diagnostic_messages_dropped++;
+	}
+}
+
+void RenderingDeviceDriverD3D12::_initialize_diagnostic_messages() {
+	if (!context_driver->is_device_diagnostics_enabled() || !context_driver->use_validation_layers()) {
+		return;
+	}
+	// Keep this explicit: MinGW's __uuidof specialization is translation-unit local.
+	static const GUID info_queue_iid = { 0x0742a90b, 0xc387, 0x483f, { 0xb9, 0x46, 0x30, 0xa7, 0xe4, 0xe6, 0x14, 0x58 } };
+	HRESULT res = device->QueryInterface(info_queue_iid, reinterpret_cast<void **>(diagnostic_info_queue.GetAddressOf()));
+	if (FAILED(res)) {
+		WARN_PRINT(vformat("D3D12 diagnostics: InfoQueue unavailable (0x%08x).", uint32_t(res)));
+		return;
+	}
+	// Preserve descriptor/lifetime errors that normal engine filters suppress.
+	diagnostic_info_queue->ClearStorageFilter();
+	diagnostic_info_queue->ClearRetrievalFilter();
+	diagnostic_info_queue->SetMessageCountLimit(4096);
+	// Device creation can produce messages before callback registration.
+	_flush_diagnostic_messages();
+	static const GUID info_queue1_iid = { 0x2852dd88, 0xb484, 0x4c0c, { 0xb6, 0xb1, 0x67, 0x16, 0x85, 0x00, 0xe6, 0x00 } };
+	res = device->QueryInterface(info_queue1_iid, reinterpret_cast<void **>(diagnostic_callback_queue.GetAddressOf()));
+	if (SUCCEEDED(res)) {
+		res = diagnostic_callback_queue->RegisterMessageCallback(&_diagnostic_message_func, D3D12_MESSAGE_CALLBACK_IGNORE_FILTERS, this, &diagnostic_callback_cookie);
+		diagnostic_callback_registered = SUCCEEDED(res);
+	}
+	print_line(diagnostic_callback_registered ? "D3D12 diagnostics: InfoQueue callback captures warnings/errors for the Godot log." : "D3D12 diagnostics: InfoQueue warnings/errors collected at queue and fence boundaries.");
+	_flush_diagnostic_messages();
+}
+
+void RenderingDeviceDriverD3D12::_flush_diagnostic_messages() {
+	if (!diagnostic_info_queue) {
+		return;
+	}
+	LocalVector<DiagnosticMessage> messages;
+	uint32_t dropped = 0;
+	{
+		MutexLock lock(diagnostic_messages_mutex);
+		messages = std::move(diagnostic_messages);
+		dropped = diagnostic_messages_dropped;
+		diagnostic_messages_dropped = 0;
+	}
+	for (const DiagnosticMessage &message : messages) {
+		_debug_message_func(message.category, message.severity, message.id, message.description.utf8().get_data(), nullptr);
+	}
+	if (dropped) {
+		WARN_PRINT(vformat("D3D12 diagnostics: %d additional InfoQueue messages omitted because the callback queue was full.", dropped));
+	}
+	if (diagnostic_callback_registered) {
+		return;
+	}
+	MutexLock lock(diagnostics_mutex);
+	const UINT64 count = diagnostic_info_queue->GetNumStoredMessagesAllowedByRetrievalFilter();
+	for (UINT64 i = 0; i < count; i++) {
+		SIZE_T size = 0;
+		if (FAILED(diagnostic_info_queue->GetMessage(i, nullptr, &size)) || size == 0) {
+			continue;
+		}
+		LocalVector<uint8_t> bytes;
+		bytes.resize(size);
+		auto *message = reinterpret_cast<D3D12_MESSAGE *>(bytes.ptr());
+		if (SUCCEEDED(diagnostic_info_queue->GetMessage(i, message, &size)) && message->Severity <= D3D12_MESSAGE_SEVERITY_WARNING) {
+			_debug_message_func(message->Category, message->Severity, message->ID, message->pDescription, nullptr);
+		}
+	}
+	diagnostic_info_queue->ClearStoredMessages();
+}
+
+static String _dred_name(const char *p_name, const wchar_t *p_wide_name) {
+	return p_wide_name ? String(p_wide_name) : (p_name ? String::utf8(p_name) : String("<unnamed>"));
+}
+
+static String _dred_operation(D3D12_AUTO_BREADCRUMB_OP p_operation) {
+	switch (p_operation) {
+		case D3D12_AUTO_BREADCRUMB_OP_BUILDRAYTRACINGACCELERATIONSTRUCTURE: return "BuildRaytracingAccelerationStructure";
+		case D3D12_AUTO_BREADCRUMB_OP_DISPATCHRAYS: return "DispatchRays";
+		case D3D12_AUTO_BREADCRUMB_OP_DISPATCH: return "Dispatch";
+		case D3D12_AUTO_BREADCRUMB_OP_RESOURCEBARRIER: return "ResourceBarrier";
+		case D3D12_AUTO_BREADCRUMB_OP_BARRIER: return "Barrier";
+		case D3D12_AUTO_BREADCRUMB_OP_COPYBUFFERREGION: return "CopyBufferRegion";
+		case D3D12_AUTO_BREADCRUMB_OP_COPYTEXTUREREGION: return "CopyTextureRegion";
+		default: return "operation " + itos(uint32_t(p_operation));
+	}
+}
+
+void RenderingDeviceDriverD3D12::_report_device_failure(const char *p_operation, HRESULT p_result) {
+	const HRESULT reason = device->GetDeviceRemovedReason();
+	_flush_diagnostic_messages();
+	MutexLock lock(diagnostics_mutex);
+	if (FAILED(reason) && device_removal_reported) {
+		return;
+	}
+	ERR_PRINT(vformat("D3D12: %s failed (HRESULT 0x%08x; device removed reason 0x%08x).", p_operation, uint32_t(p_result), uint32_t(reason)));
+	if (SUCCEEDED(reason)) {
+		return;
+	}
+	device_removal_reported = true;
+	if (!context_driver->is_device_diagnostics_enabled()) {
+		return;
+	}
+	static const GUID dred1_iid = { 0x9727a022, 0xcf1d, 0x4dda, { 0x9e, 0xba, 0xef, 0xfa, 0x65, 0x3f, 0xc5, 0x06 } };
+	ComPtr<ID3D12DeviceRemovedExtendedData1> dred;
+	HRESULT res = device->QueryInterface(dred1_iid, reinterpret_cast<void **>(dred.GetAddressOf()));
+	if (FAILED(res)) {
+		WARN_PRINT(vformat("D3D12 diagnostics: DRED output unavailable (0x%08x).", uint32_t(res)));
+		return;
+	}
+	D3D12_DRED_AUTO_BREADCRUMBS_OUTPUT1 breadcrumbs = {};
+	res = dred->GetAutoBreadcrumbsOutput1(&breadcrumbs);
+	print_line(vformat("D3D12 DRED: breadcrumbs result 0x%08x.", uint32_t(res)));
+	if (SUCCEEDED(res)) {
