+// Reject stale/wrong-sized or incompatible guides instead of passing invalid
+// resources into a native SDK. No allocation or ownership transfer occurs here.
+bool RenderSceneBuffersRD::set_dlss_ray_reconstruction(RID p_diffuse, RID p_specular, RID p_normal_roughness, RID p_hit_distance, bool p_reset) {
+	clear_dlss_ray_reconstruction();
+	if (view_count != 1 || scaling_3d_mode != RSE::VIEWPORT_SCALING_3D_MODE_DLSS || msaa_3d != RSE::VIEWPORT_MSAA_DISABLED) { return false; }
+	RD *rd = RD::get_singleton();
+	for (RID texture : { p_diffuse, p_specular, p_normal_roughness, p_hit_distance }) {
+		if (!texture.is_valid() || !rd->texture_is_valid(texture)) { return false; }
+		RD::TextureFormat format = rd->texture_get_format(texture);
+		RD::DataFormat expected = texture == p_hit_distance ? RD::DATA_FORMAT_R16_SFLOAT : RD::DATA_FORMAT_R16G16B16A16_SFLOAT;
+		if (format.format != expected || format.width != (uint32_t)internal_size.x || format.height != (uint32_t)internal_size.y || format.array_layers != 1 || format.samples != RD::TEXTURE_SAMPLES_1) { return false; }
+	}
+	ray_reconstruction_inputs = { p_diffuse, p_specular, p_normal_roughness, p_hit_distance, true, p_reset };
+	return true;
+}
