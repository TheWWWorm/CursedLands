--- a/servers/rendering/rendering_server_default.h
+++ b/servers/rendering/rendering_server_default.h
@@ -211,7 +211,21 @@
 	}
 
 	//these go pass-through, as they can be called from any thread
-	FUNCRIDTEX1(texture_2d, const Ref<Image> &)
+	virtual RID texture_2d_create(const Ref<Image> &p_image) override {
+		RID texture = RSG::texture_storage->texture_allocate();
+		if (Thread::get_caller_id() == server_thread || RSG::rasterizer->can_create_resources_async()) {
+			RSG::texture_storage->texture_2d_initialize(texture, p_image);
+		} else {
+			// The producer may modify the Image again before this queued upload.
+			// Snapshot the Image object; pixel storage remains copy-on-write.
+			Ref<Image> snapshot = p_image;
+			if (snapshot.is_valid()) {
+				snapshot = p_image->duplicate();
+			}
+			command_queue.push(RSG::texture_storage, &RendererTextureStorage::texture_2d_initialize, texture, snapshot);
+		}
+		return texture;
+	}
 	FUNCRIDTEX2(texture_2d_layered, const Vector<Ref<Image>> &, RSE::TextureLayeredType)
 	FUNCRIDTEX6(texture_3d, Image::Format, int, int, int, bool, const Vector<Ref<Image>> &)
 	FUNCRIDTEX3(texture_external, int, int, uint64_t)
@@ -224,7 +238,21 @@
 	}
 
 	//these go through command queue if they are in another thread
-	FUNC3(texture_2d_update, RID, const Ref<Image> &, int)
+	virtual void texture_2d_update(RID p_texture, const Ref<Image> &p_image, int p_layer) override {
+		WRITE_ACTION
+		if (ASYNC_COND_PUSH) {
+			// Font atlases and other dynamic images are mutable on the caller.
+			// The rendering thread must see the pixels from this submission.
+			Ref<Image> snapshot = p_image;
+			if (snapshot.is_valid()) {
+				snapshot = p_image->duplicate();
+			}
+			command_queue.push(RSG::texture_storage, &RendererTextureStorage::texture_2d_update, p_texture, snapshot, p_layer);
+		} else {
+			command_queue.flush_if_pending();
+			RSG::texture_storage->texture_2d_update(p_texture, p_image, p_layer);
+		}
+	}
