+// Resolve the immutable rig during loading without advancing its timeline,
+// seeking, applying a pose or firing playback/mixer/track events. The ordinary
+// invalidation paths still apply after library, target or hierarchy changes.
+bool AnimationPlayer::prepare_track_caches() {
+	if (!is_inside_tree()) {
+		return false;
+	}
+	return cache_valid || _update_caches();
+}
