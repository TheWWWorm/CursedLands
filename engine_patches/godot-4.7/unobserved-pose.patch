+// Private visual-only experiment. The caller must materialize the pose with
+// advance(0) before observing transforms or morphs. All eventful, captured,
+// blended, nonlooping and root-motion animation takes the normal path.
+bool AnimationPlayer::advance_unobserved_pose(double p_time) {
+	_check_immediately_after_start();
+	bool eligible = p_time > 0.0 && Math::is_finite(p_time) && active && playing && cache_valid &&
+			playback.current.is_enabled && playback.blend.is_empty() && playback_queue.is_empty() &&
+			root_motion_track.is_empty() && capture_cache.remain <= 0.0 && get_script_instance() == nullptr;
+	if (eligible) {
+		const Ref<Animation> &animation = animation_set[playback.current.animation_name].animation;
+		eligible = animation->get_loop_mode() == Animation::LOOP_LINEAR &&
+				playback.current.get_end_time() > playback.current.get_start_time();
+		for (int i = 0; eligible && i < animation->get_track_count(); i++) {
+			switch (animation->track_get_type(i)) {
+				case Animation::TYPE_POSITION_3D:
+				case Animation::TYPE_ROTATION_3D:
+				case Animation::TYPE_SCALE_3D:
+					break;
+				case Animation::TYPE_VALUE: {
+					const NodePath path = animation->track_get_path(i);
+					eligible = animation->value_track_get_update_mode(i) == Animation::UPDATE_CONTINUOUS &&
+							path.get_subname_count() == 1 && path.get_subname(0) == SNAME("animation_key");
+				} break;
+				default:
+					eligible = false;
+					break;
+			}
+		}
+	}
+	if (!eligible) {
+		AnimationMixer::advance(p_time);
+		return false;
+	}
+	// Use the normal playback logic, including section boundaries, speed,
+	// wrapping, seek state and the started flag. Only key evaluation and
+	// application are deferred; this path cannot finish or emit track events.
+	const bool advanced = _blend_pre_process(p_time, track_count, track_map);
+	clear_animation_instances();
+	if (advanced) {
+		_blend_post_process();
+	}
+	return advanced;
+}
