+// Explicit opt-in: ordinary manual/physical and near-enabled blur retain their
+// existing pipeline. History belongs to the viewport, never to a global camera.
+void RendererCameraAttributes::camera_attributes_set_far_dof(RID p_camera_attributes, bool p_enabled, float p_margin, float p_seconds, bool p_reset) {
+	CameraAttributes *attributes = camera_attributes_owner.get_or_null(p_camera_attributes);
+	ERR_FAIL_NULL(attributes);
+	ERR_FAIL_COND(!Math::is_finite(p_margin) || !Math::is_finite(p_seconds));
+	if (attributes->far_dof_enabled != p_enabled || p_reset) {
+		attributes->far_dof_version++;
+	}
+	attributes->far_dof_enabled = p_enabled;
+	attributes->far_dof_margin = CLAMP(p_margin, 0.0f, 4.0f);
+	attributes->far_dof_seconds = CLAMP(p_seconds, 0.01f, 10.0f);
+}
+
+bool RendererCameraAttributes::camera_attributes_get_far_dof_enabled(RID p_camera_attributes) {
+	CameraAttributes *attributes = camera_attributes_owner.get_or_null(p_camera_attributes);
+	ERR_FAIL_NULL_V(attributes, false);
+	return attributes->far_dof_enabled;
+}
+
+float RendererCameraAttributes::camera_attributes_get_far_dof_margin(RID p_camera_attributes) {
+	CameraAttributes *attributes = camera_attributes_owner.get_or_null(p_camera_attributes);
+	ERR_FAIL_NULL_V(attributes, 1.0);
+	return attributes->far_dof_margin;
+}
+
+float RendererCameraAttributes::camera_attributes_get_far_dof_seconds(RID p_camera_attributes) {
+	CameraAttributes *attributes = camera_attributes_owner.get_or_null(p_camera_attributes);
+	ERR_FAIL_NULL_V(attributes, 0.3);
+	return attributes->far_dof_seconds;
+}
+
+uint64_t RendererCameraAttributes::camera_attributes_get_far_dof_version(RID p_camera_attributes) {
+	CameraAttributes *attributes = camera_attributes_owner.get_or_null(p_camera_attributes);
+	ERR_FAIL_NULL_V(attributes, 0);
+	return attributes->far_dof_version;
+}
