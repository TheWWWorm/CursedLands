+#pragma once
+
+#include "servers/rendering/renderer_rd/pipeline_cache_rd.h"
+#include "servers/rendering/renderer_rd/shaders/effects/far_dof.glsl.gen.h"
+#include "servers/rendering/renderer_rd/storage_rd/render_scene_buffers_rd.h"
+
+#define RB_FAR_DOF SNAME("far_dof")
+
+namespace RendererRD {
+
+// Opt-in R1 far-field lens: median depth focus, bounded downsampled gather,
+// foreground rejection and terrain coverage over the otherwise sharp sky.
+class FarDOF {
+	struct PushConstant {
+		uint32_t full_size[2];
+		uint32_t work_size[2];
+		float z_near;
+		float z_far;
+		float aperture;
+		float margin;
+		float focus_blend;
+		float divisor;
+		uint32_t orthogonal;
+		float fill_share;
+	};
+
+	enum Mode { FOCUS, PREFILTER, GATHER_LOW, GATHER_HIGH, FILL, COMPOSITE, MODE_MAX };
+	FarDofShaderRD shader;
+	RID shader_version;
+	PipelineCacheRD pipelines[MODE_MAX];
+
+	struct History {
+		RID attributes;
+		uint64_t version = 0;
+		uint64_t last_usec = 0;
+		uint32_t current = 0;
+		bool valid = false;
+		bool orthogonal = false;
+	};
+
+	class Buffers : public RenderBufferCustomDataRD {
+		GDCLASS(Buffers, RenderBufferCustomDataRD);
+
+	public:
+		Size2i size;
+		Vector<History> history;
+		virtual void configure(RenderSceneBuffersRD *p_buffers) override;
+		virtual void free_data() override;
+	};
+
+	Ref<Buffers> get_buffers(Ref<RenderSceneBuffersRD> p_buffers, Size2i p_size);
+	void draw(Mode p_mode, RID p_target, RID p_depth, RID p_source, RID p_focus, const PushConstant &p_params);
+
+public:
+	FarDOF();
+	~FarDOF();
+	void clear(Ref<RenderSceneBuffersRD> p_buffers);
+	void process(Ref<RenderSceneBuffersRD> p_buffers, uint32_t p_view, RID p_source, RID p_depth, Size2i p_size, RID p_attributes, float p_near, float p_far, bool p_orthogonal);
+};
+
+} // namespace RendererRD
