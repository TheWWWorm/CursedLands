+// SPDX-License-Identifier: MIT
+package org.godotengine.godot;
+
+import android.view.SurfaceView;
+import org.godotengine.godot.input.GodotInputHandler;
+import java.util.concurrent.LinkedBlockingQueue;
+import java.util.concurrent.TimeUnit;
+
+/** A surface-independent loop for a headless Godot service instance. */
+final class GodotHeadlessRenderView implements GodotRenderView {
+    private final SurfaceView view;
+    private final GodotInputHandler input;
+    private final LinkedBlockingQueue<Runnable> queue = new LinkedBlockingQueue<>();
+    private volatile boolean exiting;
+    private boolean running;
+    private Thread thread;
+
+    GodotHeadlessRenderView(Godot godot, GodotInputHandler input) {
+        this.view = new SurfaceView(godot.getContext());
+        this.input = input;
+    }
+    @Override public SurfaceView getView() { return view; }
+    @Override public GodotInputHandler getInputHandler() { return input; }
+    @Override public void startRenderer() {
+        if (thread != null) return;
+        thread = new Thread(() -> {
+            try {
+                while (!exiting) {
+                    Runnable event = running ? queue.poll() : queue.poll(100, TimeUnit.MILLISECONDS);
+                    while (event != null) {
+                        event.run();
+                        event = queue.poll();
+                    }
+                    if (running && !exiting) GodotLib.step();
+                }
+            } catch (InterruptedException ignored) {
+                Thread.currentThread().interrupt();
+            } finally {
+                GodotLib.ondestroy();
+            }
+        }, "GodotSimulation");
+        thread.start();
+    }
+    @Override public void queueOnRenderThread(Runnable event) { queue.offer(event); }
+    @Override public void onActivityResumed() {
+        queueOnRenderThread(() -> { running = true; GodotLib.onRendererResumed(); });
+    }
+    @Override public void onActivityPaused() {
+        queueOnRenderThread(() -> { GodotLib.onRendererPaused(); running = false; });
+    }
+    @Override public void onActivityStarted() {}
+    @Override public void onActivityStopped() {}
+    @Override public boolean blockingExitRenderer(long timeout) {
+        exiting = true;
+        queue.offer(() -> {});
+        if (thread == null || thread == Thread.currentThread()) return true;
+        try { thread.join(timeout); }
+        catch (InterruptedException e) { Thread.currentThread().interrupt(); }
+        return !thread.isAlive();
+    }
+    @Override public void configurePointerIcon(int type, String path, float x, float y) {}
+    @Override public void setPointerIcon(int type) {}
+    @Override public boolean canCapturePointer() { return false; }
+}
