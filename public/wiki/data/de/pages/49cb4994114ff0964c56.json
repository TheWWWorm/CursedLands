":"creature/tigerwhitef10","title":"Weißer Tiger (Veteran)","variant":""},{"detail":"","key":"creature/unicornwhitem15","title":"Weißes Einhorn","variant":""}],"title":"Kreaturen und Personen"},{"id":"quest","rows":[{"detail":"","key":"quest/qk14k","title":"Alter Bandit","variant":""},{"detail":"","key":"quest/q48k","title":"Buch mit den Abrechnungen","variant":""},{"detail":"","key":"quest/q46k","title":"Den Ehrwürdigen Ältesten freilassen","variant":""},{"detail":"","key":"quest/q46bk","title":"Den Ältesten aus Karansuls Klauen befreien","variant":""},{"detail":"","key":"quest/z13q3","title":"Der Königshirsch","variant":""},{"detail":"","key":"quest/q44k","title":"Felle zum Treffpunkt bringen","variant":""},{"detail":"","key":"quest/z13q1","title":"Karansuls Problem","variant":""},{"detail":"","key":"quest/q50bk","title":"Neuer Wohnort des Grünen Clans","variant":""},{"detail":"","key":"quest/qk12k","title":"Quelle","variant":""},{"detail":"","key":"quest/z13q2","title":"Schwarze Einhörner","variant":""},{"detail":"","key":"quest/qk11k","title":"Stillgelegte Mine","variant":""},{"detail":"","key":"quest/qk13k","title":"Unbewachte Mine","variant":""}],"title":"Aufträge"},{"id":"exit","rows":[{"detail":"","key":"map/gz11k","title":"Außenbezirke der Stadt","variant":""},{"detail":"","key":"map/bz10k","title":"Neues Lager des Grünen Clans","variant":""},{"detail":"","key":"map/gz12k","title":"Verlassene Minen","variant":""}],"title":"Verbundene Orte"}],"versions":[{"guide":"","html":"<article><h1>Karansuls Einflussbereich</h1><p>In dieser Gegend besitzt Karansul unzählige Werkstätten. Seine Handlanger kontrollieren bis auf die engen Täler zwischen den Vorsprüngen der Berge fast das ganze Gebiet. In diesen Tälern gab es vor einiger Zeit noch ein Labor canianischer Kriegsmagier. Aber seit einem ihrer misslungenen Experimente sind diese Täler extrem gefährlich geworden.<br /></p><h2>Der Pfeil und der Grüne Clan</h2><p>Der Pfeil im Körper des Ermittlers scheint die Waldleute zu belasten. Sver erklärt die Clanmarkierungen, während der Gouverneur den Diebstahl seiner Sammlung ähnlicher Pfeile entdeckt. Die gestohlene Sammlung und die Aussage der Waldleute bilden nun parallele Spuren. Um <a href=\"wiki://character/ycf\">Graues Blatt</a> zu sprechen, bringt Kiran die Heilige Blume des Grünen Clans zurück, nachdem er ihren Hüter beim Weißen Clan befreit hat. Danach bittet Graues Blatt um Hilfe für den entführten Ältesten Khabburu und gegen dessen Entführer. Schließlich erkennt der Clan den Mordpfeil als falsche Spur und beschuldigt nicht einmal seine Feinde. Beim Umzug erhält Kiran Zugang zum geheimen Weg und zur neuen Heimat des Clans. [1, 2, 3, 4, 5, 6]</p><h2>Karansuls Bücher und das Geständnis des Diebes</h2><p><a href=\"wiki://character/shopper\">Karansul</a> will nicht helfen, doch Sver kennt ein Druckmittel. Kiran liefert zunächst die Felle des Jägers an einen Käufer außerhalb von Karansuls Monopol. Dafür berichtet Sver von dessen verborgenem Handel und hinterzogenen Steuern und verweist auf die Bücher des Verwalters. Außerdem empfiehlt er <a href=\"wiki://character/mthief\">Gauner</a> als Lehrer. Mit den Büchern erpresst Kiran Auskunft über <a href=\"wiki://character/vor\">Flein der Kahle</a> und ein Treffen. Die Beweise aus der gestohlenen Sammlung bringen den Dieb zum Geständnis: Er tötete den Ermittler, legte den Waldleutepfeil als falsche Spur und arbeitete für einen verhüllten Auftraggeber, der die magischen Fallen des Gouverneurs umgehen konnte. [7, 8, 9, 10, 11, 12]</p><h2>Quellen</h2><p>Grundlage sind Originaldialoge, Aufgabenjournale und Weltbeschreibungen. Die Zahlen verweisen auf die unten aufgeführten Quellen.</p><table data-columns=\"2\"><tr><th>#</th><th>Quellen</th></tr><tr><td>1</td><td>Dialog · <a href=\"wiki://character/huber\">Valrasian</a>, <a href=\"wiki://character/hero\">Kiran</a>, <a href=\"wiki://character/kapitan\">Tilvar</a> (briefing g43)</td></tr><tr><td>2</td><td>Dialog · <a href=\"wiki://character/hero\">Kiran</a>, <a href=\"wiki://character/trapper\">Sver der Fallensteller</a> (briefing t43)</td></tr><tr><td>3</td><td>Dialog · <a href=\"wiki://character/ycf\">Graues Blatt</a>, <a href=\"wiki://character/hero\">Kiran</a> (briefing yc45)</td></tr><tr><td>4</td><td>Dialog · <a href=\"wiki://character/ycf\">Graues Blatt</a>, <a href=\"wiki://character/hero\">Kiran</a> (briefing yc46)</td></tr><tr><td>5</td><td>Dialog · <a href=\"wiki://character/hero\">Kiran</a>, <a href=\"wiki://character/ycf\">Graues Blatt</a> (briefing yc47)</td></tr><tr><td>6</td><td>Dialog · <a href=\"wiki://character/hero\">Kiran</a>, <a href=\"wiki://character/ycf\">Graues Blatt</a> (briefing yc47_1)</td></tr><tr><td>7</td><td>Dialog · <a href=\"wiki://character/trapper\">Sver der Fallensteller</a>, <a href=\"wiki://character/hero\">Kiran</a> (briefing t43_1)</td></tr><tr><td>8</td><td>Dialog · <a href=\"wiki://character/trapper\">Sver der Fallensteller</a>, <a href=\"wiki://character/hero\">Kiran</a> (briefing t44)</td></tr><tr><td>9</td><td>Dialog · <a href=\"wiki://character/hero\">Kiran</a>, <a href=\"wiki://character/mthief\">Gauner</a> (briefing mthief1)</td></tr><tr><td>10</td><td>Dialog · <a href=\"wiki://character/shopper\">Karansul</a>, <a href=\"wiki://character/hero\">Kiran</a> (briefing tr48)</td></tr><tr><td>11</td><td>Dialog · <a href=\"wiki://character/shopper\">Karansul</a>, <a href=\"wiki://character/vor\">Flein der Kahle</a>, <a href=\"wiki://character/hero\">Kiran</a> (briefing tr49)</td></tr><tr><td>12</td><td>Dialog · <a href=\"wiki://character/shopper\">Karansul</a>, <a href=\"wiki://character/vor\">Flein der Kahle</a>, <a href=\"wiki://character/hero\">Kiran</a> (briefing tr49_1)</td></tr></table><table data-columns=\"2\"><tr><th>Eigenschaft</th><th>Wert</th></tr><tr><td>Insel</td><td><a href=\"wiki://allod/ingos\">Ingos</a></td></tr></table><h2>Verbundene Orte</h2><table data-columns=\"1\"><tr><th>Karten</th></tr><tr><td><a href=\"wiki://map/bz10k\">Neues Lager des