{"key":"map/bz1r","relations":[{"id":"people","rows":[{"detail":"","key":"character/hero","title":"Kir","variant":""},{"detail":"","key":"character/first","title":"Recruiter","variant":""}],"title":"Inhabitants"},{"id":"person","rows":[{"detail":"","key":"character/firez","title":"Firez","variant":""},{"detail":"","key":"character/hwleader","title":"Hartweik","variant":""},{"detail":"","key":"character/hero","title":"Kir","variant":""},{"detail":"","key":"character/first","title":"Recruiter","variant":""}],"title":"Related characters"},{"id":"inhabitant","rows":[{"detail":"","key":"creature/zonezero%20skeleton","title":"Child's skeleton","variant":""},{"detail":"","key":"creature/deer","title":"Deer","variant":""},{"detail":"","key":"creature/zonezero%20human%20fighter1%20m","title":"Guard (variant 1)","variant":""},{"detail":"","key":"creature/zonezero%20human%20fighter2%20m","title":"Guard (variant 2)","variant":""},{"detail":"","key":"creature/hare","title":"Hare","variant":""},{"detail":"","key":"creature/zonezero%20rat","title":"Mouse","variant":""},{"detail":"","key":"creature/zonezero%20toad","title":"Poisonous toad (variant 1)","variant":""},{"detail":"","key":"creature/bz1r%20human%20fighter%20m","title":"Recruiter","variant":""},{"detail":"","key":"creature/zonezero%20succub","title":"Stone harpy","variant":""},{"detail":"","key":"creature/zonezero%20scrab","title":"Young armadillo (variant 1)","variant":""}],"title":"Creatures and people"}],"versions":[{"guide":"","html":"<article><h1>Recruiter's camp</h1><h2>Setting</h2><p>The recruiter’s camp offers Kir an apparent route to work beyond his homeland. Papers and a portal promise a new beginning; arrival on Suslanger instead delivers him into imperial captivity. [1, 2, 3]</p><h2>Escape from Jigran</h2><p><a href=\"wiki://character/hero\">Kir</a>, whose full name is Kir-A-Chit-La, is a young Joon enslaved under <a href=\"wiki://character/firez\">Firez</a> on <a href=\"wiki://allod/jigran\">Jigran</a>. He escapes the castle, leaving his family behind, and hopes to return with help. Outside the castle, a <a href=\"wiki://character/first\">recruiter</a> mistakes him for someone expected at the camp. Kir conceals his identity and accepts travel papers for work on Suslanger. The apparent opening to freedom instead delivers him to imperial authorities. <a href=\"wiki://character/hwleader\">Hartweik</a> dismisses his papers, treats him as a slave and considers reporting the red-skinned stranger for a reward. [2, 3, 4, 5]</p><h2>Sources</h2><p>Based on the original dialogue, quest journals, event scripts and world descriptions. Source numbers identify the evidence listed below.</p><table data-columns=\"2\"><tr><th>#</th><th>Sources</th></tr><tr><td>1</td><td>World description · Recruiter's camp (zone bz1r)</td></tr><tr><td>2</td><td>Dialogue · <a href=\"wiki://character/hero\">Kir</a>, <a href=\"wiki://character/first\">Recruiter</a> (briefing brief_0)</td></tr><tr><td>3</td><td>Dialogue · <a href=\"wiki://character/hero\">Kir</a>, <a href=\"wiki://character/hwleader\">Hartweik</a> (briefing brief_1)</td></tr><tr><td>4</td><td>Dialogue · <a href=\"wiki://character/rick\">Great Magician Tka-Rik</a>, <a href=\"wiki://character/hero\">Kir</a> (briefing brief_119)</td></tr><tr><td>5</td><td>World description · Western castle outskirts (zone gz1g)</td></tr></table><table data-columns=\"2\"><tr><th>Property</th><th>Value</th></tr><tr><td>Island</td><td><a href=\"wiki://allod/jigran\">Jigran</a></td></tr></table><h2>Inhabitants</h2><table data-columns=\"1\"><tr><th>Related page</th></tr><tr><td><a href=\"wiki://character/hero\">Kir</a></td></tr><tr><td><a href=\"wiki://character/first\">Recruiter</a></td></tr></table><h2>Related characters</h2><table data-columns=\"1\"><tr><th>Related page</th></tr><tr><td><a href=\"wiki://character/firez\">Firez</a></td></tr><tr><td><a href=\"wiki://character/hwleader\">Hartweik</a></td></tr><tr><td><a href=\"wiki://character/hero\">Kir</a></td></tr><tr><td><a href=\"wiki://character/first\">Recruiter</a></td></tr></table><h2>Creatures and people</h2><table data-columns=\"2\"><tr><th>Related page</th><th>Details</th></tr><tr><td><a href=\"wiki://creature/zonezero%20skeleton\">Child's skeleton</a></td><td /></tr><tr><td><a href=\"wiki://creature/deer\">Deer</a></td><td /></tr><tr><td><a href=\"wiki://creature/zonezero%20human%20fighter1%20m\">Guard (variant 1)</a></td><td /></tr><tr><td><a href=\"wiki://creature/zonezero%20human%20fighter2%20m\">Guard (variant 2)</a></td><td /></tr><tr><td><a href=\"wiki://creature/hare\">Hare</a></td><td /></tr><tr><td><a href=\"wiki://creature/zonezero%20rat\">Mouse</a></td><td /></tr><tr><td><a href=\"wiki://creature/zonezero%20toad\">Poisonous toad (variant 1)</a></td><td /></tr><tr><td><a href=\"wiki://creature/bz1r%20human%20fighter%20m\">Recruiter</a></td><td /></tr><tr><td><a href=\"wiki://creature/zonezero%20succub\">Stone harpy</a></td><td /></tr><tr><td><a href=\"wiki://creature/zonezero%20scrab\">Young armadillo (variant 1)</a></td><td /></tr></table></article>","id":"","image":"ef265439df23cdbad9c768f8","image_caption":"Original location scene","image_kind":"scene","pins":[],"representative_image":false,"title":"Recruiter's camp"}]}
