ata-columns=\"2\"><tr><th>Связанная страница</th><th>Подробности</th></tr><tr><td><a href=\"wiki://map/bz8k\">Город Ингос</a></td><td>Карансул</td></tr><tr><td><a href=\"wiki://map/bz7g\">Подземелье Великого Мага</a></td><td>Великий маг</td></tr><tr><td><a href=\"wiki://map/bz14h\">Последнее Укрытие</a></td><td>Кузнец</td></tr></table></article>","id":"","image":"670f33284262965929b0ce63","pins":[],"representative_image":false,"title":"Ясновидение"}]}
