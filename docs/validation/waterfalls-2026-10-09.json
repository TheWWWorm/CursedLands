  "implementation": {
    "detection": "Independent snapshot of authored water vertices, including type-4 XY jitter and mixed per-vertex owners. Only exposed non-emissive water; no navigation-water heights or smoothed current texture. Contradictory copies, swamp, lava, nonfinite levels, isolated spikes, shallow rapids, border clusters and overwide candidates are rejected.",
    "classification": {
      "edge_drop_m": 0.9,
      "minimum_drop_m": 2.5,
      "minimum_steepness": 1.4,
      "maximum_width_m": 30,
      "maximum_sites": 32,
      "snapshot_maximum_vertices": 4194304
    },
    "reference_adaptation": "Keeps coherent edge/ring/median-drop rules. The Godot foam shell reuses selected original triangles and the original WATER_SHADER vertex displacement with a 0.045m normal lift. It does not port the reference smoothed/ballistic sheet, which would diverge from EI vertex jitter/waves. Bounds and depth testing keep existing terrain and liquid authoritative.",
    "geometry_limits": {
      "global_shell_vertices": 24576,
      "per_site_shell_vertices": 2046,
      "global_fixed_billboards": 1536,
      "maximum_draws_per_site": 2,
      "visibility_range_end_m": 110
    },
    "clock_and_lifetime": "Existing terrain clock drives bounded 16s shader phases. Quiet frames update uniforms only. Level writes hide stale geometry and coalesce one deferred reclassification, then rebuild shell/emitter anchors from exact mean triangles. Disable frees nodes, fields and materials. No independent TIME/particle clock, actors, collision, save or network state.",
    "options": {
      "gfx_waterfalls": {
        "group": 23,
        "row": 6,
        "default": 0,
        "requires": "gfx_water"
      },
      "gfx_ambient_wildlife": {
        "group": 13,
        "row": 7,
        "default": 0
      },
      "gfx_ambient_particles": {
        "group": 13,
        "row": 8,
        "default": 0
      },
      "gfx_clouds": {
        "group": 15,
        "row": 7,
        "default": 0
      }
    },
    "metadata_scope": "Ambient wildlife/particles and cloud helpers are separate concurrent work. This receipt validates their default-off metadata, EN/RU/DE text, page placement, applied registration and preset exclusion only."
  },
