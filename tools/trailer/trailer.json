  "location_review": {
    "01-return": "Gipath Sands: original coastal Jun ruins and bridges; deliberate sea-facing view, no visible hero.",
    "02-gipath": "Middle Mountains: native green dragon valley; no introduced creature and no visible hero.",
    "03-ingos": "Lake and castle in the original Ingos map; explicitly retained scenic exception.",
    "04-suslanger": "Later Suslanger city map gz18h: irrigation canals and orchards. Not the prison camp or Rindale arrival hub.",
    "05-astral": "Late Jigran map gz35j: Sadrok island bridges, statue and Firez fortress skyline. Native expansion text identifies this as the Hadagan stronghold.",
    "06-hdlands": "Dead City ruined fountain and paving in gz9g. Actual HD Lands 1.5.0 package; credit Atom.",
    "08-tactical": "Original orc, white wolf and witch encounter in Sands, original MOB positions; Gipath shop-1 leather and stone equipment.",
    "09-first": "Native white tiger in Ingos gz11k, NID 3990; iron bow and Kania armour. Track the living opponent with normal direct-control input.",
    "10-third": "Native OgreHadaganF15, NID 150993, outside later Suslanger city gz18h. Zak is free after the prison/catacomb escape; Hadagan steel equipment is available through the Suslanger shop-4 catalogue. gz15h prison footage is rejected.",
    "11-coop": "Two actual network players at the Dead City fountain approach, with Gipath equipment.",
    "14-touch": "Sands bridge encounter area with native touch controls and Gipath equipment.",
    "15-gamepad": "Dead City fountain approach with native pie-section system wheel and Gipath equipment.",
    "16-play": "Late-map establishing view behind the platform/website end card."
  }
