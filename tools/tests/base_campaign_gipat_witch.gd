extends "base_campaign_gipat_support.gd"

func _ready() -> void:
	await run()

func run() -> void:
	boot(); s.state.god_modes[0] = 1
	# Earlier village reports offer the cave and goblin-totem objectives.
	await offer("bz1g","b.sheriff.v4","q.gz5g.q5g")
	await offer("bz1g","b.elder.s6_2","q.gz7g.q8g")
	await enter("gz5g"); start(["VCheck#0#64","VCheck#0#88","VCheck#0#104","VCheck#0#58"])
	use(4522,false)
	check(value("q.gz5g.q5g") == 1,"crypt chest refuses the missing corpse key")
	use(4583); check(not s.state.quest_items.has("cavegear00"),"ordinary bridge mechanism consumes the sheriff's gear")
	collect("KeyOrc"); check(s.state.quest_items.has("cryptkey00"),"ordinary orc corpse loot provides the crypt key")
	await roundtrip("base_gipat_crypt_key",["q.gz5g.q5g","q.gz5g.q5g.2"],["cryptkey00"])
	arm("q.gz5g.q5g"); use(4522); quest("q.gz5g.q5g","crypt rune")
	check(s.state.quest_items.has("cryptrune00") and not s.state.quest_items.has("cryptkey00"),"crypt chest exchanges key for rune")
	await enter("bz1g"); await complete("b.smith.m6")
	await enter("gz2g"); start(["VCheck#0#44","VCheck#0#98","VCheck#0#108","VCheck#0#109","VCheck#0#110"]); watch("VCheck#0#88",hero())
	use(1321,false); use(1322,false); use(1323,false)
	check(value("q.gz2g.q6g") == 1,"witch path remains pending without the actual hidden switch key")
	use(1281); check(s.state.quest_items.has("ambushkey00"),"ordinary key pickup enables the three trap switches")
	use(1323); use(1322)
	check(value("q.gz2g.q6g.3") == 2 and value("q.gz2g.q6g.4") == 2 and value("q.gz2g.q6g.5") < 2,"two trap switches leave the third trap objective pending")
	await roundtrip("base_gipat_two_witch_traps",["q.gz2g.q6g","q.gz2g.q6g.3","q.gz2g.q6g.4"],["ambushkey00","cryptrune00"])
	arm("q.gz2g.q6g"); use(1321); teleport(Vector2(54,146)); quest("q.gz2g.q6g","witch approach")
	if not await leave("bz2g"):
		await finish_gipat("BASE_CAMPAIGN_GIPAT_WITCH","Crypt and witch approach completed, ordinary witch-hut passage failed."); return
	vm().instances.clear(); await complete("b.bz2g.z1"); await complete("b.witch.z1_2")
	check(value("amerc_3") == 1,"actual Witch conversation unlocks the third companion")
	await enter("gz7g"); start(["VCheck#0#1","VCheck#0#116"])
	check(value("q.gz7g.q8g") == 1,"goblin totem quest waits for its physical interaction")
	arm("q.gz7g.q8g"); use(4961); quest("q.gz7g.q8g","goblin totem")
	check(s.state.quest_items.has("goblinfright00"),"totem interaction yields the authored quest object")
	await enter("bz1g"); start(["VCheck#0#82"])
	await complete("b.smith.m7_1"); await complete("b.elder.s7_1"); await complete("b.elder.s7_4"); await complete("b.sheriff.v5")
	check(value("q.gz7g.q9g") == 1 and value("q.gz7g.q10g") == 1 and value("q.gz6g.q7g") == 1,"earned village reports grant paper, Palantir and gear objectives")
	await enter("gz7g"); start(["VCheck#0#203","VCheck#0#206","VCheck#0#94","VCheck#0#83"]); ticks(30)
	check(s.world.objects.has(1000252) and s.world.objects.has(1000308),"original accepted quests add their paper chest and occupied altar")
	arm("q.gz7g.q9g"); use(1000252); quest("q.gz7g.q9g","goblin paper")
	check(value("q.gz7g.q10g") == 1,"paper chest cannot satisfy the separate Palantir objective")
	await roundtrip("base_gipat_paper",["q.gz7g.q9g","q.gz7g.q10g"],["orclicense00"])
	arm("q.gz7g.q10g"); use(1000308); quest("q.gz7g.q10g","altar Palantir")
	await enter("bz2g"); await complete("b.witch.z2")
	check(value("q.gz7g.q11g") == 1 and not s.state.quest_items.has("palantir"),"actual Palantir report exchanges it for the orc-annals quest")
	await enter("gz7g"); start(["VCheck#0#20","VCheck#0#21"])
	dead("LetoShaman"); check(value("q.gz7g.q11g") == 1,"orc shaman death still requires looting the annals")
	arm("q.gz7g.q11g"); collect("LetoShaman"); quest("q.gz7g.q11g","orc annals")
	await enter("bz2g"); await complete("b.witch.z11")
	check(value("DRun1") == 1,"actual annals report enables the daughter's departure")
	await enter("gz6g"); start(["VCheck#0#373","VCheck#0#346"]); ticks(30)
	rearm_mob("zone6van.mob",["VCheck#4#6"])
	check(s.world.objects.has(1000383),"original gear quest adds the wagon chest")
	arm("q.gz6g.q7g"); use(1000383); quest("q.gz6g.q7g","wagon gear")
	check(s.state.quest_items.has("newgear00"),"ordinary wagon chest yields the replacement gear")
	await roundtrip("base_gipat_witch_complete",["q.gz5g.q5g","q.gz2g.q6g","q.gz7g.q8g","q.gz7g.q9g","q.gz7g.q10g","q.gz7g.q11g","q.gz6g.q7g"],["newgear00"])
	await finish_gipat("BASE_CAMPAIGN_GIPAT_WITCH","Prepared earlier village v4/s6_2 offers; actual q5g keyed crypt, q6g hidden key/three trap switches/hut passage, Witch z1/z1_2, q8g totem and earned village reports, q9g paper, q10g Palantir/report, q11g looted annals/report and q7g wagon gear. Source additions, blocked keys, partial controls, saves and duplicate rewards. Walking/combat accelerated; the Smith-first report sequence is exercised; the equivalent Goblin-first dialogue order is not repeated.")
