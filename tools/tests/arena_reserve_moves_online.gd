extends "arena_equipment_online.gd"
func _ready() -> void:
	var host:=ArenaOnlineSession.new();host.player_name="Host";add_child(host)
	var guest:=ArenaOnlineSession.new();guest.player_name="Guest";add_child(guest)
	check(host.host(29831,false)==OK,"host listens")
	check(guest.join("127.0.0.1:29831")==OK,"guest connects")
	check(await wait_for(func():return guest.my_seat==1),"guest receives own seat")
	guest.request("ready")
	check(await wait_for(func():return host.members.values().all(func(m):return m.ready)),"ready delivered")
	check(host.start_game(7319).is_empty(),"start game")
	check(await wait_for(func():return guest.started and not guest.last_state.is_empty()),"initial state delivered")
	host.game.set_process(false)
	var company:=host.game.run.company(1);var own:=host.game.run
	var a:=company._recruit(0,0,1);var b:=company._recruit(1,0,1)
	a.deployed=false;b.deployed=false;company.reserve_slots()
	var aid:=int(a.uid);var bid:=int(b.uid)
	host.game.updated.emit()
	check(await wait_for(func():return guest.view.army.size()==2),"reserves delivered")
	var host_before:=own.army.duplicate(true)
	guest.view.bench(aid,6)
	check(await wait_for(func():return int(guest.view.unit(aid).get("bench_slot",-1))==6),"empty move synchronized over ENet")
	check(int(company.unit(aid).bench_slot)==6 and own.army==host_before,"host owns move; other company unchanged")
	guest.view.bench(aid,1)
	check(await wait_for(func():return int(guest.view.unit(bid).get("bench_slot",-1))==6),"swap synchronized over ENet")
	check(int(company.unit(aid).bench_slot)==1 and int(company.unit(bid).bench_slot)==6,"authority swaps exact units")
	guest.view.undo()
	check(await wait_for(func():return int(guest.view.unit(aid).get("bench_slot",-1))==6),"network undo restores order")
	var before:=company.snapshot()
	for args in [[aid,8],[aid,1.5],[999999,0]]:check(not host.game.command(1,"bench",args).is_empty(),"malformed request rejected")
	check(company.snapshot()==before,"invalid requests preserve state")
	guest.close();host.close();guest.queue_free();host.queue_free();await frames(3)
	print("ARENA_RESERVE_MOVES_ONLINE ",JSON.stringify({"checks":checks,"failures":failures}))
	get_tree().quit(0 if failures.is_empty() else 1)
