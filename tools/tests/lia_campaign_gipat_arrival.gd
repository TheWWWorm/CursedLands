extends "lia_campaign_support.gd"
## Prepared Suslanger departure offer; q1g is granted by its actual handoff.
## Gipat q1g..q6g are then earned with carried items and dialogue prerequisites.
func _ready() -> void: run.call_deferred()
func run() -> void:
	boot(); chapter("FSusel","Hero2","Hero2","merc2")
	s.state.set_var(0,"b.Sergant.brief_88a",1)
	await enter("bz7h"); await complete("b.Sergant.brief_88a")
	if not await wait_zone("gz7g"):
		await finish("LIA_CAMPAIGN_GIPAT_ARRIVAL","Failed actual island handoff."); return
	ticks(30)
	check(s.state.current_party == "Gipat" and value("q.gz7g.q1g.1") == 1,"actual Suslanger departure creates Gipat party and arrival quest")
	place_party(Vector2(129.5,270)); teleport(Vector2(210,310))
	check(value("q.gz7g.q1g") == 1,"arrival requires the whole party at the settlement approach")
	place_party(Vector2(210,310))
	check(value("q.gz7g.q1g") == 2 and value("b.bz8g.brief_101") == 1,"actual arrival completes q1g and offers settlement introduction")
	await enter("bz8g"); await complete("b.bz8g.brief_101")
	await complete("b.OrcPyr.brief_102"); await complete("b.OrcC.brief_103")
	start(["VCheck#0#1"])
	check(value("b.OrcC.brief_105") == 0,"orc continuation waits for recovered papers")
	await complete("b.merc2.brief_104")
	check(value("q.gz11g.q2g") == 1 and value("z.gz7g_gz11g") == 2,"Kel grants paper quest and opens Rift travel")
	await enter("gz11g"); start(["VCheck#0#1","VCheck#0#3"]); ticks(30)
	place_party(Vector2(232,128)); use(47543,false)
	check(value("q.gz11g.q2g") == 1 and not s.state.quest_items.has("paper"),"paper chest refuses the missing ogre key")
	kill([1015782]); loot(1015782)
	check(s.state.quest_items.has("ogrekey") and value("q.gz11g.q2g.2") == 2,"normal corpse loot supplies key and advances its authored objective")
	await roundtrip("campaign_gipat_ogre_key",["q.gz11g.q2g.2"],["ogrekey"])
	place_party(Vector2(330,94)); use(47543)
	check(value("q.gz11g.q2g") == 2 and s.state.quest_items.has("paper") and not s.state.quest_items.has("ogrekey"),"keyed chest completes paper quest and exchanges key for papers")
	stable("Gipat recovered papers")
	await enter("bz8g"); start(["VCheck#0#1"]); await complete("b.OrcC.brief_105")
	check(value("q.gz7g.q3g") == 1 and value("q.gz11g.q4g") == 1,"earned orc report grants mine and hiding-place quests")
	await enter("gz11g"); start(["VCheck#1#1"]); ticks(30)
	place_party(Vector2(50,272)); use(2121172)
	check(value("q.gz11g.q4g") == 2 and s.state.quest_items.has("sackbabur") and value("b.merc2.brief_106") == 1,"actual hiding place grants Babur's sack and courier continuation")
	await enter("bz8g"); await complete("b.merc2.brief_106")
	await enter("gz7g"); start(["VCheck#1#1","VCheck#1#4"]); ticks(30)
	gate("gz7d1",false,"mine entrance is closed before its actual approach")
	place_party(Vector2(194,233)); place_party(Vector2(345,280))
	check(value("q.gz7g.q3g.2") == 2,"mine route approach completes the outdoor objectives")
	if not await leave("gz7d1"):
		await finish("LIA_CAMPAIGN_GIPAT_ARRIVAL","Earned q1g/q2g/q4g; mine entry failed."); return
	ticks(30); place_party(Vector2(62,51)); use(3398779)
	check(value("q.gz7d1.q3ag") == 2 and s.state.quest_items.has("sackofmat"),"actual mine basket completes inner quest and grants material sack")
	await roundtrip("campaign_gipat_mine_basket",["q.gz7d1.q3ag"],["sackofmat","paper","sackbabur"])
	if not await leave("gz7g"):
		await finish("LIA_CAMPAIGN_GIPAT_ARRIVAL","Mine completed but actual return failed."); return
	start(["VCheck#1#4"])
	check(value("q.gz7g.q3g") == 2 and value("b.OrcPyr.brief_107") == 1,"actual mine return completes outer quest and offers report")
	# q5g came from the earned Kel106 conversation; retain its carried papers/sack.
	start(["VCheck#2#1"]); ticks(30)
	place_party(Vector2(50,160)); place_party(Vector2(31,24)); use(2215844)
	check(value("q.gz7g.q5g") == 2 and not s.state.quest_items.has("paper") and not s.state.quest_items.has("sackbabur"),"courier chest consumes both carried delivery items and completes q5g")
	await enter("bz8g"); start(["VCheck#0#3"])
	await complete("b.OrcPyr.brief_107"); await complete("b.OrcPyr.brief_108")
	check(value("q.gz11g.q6g") == 1,"both earned mine and courier quests unlock actual harpy rescue offer")
	await enter("gz11g"); start(["VCheck#2#1"]); ticks(30)
	check(s.save_game("campaign_gipat_rescue_alive") == OK,"save living rescue target before failure branch")
	kill([1006001])
	check(value("q.gz11g.q6g") == 3,"dead required rescue target fails the authored harpy quest")
	check(await s.load_game_shown("campaign_gipat_rescue_alive"),"restore living harpy rescue branch"); freeze()
	place_party(Vector2(450,50))
	var guard: GameUnit = s.world.units.get(1006002)
	if check(guard != null and not guard.dead,"original rescue defender exists alive"):
		guard.hp = guard.max_hp*0.6
	ticks(5)
	check(value("q.gz11g.q6g.2") == 2,"actual non-lethal defender threshold advances its objective")
	kill([1006005,1006006,1006007,1006008])
	check(value("q.gz11g.q6g.3") == 1,"last harpy prevents escape objective")
	kill([1006009])
	check(value("q.gz11g.q6g.4") == 1 and value("q.gz11g.q6g") == 1,"all required attackers defeated still waits for escape")
	await roundtrip("campaign_gipat_rescue_return",["q.gz11g.q6g.2","q.gz11g.q6g.3","q.gz11g.q6g.4"])
	place_party(Vector2(204,36))
	check(value("q.gz11g.q6g") == 2 and value("q.gz11g.q6g.5") == 2,"actual escape rectangle completes rescue with living target")
	ticks(10); stable("harpy rescue")
	await enter("bz8g"); await complete("b.OrcC.brief_109"); await complete("b.OrcPyr.brief_110")
	check(value("q.gz9g.q7g") == 1 and value("z.gz7g_gz9g") == 2,"earned rescue report grants next main quest and opens its map route")
	await finish("LIA_CAMPAIGN_GIPAT_ARRIVAL","Prepared Suslanger departure topic and live party. Actual island handoff grants q1g; carried q1g arrival→q2g corpse key/papers→q3g mine+q4g hiding place→q5g courier→q6g harpy rescue→actual q7g offer. Normal dialogue, loot, use and mine entry/return; missing key, whole-party, dead-rescue-target and last-enemy guards; saves and once-only checks. Combat/walking accelerated. This does not prove earning the prepared Suslanger departure offer.")
