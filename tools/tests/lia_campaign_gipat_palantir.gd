extends "lia_campaign_support.gd"
## Prepared earned q17g healer-arrival offer. Carry q18g..q24g through the
## healer, witch, Palantir and Babur chains without later offer injection.
func _ready() -> void: run.call_deferred()
func run() -> void:
	boot(); chapter("Gipat","Hero3","Hero","merc2g")
	s.state.set_var(0,"q.gz13g.q17g",2)
	s.state.set_var(0,"b.bz12g.brief_129",1)
	await enter("bz12g"); await complete("b.bz12g.brief_129")
	check(value("q.gz12g.q18g") == 1 and value("q.gz7g.q19g") == 1,"actual healer arrival grants both parallel quests")
	await enter("gz12g"); start(["VCheck#0#1"]); ticks(30)
	place_party(Vector2(43,61)); place_party(Vector2(8,83))
	check(value("q.gz12g.q18g") == 1,"leaving monster cave without gift cannot complete retrieval")
	kill([2002346]); loot(2002346)
	check(s.state.quest_items.has("ogrepresent"),"normal defeated shaman loot grants the authored gift")
	place_party(Vector2(43,61)); teleport(Vector2(8,83))
	check(value("q.gz12g.q18g") == 1,"retrieved gift still requires both heroes to reach escape")
	place_party(Vector2(8,83))
	check(value("q.gz12g.q18g") == 2 and value("b.Daughter.brief_131") == 1,"all-party escape with gift completes q18g")
	await enter("bz12g"); await complete("b.bz12g.brief_130"); await complete("b.Daughter.brief_131")
	check(not s.state.quest_items.has("ogrepresent"),"actual Daughter report consumes the carried gift")
	await enter("gz7g"); start(["VCheck#3#1"]); ticks(30)
	place_party(Vector2(380,194))
	check(value("q.gz7g.q19g") == 1,"Witch destination cannot skip earlier ordered approaches")
	place_party(Vector2(241,160)); place_party(Vector2(370,168)); place_party(Vector2(380,194))
	check(value("q.gz7g.q19g") == 2 and value("z.bz13g") == 2 and value("b.bz13g.brief_132") == 1,"actual ordered approach completes Witch search and opens her home")
	if not await leave("bz13g"):
		await finish("LIA_CAMPAIGN_GIPAT_PALANTIR","Earned q18g/q19g; actual Witch-home route failed."); return
	await complete("b.bz13g.brief_132"); await complete("b.Witch.brief_133")
	check(value("q.gz16g.q20g") == 1 and value("z.gz7g_gz16g") == 2,"actual Witch dialogue grants flower quest and opens swamp route")
	await enter("gz16g"); start(["VCheck#0#1"]); ticks(30)
	place_party(Vector2(34,294)); use(1011001)
	check(value("q.gz16g.q20g") == 2 and s.state.quest_items.has("swampflower"),"actual flower source completes gathering and grants flower")
	await roundtrip("campaign_gipat_flower",["q.gz16g.q20g"],["swampflower"])
	await enter("bz13g"); await complete("b.Witch.brief_134")
	if not await wait_zone("gz7g"):
		await finish("LIA_CAMPAIGN_GIPAT_PALANTIR","Witch's earned departure failed."); return
	# Re-arm this independently declared root monitor after the earlier
	# loaded-map fixture selected only the Witch-search threads.
	start(["VCheck#4#1"]); ticks(30)
	check(value("q.gz7g.q21g") == 1 and not s.state.quest_items.has("swampflower"),"actual flower hand-in consumes flower and starts Witch escort")
	check(value("z.bz13g") == 1 and value("z.gz7g_bz13g") == 1,"Witch departure closes her old home route")
	check(s.save_game("campaign_gipat_witch_alive") == OK,"save Witch before independent death branch")
	kill([1021001])
	check(value("q.gz7g.q21g") == 3,"Witch death correctly fails escort")
	check(await s.load_game_shown("campaign_gipat_witch_alive"),"restore living Witch branch"); freeze()
	var witch: GameUnit = s.world.units[1021001]
	teleport(Vector2(263,158),witch)
	for i in 2400:
		witch.tick(GameUnit.TICK); ticks(1)
		if value("q.gz7g.q21g.3") == 1: break
		if i%40 == 0: await frames(1)
	check(value("q.gz7g.q21g.2") == 2 and value("q.gz7g.q21g.3") == 1,"actual Witch casts and waiting script complete the ritual before combat")
	kill([2002294,2002293,2002285])
	check(value("q.gz7g.q21g.3") == 1,"last ritual defender prevents escort return")
	kill([2002287])
	check(value("q.gz7g.q21g.4") == 1,"all ritual defenders defeated enable return objective")
	await roundtrip("campaign_gipat_witch_return",["q.gz7g.q21g.2","q.gz7g.q21g.3","q.gz7g.q21g.4"])
	place_party(Vector2(6,250)); ticks(10)
	check(value("q.gz7g.q21g") == 2 and value("b.Witch.brief_136") == 1,"alternate actual return circle completes living Witch escort")
	await enter("bz12g"); start(["VCheck#0#1"])
	await complete("b.Witch.brief_135"); await complete("b.Witch.brief_136"); await complete("b.Daughter.brief_137")
	check(value("q.gz16g.q22g") == 1 and value("b.Smith.brief_139") == 1,"earned Witch and Daughter dialogue grants Palantir quest and Smith continuation")
	await enter("gz16g"); start(["VCheck#1#1"]); ticks(30)
	place_party(Vector2(189,206)); place_party(Vector2(258,40))
	check(value("q.gz16g.q22g.3") == 0,"Palantir route waits for the shaman's real quest gear")
	kill([3398803]); loot(3398803)
	check(s.state.quest_items.has("orcgear") and value("q.gz16g.q22g.2") == 2,"normal shaman loot supplies the gear objective")
	place_party(Vector2(258,40)); use(4948)
	check(value("q.gz16g.q22g") == 2 and s.state.quest_items.has("palantirbroken00"),"actual altar use grants broken Palantir and completes retrieval")
	await enter("bz11g"); await complete("b.merc2.brief_138"); await complete("b.Smith.brief_139")
	await enter("gz15g"); start(["VCheck#1#1"]); ticks(30)
	place_party(Vector2(141,87)); place_party(Vector2(75,131)); use(1023001)
	check(value("q.gz15g.q23g") == 2 and s.state.quest_items.has("zakknife") and value("b.Karh.brief_140") == 1,"actual quest chest grants Zak's knife and next Karh report")
	await enter("bz11g"); await complete("b.Karh.brief_140")
	await enter("bz8g"); await complete("b.OrcC.brief_141")
	await enter("gz16g"); start(["VCheck#2#1","VCheck#2#6"]); ticks(30)
	place_party(Vector2(438,157))
	check(s.save_game("campaign_gipat_babur_alive") == OK,"save Babur rescue before independent failure branch")
	kill([1024001])
	check(value("q.gz16g.q24g") == 3,"dead Babur correctly fails his rescue quest")
	check(await s.load_game_shown("campaign_gipat_babur_alive"),"restore living Babur rescue branch"); freeze()
	use(1375,false); use(2121345,false)
	check(value("q.gz16g.q24g.5") == 0,"missing keys keep both cage controls and escape locked")
	use(3398861)
	check(s.state.quest_items.has("ogrekey1") and value("q.gz16g.q24g.2") == 2,"actual first chest supplies Babur's first cage key")
	use(1375); use(2121345,false)
	check(value("q.gz16g.q24g.5") == 0,"one working cage control cannot release Babur")
	kill([3398858]); loot(3398858)
	check(s.state.quest_items.has("ogrekey2"),"normal defeated ogre loot supplies second cage key")
	use(2121345); ticks(20)
	check(value("q.gz16g.q24g.5") == 1 and value("q.gz16g.q24g") == 1,"both real controls release Babur but still require his escape")
	await roundtrip("campaign_gipat_babur_free",["q.gz16g.q24g.4","q.gz16g.q24g.5"],["zakknife","palantirbroken00"])
	place_party(Vector2(155,312))
	check(value("q.gz16g.q24g") == 1,"heroes alone at exit cannot complete Babur's own arrival condition")
	teleport(Vector2(155,312),s.world.units[1024001]); ticks(20)
	check(value("q.gz16g.q24g") == 2 and value("q.gz16g.q24g.6") == 2,"living Babur's actual arrival completes rescue")
	stable("Babur rescue")
	await enter("bz11g"); start(["VCheck#0#1"])
	await complete("b.Karh.brief_142"); await complete("b.Karh.brief_143")
	check(value("q.gz10g.q25g") == 1 and s.state.quest_items.has("ambushkey01") and value("b.Smith.brief_145b") == 1,
		"actual Babur reports grant knife quest/key and the earned Smith book branch")
	await finish("LIA_CAMPAIGN_GIPAT_PALANTIR","Prepared earned healer-arrival topic. Carried q18g gift→q19g Witch route→q20g flower→actual Witch departure and q21g casting/combat/return→q22g shaman gear and Palantir→q23g Zak knife→q24g two-key Babur rescue→actual q25g/key and Smith book offer. Real loot/use/dialogue/travel, timed NPC casts, missing-item/partial-gate/death/escort-arrival negatives, saves and once-only checks. Combat/walking accelerated; no later quest outcomes or offers assigned.")
