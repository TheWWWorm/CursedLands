extends "lia_campaign_late_support.gd"
## Prepared Ingos departure party at Jigran's arrival scene. The actual Baron
## conversation grants q1j; all q1j..q6j quest inputs are then earned and carried.
func _ready() -> void: run.call_deferred()
func stop_at(label: String) -> void:
	await finish("LIA_CAMPAIGN_LATE_ARRIVAL","Prepared arrival party; route stopped at "+label)
func run() -> void:
	boot(); s.state.god_modes[0] = 1
	s.state.create_party("Gipat")
	s.state.add_party_unit("Gipat","Hero","Hero3")
	s.state.add_party_unit("Gipat","merc2","merc2g")
	s.state.set_current_party("Gipat")
	await s.enter_zone("cz1j",1,false); freeze()
	if not await advance_until(func():return value("b.Baron.brief_300") == 1,"actual Jigran arrival scene offers the Baron"):
		await stop_at("arrival conversation"); return
	check(value("q.gz31j.q1j") == 0,"first Jigran quest waits for the arrival conversation")
	await complete("b.Baron.brief_300")
	if not await wait_zone("gz31j"): await stop_at("arrival transfer"); return
	ticks(30)
	check(value("q.gz31j.q1j") == 1 and value("q.gz31j.q1j.1") == 1,"Baron grants and starts the first Jigran quest")
	check(value("z.bz31j") == 1 and value("z.bz32j") == 1,"both settlements initially wait for their earned gates")
	var first: Array = range(1001010,1001018); first.append_array(range(1001020,1001027))
	kill(first)
	check(value("q.gz31j.q1j") == 1 and value("z.bz31j") == 1,"one surviving invader keeps first quest and settlement locked")
	kill([1001027])
	check(value("q.gz31j.q1j") == 2 and value("z.bz31j") == 2,"all invaders dead completes first quest and opens village")
	check(value("b.Baron.brief_301") == 1 and value("b.Stark.brief_303") == 1,"first victory offers both main continuations")
	poll_once("first Jigran victory")
	await roundtrip("lia_jigran_first_victory",["q.gz31j.q1j","z.bz31j"])
	await enter("bz31j"); start(["VCheck#0#8"])
	await complete("b.Baron.brief_301"); await complete("b.Stark.brief_303")
	check(value("b.Stark.brief_305") == 0,"Stark's next assignment waits for second quest victory")
	await complete("b.Baron.brief_304")
	check(value("q.gz31j.q2j") == 1,"Baron's follow-up grants second quest")
	await enter("gz31j"); start(["VCheck#1#1"]); ticks(30)
	check(s.world.units.has(1002010),"second quest adds its authored invasion population")
	party_at(Vector2(300.1,220))
	check(value("q.gz31j.q2j.1") == 1,"second quest destination rejects a point outside its original radius")
	party_at(Vector2(299.9,220))
	check(value("q.gz31j.q2j.1") == 2 and value("q.gz31j.q2j.2") == 1,"actual destination approach advances second quest")
	kill(range(1002010,1002017))
	check(value("q.gz31j.q2j") == 1,"last second-wave invader prevents completion")
	kill([1002017])
	check(value("q.gz31j.q2j") == 2 and value("b.Baron.brief_306") == 1,"second victory offers its actual report")
	await enter("bz31j"); start(["VCheck#0#8"])
	await complete("b.Baron.brief_306"); await complete("b.Stark.brief_305")
	check(value("q.gz33j.q3j") == 1 and value("z.gz31j_gz33j") == 2,"earned Stark dialogue grants third quest and opens east route")
	await enter("gz33j"); start(["VCheck#0#1"]); ticks(30)
	party_at(Vector2(354,156))
	check(value("q.gz33j.q3j.1") == 2 and value("q.gz33j.q3j.2") == 1,"third quest registers its authored destination")
	kill([1003000,1003001,1003002])
	check(value("q.gz33j.q3j") == 1 and value("z.bz32j") == 1,"last guard keeps Doctor's settlement closed")
	kill([1003003])
	check(value("q.gz33j.q3j") == 2 and value("z.bz32j") == 2 and value("b.Doctor.brief_309") == 1,"third victory opens Doctor's settlement and conversation")
	await roundtrip("lia_jigran_doctor_open",["q.gz33j.q3j","z.bz32j"])
	await enter("bz32j"); await complete("b.Doctor.brief_309")
	check(value("q.gz32j.q4j") == 1 and value("z.gz31j_gz32j") == 2,"Doctor grants captive rescue and opens its route")
	await enter("gz32j"); start(["VCheck#0#1"]); ticks(30)
	party_at(Vector2(80,173)); party_at(Vector2(56,104))
	check(value("q.gz32j.q4j.3") == 1 and value("q.gz32j.q4j.4") == 0,"approaching captive still waits for the actual cage use")
	use(1004002); ticks(100)
	check(value("q.gz32j.q4j.3") == 2 and value("q.gz32j.q4j.4") == 1,"cage destruction starts the living escort phase")
	check(s.save_game("lia_jigran_captive_alive") == OK,"save independent living-captive escape checkpoint")
	kill([1004001]); party_at(Vector2(14,245))
	# The shipped map declares VCheck#0#6 (failure), but never starts it.
	# Test the actual live escape watcher rather than injecting that thread.
	check(value("q.gz32j.q4j") == 1 and value("b.Nekro.brief_311") == 0,"dead captive prevents escape completion and its continuation")
	check(await s.load_game_shown("lia_jigran_captive_alive"),"restore living captive branch"); freeze()
	teleport(Vector2(14,245))
	check(value("q.gz32j.q4j") == 1,"one hero at escape point cannot complete an all-party escort")
	party_at(Vector2(14,245))
	check(value("q.gz32j.q4j") == 2 and value("b.Nekro.brief_311") == 1,"whole party escaping with captive alive completes rescue")
	ticks(20); poll_once("captive rescue")
	await enter("bz31j"); start(["VCheck#0#4"])
	await complete("b.Baron.brief_312"); await complete("b.Nekro.brief_311"); await complete("b.Nekro.brief_311a")
	check(value("q.gz32j.q5j") == 1,"rescued Necromancer's actual conversations grant the bottle quest")
	await enter("gz32j"); start(["VCheck#1#1"]); ticks(30)
	party_at(Vector2(160,116)); party_at(Vector2(254,151))
	check(value("q.gz32j.q5j.3") == 1 and not s.state.quest_items.has("percovka"),"bottle quest waits for its actual container")
	use(1005002)
	check(s.state.quest_items.has("percovka") and value("q.gz32j.q5j.4") == 1,"container grants the bottle and spawns its defender")
	check(value("q.gz32j.q5j") == 1 and not s.world.units[1005001].dead,"living bottle defender prevents quest completion")
	kill([1005001])
	check(value("q.gz32j.q5j") == 2 and value("b.Nekro.brief_313") == 1,"defender death completes bottle quest and offers the next quest")
	await roundtrip("lia_jigran_bottle",["q.gz32j.q5j"],["percovka"])
	await enter("bz31j"); await complete("b.BSon.brief_314"); await complete("b.Nekro.brief_313")
	check(value("q.gz31j.q6j") == 1,"actual bottle report grants the ritual quest")
	await enter("gz31j"); start(["VCheck#2#1"]); ticks(30)
	party_at(Vector2(132,57)); use(1006001)
	check(value("q.gz31j.q6j") == 2 and not s.state.quest_items.has("percovka"),"ritual use completes sixth quest and consumes its carried bottle")
	check(value("b.Baron.brief_316") == 1 and value("b.Nekro.brief_315") == 1,"ritual completion offers both actual reports")
	poll_once("bottle ritual")
	await roundtrip("lia_jigran_ritual",["q.gz31j.q6j","z.gz31j"])
	await enter("bz31j"); start(["VCheck#0#9"])
	await complete("b.Baron.brief_316")
	check(value("b.Stark.brief_319") == 1,"actual sixth-quest report offers the material quest")
	check(value("b.merc2.brief_317") == 1,"earned BSon report and ritual completion unlock Kel's duel conversation")
	await complete("b.merc2.brief_317")
	check(value("b.BSon.brief_318") == 1,"Kel's actual conversation unlocks the duel already covered by handoff suite")
	await finish("LIA_CAMPAIGN_LATE_ARRIVAL","Prepared Gipat party at the Jigran arrival scene. Actual Baron300 grants q1j; carried q1j→q2j→q3j→q4j→q5j→q6j quest objectives, dialogues, bottle and map gates, then earned q7j/q8j topic offers. Dead-captive completion guard and last-enemy negative gates; whole-party escape; save/reload and once-only rewards. Movement/combat use cheats; settlement/map travel is accelerated. q7j duel itself is covered separately in lia_kel_handoffs. Not native execution or an ordinary uninterrupted playthrough.")
