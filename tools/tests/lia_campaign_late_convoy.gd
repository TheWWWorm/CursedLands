extends "lia_campaign_late_support.gd"
## Prepared q12j victory report offers. Earn q13j..q17j and carry their
## maps, amulet, dialogue unlocks and gate changes into the Kel story seam.
func _ready() -> void: run.call_deferred()
func run() -> void:
	boot(); s.state.god_modes[0] = 1
	s.state.create_party("Jigran2")
	s.state.add_party_unit("Jigran2","Hero","Hero3")
	s.state.add_party_unit("Jigran2","merc2","merc2g")
	s.state.set_current_party("Jigran2")
	s.state.set_var(0,"q.gz33j.q12j",2)
	for key: String in ["b.Baron.brief_331","b.Doctor.brief_330","start_zone31","z.gz34j_gz35j"]: s.state.set_var(0,key,1)
	await enter("bz31j"); await complete("b.Baron.brief_331")
	await enter("bz32j"); await complete("b.Doctor.brief_330"); await complete("b.Doctor.brief_332")
	check(value("q.gz34j.q13j") == 1 and value("q.gz34j.q14j") == 1 and value("z.gz33j_gz34j") == 2,
		"actual q12j reports grant both western quests and open the western route")
	await enter("gz34j"); start(["VCheck#0#1","VCheck#1#1"]); ticks(30)
	party_at(Vector2(86.1,18))
	check(value("q.gz34j.q14j") == 1,"crypt survey destination rejects position outside original radius")
	party_at(Vector2(85.9,18))
	check(value("q.gz34j.q14j") == 2 and value("b.Doctor.brief_335") == 1,"entering original survey radius completes q14j and offers report")
	check(value("q.gz34j.q13j") == 1,"survey does not complete the independent map quest")
	party_at(Vector2(196,115))
	check(value("q.gz34j.q13j.2") == 1 and not s.state.quest_items.has("jmap"),"map destination still waits for actual container")
	use(1013001)
	check(value("q.gz34j.q13j") == 2 and s.state.quest_items.has("jmap"),"actual container completes map quest and grants JMap")
	poll_once("map container")
	await roundtrip("lia_jigran_western_surveys",["q.gz34j.q13j","q.gz34j.q14j"],["jmap"])
	await enter("bz32j"); await complete("b.Doctor.brief_333"); await complete("b.Doctor.brief_335")
	check(value("b.BSon.brief_336") == 1,"actual survey report unlocks BSon's amulet quest")
	await enter("bz31j"); await complete("b.BSon.brief_336"); await complete("b.Baron.brief_334")
	check(value("q.gz31j.q16j") == 1 and value("q.gz34j.q15j") == 1 and not s.state.quest_items.has("jmap"),
		"actual reports grant amulet and battle quests and consume the carried map")
	await enter("gz31j"); start(["VCheck#4#1"]); ticks(30)
	party_at(Vector2(32,277))
	check(value("q.gz31j.q16j.2") == 1 and not s.state.quest_items.has("jamul"),"amulet location still waits for its chest")
	use(1016001)
	check(value("q.gz31j.q16j") == 2 and s.state.quest_items.has("jamul") and value("b.BSon.brief_337") == 1,
		"actual chest grants amulet, completes quest and offers its report")
	await roundtrip("lia_jigran_amulet",["q.gz31j.q16j"],["jamul"])
	await enter("bz31j"); start(["VCheck#0#2"])
	await complete("b.BSon.brief_337")
	check(value("b.Junofil.brief_341") == 0,"amulet report alone cannot open post-rescue crypt quest")
	await enter("gz34j"); start(["VCheck#2#1"]); ticks(30)
	check(s.world.units.has(1015000) and s.world.units.has(1015010),"western battle adds both authored commanders")
	party_at(Vector2(172,165))
	check(value("q.gz34j.q15j.2") == 1 and value("q.gz34j.q15j.3") == 0,"battle approach waits for its first commander")
	kill([1015000])
	check(value("q.gz34j.q15j.2") == 2 and value("q.gz34j.q15j.3") == 1 and value("q.gz34j.q15j") == 1,
		"first commander death advances only its battle objective")
	await roundtrip("lia_jigran_last_commander",["q.gz34j.q15j.2","q.gz34j.q15j.3"])
	kill([1015010])
	check(value("q.gz34j.q15j") == 2 and value("b.merc2.brief_339") == 1,"second commander death completes battle and offers Kel's continuation")
	poll_once("western battle")
	await enter("bz31j"); await complete("b.Baron.brief_338"); await complete("b.merc2.brief_339")
	check(value("q.gz35j.q17j") == 1 and value("z.gz34j_gz35j") == 2,"actual Kel conversation grants convoy quest and opens its route")
	await enter("gz34j")
	if not await normal_exit(2,"gz35j"):
		await finish("LIA_CAMPAIGN_LATE_CONVOY","Prepared q12j reports; earned q13j..q16j, but actual convoy route exit failed."); return
	ticks(30)
	check(value("q.gz35j.q17j.1") == 1 and value("q.gz35j.q17j.4") == 1,"normal entry starts convoy interception and captive survival objectives")
	check(s.save_game("lia_jigran_convoy_alive") == OK,"save actual live-convoy checkpoint")
	teleport(Vector2(136,210),s.world.units[1017000])
	check(value("q.gz35j.q17j") == 3,"convoy reaching its destination invokes the authored failure")
	check(await s.load_game_shown("lia_jigran_convoy_alive"),"restore convoy before escape failure"); freeze()
	for captive: int in [1017001,1017002]:
		kill([captive])
		check(value("q.gz35j.q17j") == 3 and value("q.gz35j.q17j.4") == 3,"required captive death invokes authored failure: "+str(captive))
		check(await s.load_game_shown("lia_jigran_convoy_alive"),"restore independent live-captive branch"); freeze()
	var leader: GameUnit = s.world.units[1017000]
	party_at(leader.pos+Vector2(15.1,0))
	check(value("q.gz35j.q17j.1") == 1,"convoy interception rejects position outside radius")
	party_at(leader.pos+Vector2(14.9,0))
	check(value("q.gz35j.q17j.1") == 2 and value("q.gz35j.q17j.2") == 1,"actual approach starts convoy combat")
	kill([1017000,1017005,1017006,1017007])
	check(value("q.gz35j.q17j.2") == 1,"last convoy guard prevents escort release")
	kill([1017008])
	check(value("q.gz35j.q17j.2") == 2 and value("q.gz35j.q17j.3") == 1,"all five guards dead release the living captives")
	await roundtrip("lia_jigran_convoy_released",["q.gz35j.q17j.2","q.gz35j.q17j.3","q.gz35j.q17j.4"])
	teleport(Vector2(247,171))
	check(value("q.gz35j.q17j") == 1,"one hero at return point cannot complete the all-party escort")
	party_at(Vector2(247,171))
	check(value("q.gz35j.q17j") == 2 and value("q.gz35j.q17j.4") == 2 and value("b.Deva.brief_340") == 1,
		"whole party returning with required captives alive completes convoy and offers Deva")
	ticks(20); poll_once("convoy rescue")
	await roundtrip("lia_jigran_convoy_complete",["q.gz35j.q17j","b.Deva.brief_340"])
	await enter("bz31j"); start(["VCheck#0#5","VCheck#0#2"])
	check(value("b.Junofil.brief_341") == 0,"completed convoy and amulet report still wait for Kel rescue before crypt quest")
	await complete("b.Deva.brief_340"); await complete("b.merc2.brief_342")
	check(value("q.gz35j.q19j") == 1,"actual Deva/Kel conversations grant belongings quest at the existing death/rescue seam")
	await finish("LIA_CAMPAIGN_LATE_CONVOY","Prepared q12j victory report offers and Jigran2 party. Earned q13j map and q14j survey→actual reports→q16j amulet and q15j commanders→Kel339→actual western exit to q17j convoy→Deva340/Kel342 grant q19j. Carried items/dialogue state; route gates, commander and captive-death/escape negatives, all-party return, saves and once-only completion. q19j death and revival follow in existing departures/rescue suites. Combat and walking use cheats; other travel accelerated. Not native execution or an uninterrupted prior-campaign proof.")
