extends "base_campaign_gipat_support.gd"

func _ready() -> void:
	await run()

func run() -> void:
	boot(); s.state.god_modes[0] = 1
	var peaceful := "--drive-cyclops" in OS.get_cmdline_user_args()
	# Earlier ambush/gear reports offer both Witch routes and the shell job.
	s.state.add_item("NewGear00")
	await offer("bz2g","b.witch.z13_1","q.gz6g.q14ag")
	check(value("q.gz9g.q17g") == 1 and not s.state.quest_items.has("newgear00"),"actual Witch briefing consumes the earlier gear and starts crystal plus amulet quests")
	await offer("bz1g","b.smith.m13_2","q.gz4g.q15ag")
	await enter("gz6g"); start(["VCheck#0#376","VCheck#0#309","VCheck#0#390"]); ticks(30)
	rearm_mob("zone6dkin.mob",["VCheck#5#4","VCheck#5#7"])
	var dragon: GameUnit = vm().globals.get("YDragon")
	teleport(dragon.pos); ticks(12)
	check(value("GFol") == 0,"young dragon refuses to follow without the actual beastmaster amulet")
	dead("Beastmaster"); check(value("q.gz6g.q14ag") == 1,"beastmaster death still requires looting his amulet")
	arm("q.gz6g.q14ag"); collect("Beastmaster"); quest("q.gz6g.q14ag","dragonkin amulet")
	await enter("bz2g"); await complete("b.witch.z14_1")
	await enter("gz4g"); start(["VCheck#0#10","VCheck#0#108"])
	arm("q.gz4g.q15ag"); use(533094); quest("q.gz4g.q15ag","road shell")
	check(s.state.quest_items.has("dragonshell00") and value("q.gz6g.q15bg") == 1,"shell retrieval earns the actual installation objective")
	await enter("gz6g"); start(["VCheck#0#359","VCheck#0#29"])
	arm("q.gz6g.q15bg"); use(1432); quest("q.gz6g.q15bg","shell installation")
	check(not s.state.quest_items.has("dragonshell00") and value("DrPeace6") == 1,"actual shell installation consumes the item and marks the dragonkin peace")
	await enter("bz1g"); await complete("b.smith.m15")
	await enter("gz4g"); start(["VCheck#0#78","VCheck#0#147","VCheck#0#15","VCheck#0#98"])
	check(value("q.gz4g.q16g") == 1,"living cyclops and pigs leave the mine blocked")
	arm("q.gz4g.q16g")
	if peaceful:
		var pigs := group_ids("Pigs"); kill(pigs.slice(0,pigs.size()-1))
		check(value("q.gz4g.q16g.3") < 2,"one surviving pig blocks the distraction alarm")
		kill([pigs[-1]])
		check(value("q.gz4g.q16g.3") == 2 and value("q.gz4g.q16g") == 1,"all pigs trigger the original distraction but the mine still waits for departure")
		teleport(Vector2(104,4),vm().globals.Cyclope)
		check(value("q.gz4g.q16g.4") == 2,"the living cyclops reaches the authored departure area")
	else:
		dead("Cyclope"); check(value("q.gz4g.q16g.6") == 2,"direct combat records the authored cyclops-kill alternative")
	quest("q.gz4g.q16g","mine passage")
	await enter("bz1g"); await complete("b.smith.m16")
	await enter("gz9g"); start(["VCheck#0#160","VCheck#0#162","VCheck#0#154"]); watch("VCheck#0#108",hero())
	if peaceful:
		use(2055); teleport(Vector2(185,235))
		check(value("q.gz9g.q17g") == 1 and s.state.quest_items.has("leftcrystal"),"wrong crystal and exit do not satisfy the true crystal objective")
		await enter("bz2g"); await complete("b.witch.z17_1")
		check(value("q.gz9g.q17g") == 1,"Witch rejects the wrong crystal without completing retrieval")
		await enter("gz9g"); start(["VCheck#0#160","VCheck#0#154"]); watch("VCheck#0#108",hero())
	use(2054); check(value("q.gz9g.q17g") == 1,"true crystal pickup still requires leaving its valley")
	await roundtrip("base_gipat_true_crystal",["q.gz9g.q17g","q.gz9g.q17g.3"],["rightcrystal","dragonamulet"])
	arm("q.gz9g.q17g"); teleport(Vector2(185,235)); quest("q.gz9g.q17g","true crystal escape")
	await enter("bz2g"); await complete("b.witch.z17")
	check(value("z.gz6g.frozen") == 1,"actual crystal report enables the frozen-lake approach")
	await enter("gz6g"); start(["VCheck#0#390","VCheck#0#334","VCheck#0#337","VCheck#0#340","VCheck#0#261"])
	dragon = vm().globals.get("YDragon"); teleport(dragon.pos); ticks(12)
	check(value("GFol") == 1 and value("q.gz6g.q18g.5") == 2,"earned amulet enables the actual young-dragon follow chain")
	var succubi := group_ids("Succubbus"); kill(succubi.slice(0,succubi.size()-1))
	check(value("q.gz6g.q18g.7") < 2,"one living observatory defender blocks its combat point")
	kill([succubi[-1]])
	use(1170)
	check(int(s.world.levers[1386].state) == 1 and int(s.world.levers[1388].state) == 1,"ordinary skill-qualified mechanism opens both observatory doors")
	arm("q.gz6g.q18g"); use(1390); quest("q.gz6g.q18g","observatory book")
	check(s.state.quest_items.has("dcbook") and value("DCWord") == 1,"real observatory chest earns the dead-city book and password")
	await enter("bz2g"); await complete("b.witch.z15")
	await enter("gz9g"); start(["VCheck#0#50"])
	watch("VCheck#0#55",hero()); watch("VCheck#0#125",hero()); watch("VCheck#0#126",hero()); watch("VCheck#0#127",hero())
	var guard: GameUnit = vm().globals.get("EarthEBlock"); teleport(guard.pos)
	check(value("q.gz9g.q20g.1") == 2,"earned city password triggers the authored elemental passage")
	arm("q.gz9g.q20g"); teleport(Vector2(260,132)); teleport(Vector2(382.5,187.3)); quest("q.gz9g.q20g","dead-city approach")
	check(value("b.bz3g.Dr20") == 1,"actual dead-city arrival offers the great dragon's mission")
	if not await leave("bz3g"):
		await finish_gipat("BASE_CAMPAIGN_GIPAT_MOUNTAINS","All mountain objectives completed, original great-dragon passage failed."); return
	vm().instances.clear(); await complete("b.bz3g.Dr20")
	check(value("q.gz5g.q22g") == 1 and s.state.quest_items.has("dragonpoison"),"ordinary dragon conversation starts the cave queen quest and grants its sole poison")
	await roundtrip("base_gipat_mountains_complete",["q.gz6g.q14ag","q.gz4g.q15ag","q.gz6g.q15bg","q.gz4g.q16g","q.gz9g.q17g","q.gz6g.q18g","q.gz9g.q20g","q.gz5g.q22g"],["dragonpoison"])
	await finish_gipat("BASE_CAMPAIGN_GIPAT_MOUNTAINS","Prepared earlier Witch z13_1 and Smith m13_2 offers plus earlier wagon gear; actual q14ag amulet, q15ag shell→q15bg installation, q16g cyclops kill or pig-distraction/departure, q17g wrong-crystal rejection variant then real crystal/escape/report, q18g amulet-driven dragon follow/defenders/skill switch/book/report, q20g password and city approach, ordinary great-dragon passage and Dr20 cave mission. All outcomes earned through original conditions. Walking, including distracted cyclops departure, and combat accelerated. Saves/partial groups/no-amulet check and reward stability covered.")
