extends "base_campaign_suslanger_support.gd"
## Prepared q63h-complete/Gl63-offered checkpoint, independently exercised
## by the prison suite. Main and optional desert/town quests remain unearned.
func _ready() -> void: run.call_deferred()

func run() -> void:
	boot(); s.state.god_modes[0] = 1; s.mod_config.rules.auto_exit = 0
	s.state.set_var(0,"q.gz16h.q63h",2)
	s.state.set_var(0,"b.bz14h.Gl63",1)
	await enter("bz14h"); await complete("b.bz14h.Gl63")
	check(value("q.gz17h.qk32h") == 1 and value("b.Glav.Gl64") == 0,"arrival offers the seal quest but its return waits for retrieval")
	if not await leave("gz17h_bz14h","gz17h"): await finish("BASE_CAMPAIGN_SUSLANGER_TOWN","Stopped at desert departure"); return
	settle_loaded(["VCheck#0#71","VCheck#0#77","VTriger#0#82"])
	teleport(Vector2(65,330)); check(value("q.gz17h.qk32h.1") == 2,"actual cyclops area advances imperial seal search")
	kill([47384,47387,47388]); check(value("q.gz17h.qk32h") == 1,"defeating all cyclops does not replace chest interaction")
	use(47383)
	check(value("q.gz17h.qk32h") == 2 and s.state.quest_items.has("goldnugget01") and value("b.Glav.Gl64") == 1,"ordinary chest use earns imperial seal and actual report offer")
	await roundtrip("base_desert_seal",["q.gz17h.qk32h","b.Glav.Gl64"],["goldnugget01"])
	if not await leave("bz14h"): await finish("BASE_CAMPAIGN_SUSLANGER_TOWN","Stopped returning imperial seal"); return
	await complete("b.Glav.Gl64")
	check(not s.state.quest_items.has("goldnugget01") and value("b.Kuzn.Kuz64_2") == 1 and value("b.merc10.Vo64") == 1 and value("b.Nekro.Ne64_2") == 1,"seal hand-in consumes its item and opens the three actual quest branches")
	await complete("b.Kuzn.Kuz64_2"); await complete("b.Nekro.Ne64_2"); await complete("b.merc10.Vo64")
	check(value("q.gz18h.q64ah") == 1 and value("q.gz17h.qk31h") == 1 and value("q.gz18h.q65h") == 1 and value("q.gz18h.q66h") == 1 and s.state.quest_items.has("note"),"three ordinary conversations start the authored quests and supply delivery letter")
	await enter("gz17h"); start(["VCheck#0#59","VCheck#0#62","VCheck#0#67"])
	approach(47192); check(value("q.gz17h.qk31h") == 1 and value("b.Nekro.Ne64_3") == 0,"living original succubus blocks optional reward")
	kill([47192]); check(value("q.gz17h.qk31h") == 2 and value("b.Nekro.Ne64_3") == 1,"actual succubus death completes optional quest and offers report")
	stable("succubus completion")
	if not await leave("gz17h_gz18h","gz18h"): await finish("BASE_CAMPAIGN_SUSLANGER_TOWN","Stopped at town route"); return
	settle_loaded(["VCheck#0#1","VCheck#0#4","VCheck#0#27","VCheck#0#32","VCheck#0#37","VTriger#0#22","VTriger#0#52",
		"VTriger#0#59","VTriger#0#60","VTriger#0#62","VTriger#0#63","VCheck#0#73","VCheck#0#84","VCheck#0#87","VTriger#0#94","VTriger#0#97","VCheck#0#150"])
	teleport(Vector2(240,200)); approach(47539); kill([47539])
	check(value("q.gz18h.q64ah") == 1 and value("q.gz18h.q64ah.3") == 2,"one living supervisor prevents the two-brothers quest completion")
	await roundtrip("base_town_last_supervisor",["q.gz18h.q64ah","q.gz18h.q64ah.3"])
	teleport(Vector2(145,105)); approach(47536); kill([47536])
	check(value("q.gz18h.q64ah") == 2 and value("b.Kuzn.Kuz64_3") == 1 and value("b.Glav.Gl64_3") == 1,"both authored supervisor deaths unlock their two report conversations")
	teleport(Vector2(125,170)); teleport(Vector2(61,69)); use(43192)
	check(value("q.gz18h.q65h") == 2 and s.state.quest_items.has("thiefsack"),"ordinary thief chest use earns the stolen sack")
	check(value("b.Glav.Gl66") == 0,"stolen sack alone cannot unlock the joint main-quest continuation")
	teleport(Vector2(233,94)); teleport(Vector2(265,34))
	await roundtrip("base_town_pending_letter",["q.gz18h.q65h","q.gz18h.q66h","q.gz18h.q66h.3"],["note","thiefsack"])
	use(47541)
	check(value("q.gz18h.q66h") == 2 and not s.state.quest_items.has("note") and value("b.Glav.Gl66") == 1 and value("b.merc10.Vo65") == 1,"normal letter delivery consumes its item and jointly unlocks main plus optional continuation")
	stable("town paired obligations")
	await enter("bz14h"); await complete("b.Nekro.Ne64_3"); await complete("b.Kuzn.Kuz64_3"); await complete("b.Glav.Gl64_3")
	check(value("b.guru.Guru1") == 1,"supervisor report offers the authored training reward")
	var dex_before := float(s.state.heroes[0][0].get("dex",0))
	await complete("b.guru.Guru1")
	check(float(s.state.heroes[0][0].get("dex",0)) == dex_before+3,"actual Guru reward adds exactly three Dexterity")
	await complete("b.merc10.Vo65"); await complete("b.Glav.Gl66")
	check(value("q.gz18h.qk30h") == 1 and value("q.gz18h.q67h") == 1,"actual return topics start manor theft and Junofil meeting")
	await enter("gz18h")
	start(["VTriger#0#10","VCheck#0#40","VCheck#0#119","VTriger#0#122","VCheck#0#127","VCheck#0#132","VTriger#0#137","VCheck#0#142","VCheck#0#145","VTriger#0#153","VCheck#0#159"]); ticks(12)
	check(s.world.units.has(1000061),"accepted meeting quest installs its original market encounter")
	use(150158,false)
	check(value("q.gz18h.qk30h") == 1,"manor gate remains locked without the actual guard key")
	teleport(Vector2(120,350)); approach(150159)
	await loot_key("zone18.mob","manorkey00")
	await roundtrip("base_town_manor_key",["q.gz18h.qk30h","q.gz18h.qk30h.4"],["manorkey00"])
	use(150158)
	check(not s.state.quest_items.has("manorkey00") and value("q.gz18h.qk30h.4") == 2,"normal manor gate consumes its earned key")
	approach_object(150157)
	var money_before := s.state.money; use(150157)
	check(value("q.gz18h.qk30h") == 2 and s.state.money == money_before+100000 and value("b.merc10.Vo65_1") == 1,"ordinary manor chest use pays exactly the authored 100000 and offers report")
	stable("manor completion")
	teleport(Vector2(124,236)); ticks(10)
	check(value("q.gz18h.q67h.1") == 2 and value("q.gz18h.q67h") == 1,"market approach does not skip the original encounter trigger")
	check(vm().globals.get("GMarket",[]).size() == 7,"market addon shares all seven authored guards with the quest")
	kill([1000061,1000062,1000063,1000064,1000065,1000066])
	check(value("q.gz18h.q67h") == 1,"last living market guard prevents meeting completion")
	await roundtrip("base_town_last_market_guard",["q.gz18h.q67h","q.gz18h.q67h.2"])
	kill([1000067]); ticks(10)
	check(value("q.gz18h.q67h") == 2 and value("b.bz16h.jf67") == 1,"all seven original market guard deaths complete meeting and offers its real report")
	if not await leave("bz16h"): await finish("BASE_CAMPAIGN_SUSLANGER_TOWN","Stopped at Junofil meeting return"); return
	await complete("b.bz16h.jf67")
	check(not s.state.quest_items.has("thiefsack") and value("b.Nekro.Ne67") == 1,"Junofil meeting consumes earned sack and unlocks necromancer route")
	await enter("bz14h"); start(["VCheck#0#48"]); await complete("b.merc10.Vo65_1")
	check(value("amerc_10") == 1,"actual optional manor report and earned letter delivery unlock mercenary recruitment")
	await roundtrip("base_town_complete",["q.gz17h.qk31h","q.gz17h.qk32h","q.gz18h.q64ah","q.gz18h.q65h","q.gz18h.q66h","q.gz18h.q67h","q.gz18h.qk30h","b.Nekro.Ne67","amerc_10"])
	await finish("BASE_CAMPAIGN_SUSLANGER_TOWN","Prepared independently covered q63h-complete/Gl63-offered boundary. Actual Gl63→imperial seal chest/Gl64 unlocks supervisor pair, succubus, thief sack and letter; normal pickups, kills, delivery and hand-ins unlock manor and Junofil meeting; guard loot/key consumption/chest payout, Guru Dexterity reward, original market encounter/jf67 sack consumption and mercenary eligibility. Ordinary desert and town exits, pending/completed saves, last supervisor/missing key controls and duplicate suppression. Combat/walking accelerated by god mode, kill and teleport cheats; no native comparison claim.")
