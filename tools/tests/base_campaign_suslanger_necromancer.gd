extends "base_campaign_suslanger_support.gd"
## Prepared Ne67 offer earned by the town suite's actual Junofil hand-in.
## The old-necromancer, corpse/laboratory and artifact obligations are unearned.
func _ready() -> void: run.call_deferred()

func run() -> void:
	boot(); s.state.god_modes[0] = 1; s.mod_config.rules.auto_exit = 0
	s.state.set_var(0,"b.Nekro.Ne67",1)
	s.state.set_var(0,"z.gz17h_bz15h",1)
	await enter("bz14h"); await complete("b.Nekro.Ne67")
	check(value("q.gz17h.q68h") == 1 and value("q.gz17h.q69h") == 0,"actual Nekro conversation starts the approach quest only")
	await enter("gz17h"); start(["VTriger#0#2","VCheck#0#54"])
	check(value("z.gz17h_bz15h") == 1,"authored old-necromancer return edge remains closed before the original approach")
	teleport(Vector2(292,290)); check(value("q.gz17h.q68h") == 1,"outside original meeting area leaves approach unfinished")
	teleport(Vector2(302,290))
	check(value("q.gz17h.q68h") == 2 and value("b.bz15h.Sn67") == 1 and s._exit_is_open(3),"inside original meeting area completes approach and opens actual destination")
	if not await leave("bz15h"): await finish("BASE_CAMPAIGN_SUSLANGER_NECROMANCER","Stopped at old necromancer arrival"); return
	await complete("b.bz15h.Sn67")
	check(value("q.gz17h.q69h") == 1 and value("b.OldNekro.Sn67_1") == 1,"actual arrival conversation starts laboratory retrieval and offers its equipment")
	await complete("b.OldNekro.Sn67_1")
	check(s.state.items.any(func(item):return "uniquegipathadagan" in String(item).to_lower()),"actual old-necromancer offer supplies authored regeneration armor")
	if not await leave("gz17h_bz15h","gz17h"): await finish("BASE_CAMPAIGN_SUSLANGER_NECROMANCER","Stopped at laboratory route"); return
	settle_loaded(["VCheck#0#10","VCheck#0#25","VCheck#0#30","VCheck#0#38","VTriger#0#39","VTriger#0#45","VCheck#0#49"])
	teleport(Vector2(235,70)); use(45069)
	check(value("q.gz17h.q69h.2") == 2 and value("q.gz17h.q69h") == 1,"normal outer laboratory control advances only the entry objective")
	use(45103,false)
	check(not s.state.quest_items.has("necrolabkey00") and value("q.gz17h.q69h") == 1,"laboratory gate blocks corpse retrieval while its key is missing")
	await loot_key("zone17.mob","necrolabkey00")
	check(value("q.gz17h.q69h.3") == 2 and value("q.gz17h.q69h.4") == 1,"ordinary key-carrier loot advances laboratory key objective")
	await roundtrip("base_necro_lab_key",["q.gz17h.q69h","q.gz17h.q69h.4"],["necrolabkey00"])
	teleport(Vector2(290,106)); use(45103)
	check(not s.state.quest_items.has("necrolabkey00") and value("q.gz17h.q69h.5") == 2 and value("q.gz17h.q69h") == 1,"normal laboratory gate consumes key but still requires corpse interaction")
	use(47217)
	check(value("q.gz17h.q69h") == 2 and s.state.quest_items.has("deadscientist00") and value("b.OldNekro.Sn69") == 1,"ordinary corpse pickup earns scientist remains, completion and report")
	stable("scientist retrieval")
	await roundtrip("base_necro_corpse",["q.gz17h.q69h","b.OldNekro.Sn69"],["deadscientist00"])
	if not await leave("bz15h"): await finish("BASE_CAMPAIGN_SUSLANGER_NECROMANCER","Stopped at scientist return"); return
	start(["VCheck#0#7","VCheck#0#11"])
	check(value("b.OldNekro.Sn69_1") == 0,"spirit sequel waits for actual corpse report")
	await complete("b.OldNekro.Sn69"); ticks(65)
	check(value("NecroSummon") == 1 and value("b.OldNekro.Sn69_1") == 1,"actual corpse report and summoning sequence offer the spirit conversation")
	await complete("b.OldNekro.Sn69_1")
	check(not s.state.quest_items.has("deadscientist00") and value("q.gz18h.q70h") == 1,"spirit conversation consumes corpse and starts artifact retrieval")
	ticks(30)
	await enter("gz18h"); start(["VCheck#0#15","VCheck#0#43","VTriger#0#102","VTriger#0#110"])
	teleport(Vector2(210,303)); teleport(Vector2(205,342))
	check(value("q.gz18h.q70h.2") == 2 and value("q.gz18h.q70h") == 1,"reaching artifact site still requires chest use")
	use(47543)
	check(value("q.gz18h.q70h") == 2 and s.state.quest_items.has("brokentoy") and value("b.Nekro.Ne70") == 1,"ordinary artifact chest supplies broken device and actual report")
	stable("artifact retrieval")
	await enter("bz14h"); await complete("b.Nekro.Ne70")
	check(value("b.Glav.Gl70") == 1 and value("q.gz19h.q71h") == 0,"actual Nekro report unlocks Glav's final city offer")
	await complete("b.Glav.Gl70")
	check(value("q.gz19h.q71h") == 1 and value("z.gz19h") == 1 and s.state.quest_items.has("brokentoy"),"actual Glav offer starts city meeting, reveals its map and preserves final device")
	await roundtrip("base_necro_complete",["q.gz17h.q68h","q.gz17h.q69h","q.gz18h.q70h","q.gz19h.q71h","z.gz19h"],["brokentoy"])
	await finish("BASE_CAMPAIGN_SUSLANGER_NECROMANCER","Prepared Ne67 offered after independently covered Junofil hand-in, and earlier closed old-necromancer route. Actual Ne67→original approach area and exit→Sn67/armor→outer control/carrier loot/keyed laboratory/corpse→Sn69 summoning/Spirit→artifact chest→Ne70/Gl70 city offer. Missing-key, boundary, required pickup, key/corpse consumption, actual travel, pending/completed saves and duplicate controls; god mode, kill cheats and teleportation. Not a native-executable comparison.")
