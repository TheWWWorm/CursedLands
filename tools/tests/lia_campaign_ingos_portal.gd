extends "lia_campaign_support.gd"
## Starts at the separately earned mine-document/missing-person checkpoint.
## All later hand-ins, gate keys, scenes and portal activation are earned.

func _ready() -> void: run.call_deferred()

func run() -> void:
	boot(); chapter("Gipat","Hero3","Hero","merc2g")
	# mid_ingos earns q15k and its document/offer; investigation earns q16k
	# acceptance and MThief230. Keep these earlier seams explicit.
	s.state.set_var(0,"q.gz24k.q15k",2)
	s.state.set_var(0,"q.gz21k.q16k",1)
	s.state.set_var(0,"b.Huber.brief_240",1)
	s.state.set_var(0,"b.MThief.brief_230",2)
	s.state.add_item("MageDocs")
	await missing_person()
	await ambush_and_betrayal()
	await portal_keys()
	await finish("LIA_CAMPAIGN_INGOS_PORTAL","Prepared mine-document and accepted missing-person checkpoint earned in the other Ingos fixtures. Actual q16k recovery and three-way hand-in gate, q17k corpse/ambush, Gerald dual hand-ins, q18k betrayal plus full scene/return, q19k keyed laboratory, q20k keyed ice pass and q21k two physical door controls/key/portal/scene. Negative missing key, missing final hand-in, corpse loot and preactivation entrance checks; saved pending/completed states and ordinary destination loads. Final cz4k departure already covered by lia_kel_handoffs. God mode, teleport, kills; no native-executable claim.")

func missing_person() -> void:
	await enter("gz21k"); start(["VCheck#5#1","VCheck#5#4"]); ticks(25)
	teleport(Vector2(176,22))
	check(value("q.gz21k.q16k") == 1 and not s.state.quest_items.has("deadbrissen"),"missing-person approach cannot substitute for collecting the evidence")
	use(1016001)
	check(value("q.gz21k.q16k") == 2 and s.state.quest_items.has("deadbrissen") and value("b.MThief.brief_243") == 1,"actual evidence pickup completes the missing-person quest")
	await enter("bz22k"); start(["VCheck#0#6","VCheck#0#7"])
	await complete("b.MThief.brief_243")
	check(value("b.Huber.brief_245") == 0,"missing-person hand-in alone cannot skip the mine-document and witness hand-ins")
	await enter("bz21k"); start(["VCheck#0#7"])
	await complete("b.Huber.brief_240")
	check(not s.state.quest_items.has("magedocs"),"actual mine-document hand-in consumes its evidence")
	check(value("b.Huber.brief_245") == 0,"mine and missing-person hand-ins still require the witness")
	await enter("bz22k"); start(["VCheck#0#6","VCheck#0#7"])
	check(value("b.Vor.brief_244") == 1,"mine hand-in and recovered missing-person evidence offer the actual witness discussion")
	await complete("b.Vor.brief_244")
	check(value("b.Huber.brief_245") == 1,"all actual hand-ins unlock Huber's next quest discussion")
	await enter("bz21k"); await complete("b.Huber.brief_245"); await complete("b.His.brief_245a")
	check(value("q.gz21k.q17k") == 1,"actual Huber and His conversation chain starts the ambush investigation")

func ambush_and_betrayal() -> void:
	await enter("gz21k"); start(["VCheck#6#1"]); ticks(25)
	teleport(Vector2(237,109)); kill([1017002,1017003])
	check(value("q.gz21k.q17k.2") == 1,"one surviving ambusher keeps the investigation combat objective pending")
	kill([1017004])
	check(value("q.gz21k.q17k") == 1,"defeated ambushers do not replace looting the actual evidence corpse")
	await roundtrip("campaign_ingos_ambush_body",["q.gz21k.q17k","q.gz21k.q17k.3"])
	loot(1017001)
	check(value("q.gz21k.q17k") == 2 and value("b.Huber.brief_246") == 1 and value("b.Gerald.brief_248") == 1,"ordinary evidence loot completes the investigation and offers both follow-ups")
	await enter("bz21k"); await complete("b.Huber.brief_246")
	check(value("b.Gerald.brief_247") == 1,"actual Huber follow-up offers Gerald's first discussion")
	await enter("bz22k"); start(["VCheck#0#5"])
	await complete("b.Gerald.brief_247")
	check(value("b.merc2.brief_249") == 0,"one Gerald discussion cannot unlock the betrayal quest")
	await complete("b.Gerald.brief_248")
	check(value("b.merc2.brief_249") == 1,"both actual Gerald discussions offer Kel's next quest")
	await complete("b.merc2.brief_249")
	check(value("q.gz23k.q18k") == 1,"actual Kel offer starts the betrayal quest")
	await enter("gz23k"); start(["VCheck#4#1"]); ticks(25)
	teleport(Vector2(195,60)); teleport(Vector2(52,123)); kill([1018002])
	check(value("q.gz23k.q18k") == 1,"defeating the betrayal guard still requires collecting its cache")
	use(1018001)
	check(value("q.gz23k.q18k") == 2 and s.state.quest_items.has("animalmoney") and s.state.quest_items.has("goldnugget00"),"normal cache use grants the two actual betrayal rewards")
	ticks(55)
	if not await wait_zone("cz3k"): return
	await simulate_until("b.Vor.brief_250")
	await complete("b.Vor.brief_250")
	if not await wait_zone("bz21k"): return
	await complete("b.bz21k.brief_250a")
	check(not s.state.quest_items.has("goldnugget00") and value("b.KMage.brief_251") == 1,"actual town return pays out the nugget and offers the mage departure discussion")
	await complete("b.KMage.brief_251")
	check(value("b.KMage.brief_252") == 1,"actual mage departure unlocks the laboratory key offer")
	await enter("bz22k"); start(["VCheck#0#9"])
	await complete("b.KMage.brief_252")
	check(value("q.gz21k.q19k") == 1 and s.state.quest_items.has("kkey03"),"actual relocated mage gives the laboratory key and accepted quest")
	await roundtrip("campaign_ingos_laboratory_key",["q.gz23k.q18k","q.gz21k.q19k","b.KMage.brief_252"],["kkey03"])

func portal_keys() -> void:
	await enter("gz21k"); start(["VCheck#7#1"]); ticks(25)
	teleport(Vector2(494,78))
	check(value("q.gz21k.q19k") == 1,"laboratory target area cannot bypass its actual keyed entrance")
	use(3705); teleport(Vector2(494,78)); use(1019001)
	check(value("q.gz21k.q19k") == 2 and value("b.MThief.brief_253") == 1,"keyed entrance and actual laboratory cache complete the key-exchange prerequisite")
	await enter("bz22k"); await complete("b.MThief.brief_253")
	check(value("q.gz25k.q20k") == 1 and s.state.quest_items.has("kkey04") and not s.state.quest_items.has("kkey03"),"actual thief hand-in exchanges the laboratory key for the ice-pass key")
	check(value("z.gz21k_gz25k") == 2,"actual key exchange opens the ice-desert route")
	await enter("gz21k")
	if not await leave("gz21k_gz25k","gz25k"): return
	ticks(8); vm().instances.clear(); start(["VCheck#0#1"]); ticks(25)
	gate("gz26k",false,"forgotten portal destination remains closed before the ice-pass mechanism")
	teleport(Vector2(95,173))
	check(value("q.gz25k.q20k") == 1,"ice-pass approach still requires its keyed mechanism")
	use(4368)
	check(value("q.gz25k.q20k") == 2 and int(s.world.levers[1122].state) == 1,"actual keyed mechanism completes the ice pass and opens its physical door")
	gate("gz26k",true,"completed ice pass opens the forgotten portal destination")
	await roundtrip("campaign_ice_pass_open",["q.gz25k.q20k","z.gz26k"],["kkey04"])
	if not await leave("gz26k"): return
	ticks(30)
	check(value("q.gz26k.q21k") == 1,"ordinary portal-zone arrival accepts its final quest")
	use(1021001,false); use(1021002,false); use(43974,false)
	teleport(Vector2(67,163))
	check(s.zone_id == "gz26k" and value("q.gz26k.q21k") == 1,"entering the unactivated portal cannot leave the island")
	use(1021003)
	check(s.state.quest_items.has("kkey05") and value("q.gz26k.q21k.2") == 1,"actual portal key chest unlocks the two room controls")
	use(1021001); use(1021002)
	check(int(s.world.levers[5223993].state) == 1 and int(s.world.levers[4555].state) == 1,"both actual keyed controls open their physical portal-room doors")
	use(4309)
	check(s.state.quest_items.has("teleportkey01") and value("q.gz26k.q21k.3") == 1,"normal inner chest supplies the actual portal activation key")
	await roundtrip("campaign_portal_activation_key",["q.gz26k.q21k","q.gz26k.q21k.3"],["kkey05","teleportkey01"])
	use(43974); ticks(35)
	check(value("q.gz26k.q21k.4") == 1 and value("q.gz26k.q21k") == 1,"actual activation animation still requires entering the portal")
	teleport(Vector2(67,163))
	if not await wait_zone("cz4k"): return
	check(value("q.gz26k.q21k") == 2,"actual activated-portal entry completes the final Ingos quest")
	await simulate_until("b.merc2.brief_254")
	check(value("b.merc2.brief_254") == 1,"full original departure scene offers the independently tested Jigran transfer")
