extends "lia_campaign_late_support.gd"
## Prepared q6j report and completed duel handoff from the arrival/handoff
## suites. Earn and carry q8j..q12j through actual objects and conversations.
func _ready() -> void: run.call_deferred()
func run() -> void:
	boot(); s.state.god_modes[0] = 1
	s.state.create_party("Jigran2")
	s.state.add_party_unit("Jigran2","Hero","Hero3")
	s.state.add_party_unit("Jigran2","merc2","merc2g")
	s.state.set_current_party("Jigran2")
	for key: String in ["b.BSon.brief_324","q.gz31j.q6j","z.gz31j_gz33j","z.bz32j"]: s.state.set_var(0,key,2)
	for key: String in ["b.Stark.brief_319","b.Baron.brief_323","start_zone31"]: s.state.set_var(0,key,1)
	await enter("bz31j"); start(["VCheck#0#1"])
	await complete("b.Baron.brief_323")
	check(value("b.Baron.brief_329") == 0,"completed duel conversations alone cannot unlock the next battle")
	await complete("b.Stark.brief_319")
	check(value("q.gz31j.q8j") == 1,"actual Stark conversation grants material quest")
	await enter("gz31j"); start(["VCheck#3#1"]); ticks(30)
	use(1008002,false)
	check(value("q.gz31j.q8j") == 1,"smith refuses the missing carried material")
	use(1008001)
	check(s.state.quest_items.has("jmaterial") and value("q.gz31j.q8j.1") == 2,"actual source grants quest material")
	await roundtrip("lia_jigran_material",["q.gz31j.q8j.1"],["jmaterial"])
	var adamantium_before := s.state.items.count("material.adamantium")
	party_at(Vector2(36,213)); use(1008002)
	check(value("q.gz31j.q8j") == 2 and not s.state.quest_items.has("jmaterial"),"smith consumes carried material and completes quest")
	check(s.state.items.count("material.adamantium") == adamantium_before+4,"smith grants authored adamantium reward")
	poll_once("material conversion")
	await enter("bz31j"); await complete("b.Stark.brief_320"); await complete("b.Baron.brief_321")
	await enter("bz32j"); await complete("b.Doctor.brief_322")
	check(value("q.gz33j.q9j") == 1,"actual Baron/Doctor continuation grants documents quest")
	await enter("gz33j"); start(["VCheck#1#1"]); ticks(30)
	party_at(Vector2(185,226))
	check(value("q.gz33j.q9j.2") == 1 and not s.state.quest_items.has("jdocs"),"document destination still waits for container use")
	use(1009001)
	check(value("q.gz33j.q9j") == 2 and s.state.quest_items.has("jdocs"),"actual container completes document quest and grants documents")
	await enter("bz31j"); await complete("b.Baron.brief_326")
	check(not s.state.quest_items.has("jdocs"),"actual Baron document report removes the carried documents")
	await enter("bz32j"); await complete("b.Doctor.brief_325")
	check(value("q.gz33j.q10j") == 1,"actual Doctor report grants two-ingredient quest")
	await enter("gz33j"); start(["VCheck#2#1"]); ticks(30)
	# The two objectives are independent: deliberately collect mushroom first.
	party_at(Vector2(346,72)); use(1010002)
	check(s.state.quest_items.has("jmush") and not s.state.quest_items.has("jpump") and value("q.gz33j.q10j") == 1,
		"one of two ingredients cannot complete the Doctor's quest")
	check(value("b.Doctor.brief_327") == 0,"one ingredient does not offer the cooking conversation")
	await roundtrip("lia_jigran_one_ingredient",["q.gz33j.q10j.4"],["jmush"])
	party_at(Vector2(255,179)); use(1010001)
	check(value("q.gz33j.q10j") == 2 and s.state.quest_items.has("jpump") and s.state.quest_items.has("jmush"),
		"both independently earned ingredients complete the gathering quest")
	use(1011001,false)
	check(value("q.gz33j.q11j") == 0,"ritual object refuses missing meal before Doctor's actual conversation")
	await enter("bz32j"); await complete("b.Doctor.brief_327")
	check(value("q.gz33j.q11j") == 1 and s.state.quest_items.has("ragu") and not s.state.quest_items.has("jpump") and not s.state.quest_items.has("jmush"),
		"actual cooking conversation consumes both ingredients and grants meal plus ritual quest")
	await enter("gz33j"); start(["VCheck#3#1"]); ticks(30)
	party_at(Vector2(107,101))
	check(value("q.gz33j.q11j.1") == 2,"alternate original approach circle advances meal quest")
	party_at(Vector2(208,146)); use(1011001)
	check(value("q.gz33j.q11j") == 2 and not s.state.quest_items.has("ragu"),"actual keyed object consumes meal and completes the quest")
	poll_once("meal ritual")
	await roundtrip("lia_jigran_meal_complete",["q.gz33j.q11j"])
	await enter("bz31j"); start(["VCheck#0#1"])
	check(value("b.Baron.brief_329") == 1,"earned meal completion plus both duel reports unlock battle offer")
	await complete("b.Baron.brief_329")
	check(value("q.gz33j.q12j") == 1,"actual Baron conversation grants the village battle")
	await enter("gz33j"); start(["VCheck#4#1"]); ticks(30)
	check(value("z.gz31j_gz33j") == 1 and value("z.bz32j") == 1,"accepted battle closes retreat and Doctor settlement gates")
	check(not s._exit_is_open(1) and not s._exit_is_open(3),"ordinary west and settlement exits honor the live battle gates")
	party_at(Vector2(347,167)); kill([1012100,153102])
	check(value("q.gz33j.q12j") == 1 and value("z.bz32j") == 1,"last battle target keeps victory and settlement return closed")
	kill([153004])
	check(value("q.gz33j.q12j") == 2 and value("z.gz31j_gz33j") == 2 and value("z.bz32j") == 2,"all required battle targets dead completes quest and reopens both gates")
	check(s._exit_is_open(1) and s._exit_is_open(3),"both ordinary exit controls reopen after earned battle victory")
	await roundtrip("lia_jigran_village_battle",["q.gz33j.q12j","z.gz31j_gz33j","z.bz32j"])
	if not await normal_exit(3,"bz32j"):
		await finish("LIA_CAMPAIGN_LATE_SUPPLIES","Prepared q6j/duel reports; earned q8j..q12j, but actual reopened settlement exit failed."); return
	await complete("b.Doctor.brief_330")
	await enter("bz31j"); await complete("b.Baron.brief_331")
	await enter("bz32j"); await complete("b.Doctor.brief_332")
	check(value("q.gz34j.q13j") == 1 and value("q.gz34j.q14j") == 1 and value("z.gz33j_gz34j") == 2,
		"actual victory reports grant both western quests and open their travel route")
	await finish("LIA_CAMPAIGN_LATE_SUPPLIES","Prepared q6j report offer, completed duel handoff and its Baron report offer. Carried actual q8j material conversion→q9j documents→q10j both ingredients in reverse order→q11j meal→q12j battle, all associated conversations and item consumption; earned q13j/q14j offers and western route. Negative item/partial-objective gates, battle closure/reopening, actual settlement exit, save/reload and once-only rewards. Combat and walking use cheats; other travel is accelerated. Not native execution or proof of the prepared earlier prerequisites.")
