extends "lia_kel_support.gd"
## Purchased Gipat fortune flags are prepared inputs. The downstream archive
## scripts, gates, actions, quest completion and saves execute normally.

func _ready() -> void: run.call_deferred()

func loot(id: int) -> void:
	var corpse: GameUnit = s.world.units.get(id)
	if not check(corpse != null and corpse.dead,"authored key carrier is lootable"): return
	var h := hero()
	teleport(corpse.pos)
	s.apply_command({"t":"loot","units":[h.uid],"target":id},0)
	vm()._check_interactions()
	for i in 160:
		h.tick(GameUnit.TICK)
		if h.order.get("type","") != "use" and h.orders.is_empty() and not h.has_meta("interact"): break
	ticks()

func run() -> void:
	boot()
	await enter("gz9g")
	start(["VCheck#4#1","VCheck#4#4","VCheck#4#6"])
	check(value("zone9_fq8") == 0 and not s.world.objects.has(1011003),"missing mushroom fortune does not spawn its quest objects")
	s.state.set_var(0,"b.shava.fq8",2); ticks(30)
	check(value("zone9_fq8") == 1 and s.world.objects.has(1011003),"mushroom fortune spawns actual randomized quest objects")
	use(1011001)
	check(value("q.gz9g.fq8") == 0,"wrong mushroom does not complete quest")
	use(1011003)
	check(value("q.gz9g.fq8") == 2,"correct mushroom completes original eighth fortune")
	await roundtrip("lia_fortune_mushrooms",["q.gz9g.fq8"])
	await enter("gz11g")
	start(["VCheck#6#1","VCheck#6#2","VCheck#6#3"])
	check(value("zone11_fq9") == 0,"missing clerk fortune does not start its scene")
	s.state.set_var(0,"b.shava.fq9",2); ticks(15)
	check(value("zone11_fq9") == 1,"clerk fortune creates actual scene")
	use(1000000,false)
	check(value("q.gz11g.fq9") == 0,"clerk's cage rejects use before obtaining his key")
	kill([980429]); loot(980429)
	check(s.state.quest_items.has("clerkkey00"),"ordinary corpse loot obtains the authored clerk key")
	use(1000000)
	check(value("q.gz11g.fq9") == 2,"actual clerk-scene object completes ninth fortune")
	await enter("gz16g")
	start(["VCheck#3#1","VCheck#3#2","VCheck#3#5","VCheck#4#1","VCheck#4#2","VCheck#4#3","VCheck#4#4","VCheck#4#5","VCheck#4#6","VCheck#4#7"])
	use(4955,false)
	check(value("zone16_fq10") == 0,"captive fortune remains inactive without topic")
	s.state.set_var(0,"b.shava.fq10",2); ticks(20)
	use(4955)
	var captive: GameUnit = s.world.units.get(1131193)
	check(captive != null and captive.faction == 0,"opening captive gate assigns actual captive to player faction")
	check(value("q.gz16g.fq10") == 0,"freeing captive alone does not complete escort")
	await roundtrip("lia_fortune_captive_freed",["zone16_fq10","q.gz16g.fq10"])
	captive = s.world.units.get(1131193)
	teleport(Vector2(68.51,169),captive)
	check(value("q.gz16g.fq10") == 0,"captive just outside destination radius keeps escort pending")
	teleport(Vector2(68,169),captive)
	check(value("q.gz16g.fq10") == 2 and int(s.world.levers[1034227].state) == 1,"captive arrival completes quest and opens escape door")
	s.state.set_var(0,"b.shava.fq12",2); ticks(20)
	check(value("zone16_fq12") == 1,"giant fortune begins authored food sequence")
	use(2139639,false)
	check(value("zone16_fq12") == 1,"feeding point rejects missing food")
	use(3398867)
	check(value("zone16_fq12") == 2 and s.state.quest_items.has("ogrefood"),"first food container grants actual quest item")
	use(2139639)
	check(value("zone16_fq12") == 3 and not s.state.quest_items.has("ogrefood"),"first feeding consumes original food")
	var giant: GameUnit = s.world.units.get(3398862)
	teleport(Vector2(267.5,144.8),giant)
	check(value("zone16_fq12") == 4 and s.world.lever_sys.usable(3398868),"giant arrival makes second food container usable")
	use(3398868)
	check(value("zone16_fq12") == 5 and s.state.quest_items.has("ogrefood"),"second food container advances sequence")
	teleport(Vector2(270,145),giant)
	use(2139639)
	check(value("zone16_fq12") == 6 and not s.state.quest_items.has("ogrefood"),"second feeding consumes its food while giant is away")
	await roundtrip("lia_fortune_giant_second_food",["zone16_fq12","q.gz16g.fq12"])
	giant = s.world.units.get(3398862)
	teleport(Vector2(267.5,144.8),giant)
	check(value("q.gz16g.fq12") == 0,"giant arrival waits for authored poisoning sequence")
	ticks(110)
	check(giant.dead and value("q.gz16g.fq12") == 2,"authored delayed giant death completes twelfth fortune")
	await enter("gz7g")
	start(["VCheck#5#1","VCheck#5#2"])
	check(value("zone7_fq11") == 0,"missing eleventh fortune keeps encounter unstarted")
	s.state.set_var(0,"b.shava.fq11",2); ticks(25)
	check(value("zone7_fq11") == 1 and value("q.gz7g.fq11") == 0,"actual encounter waits for living target")
	kill([2215845])
	check(value("q.gz7g.fq11") == 2,"actual encounter target death completes eleventh fortune")
	await enter("gz11d1")
	start(["VCheck#1#1","Crypt#4"])
	use(1712,false)
	check(int(s.world.levers[1030051].state) == 0,"crypt door remains closed without its fortune key")
	# Exercise the original briefing reward data instead of inventing a key.
	s.state.money = maxi(s.state.money,500)
	vm().briefings._rewards("fq13")
	check(s.state.quest_items.has("ambushkey04"),"thirteenth fortune reward grants original crypt key")
	use(1712)
	check(int(s.world.levers[1030051].state) == 1,"keyed mechanism opens actual crypt door")
	check(not s.state.quest_items.has("kel2") and value("q.gz11d1.fq13") == 0,"entering crypt alone does not award fragment")
	use(4357253)
	check(value("q.gz11d1.fq13") == 2 and s.state.quest_items.has("kel2"),"actual crypt chest grants second Rod fragment and completes quest")
	await roundtrip("lia_kel_second_fragment",["q.gz11d1.fq13","zone11dun1_cr4"],["kel2"])
	var before := accounting()
	await enter("gz11g"); await enter("gz11d1"); ticks(20)
	check(s.state.quest_items.has("kel2") and accounting() == before,"crypt revisit preserves fragment without replaying chest rewards")
	await finish("LIA_KEL_GIPAT","Gipat fortune outcomes fq8..fq13 with supplied accepted topics; actual randomized objects, captive and giant positions, missing key/food, authored delayed poisoning, real crypt key/chest, full saves and revisit. Movement and fighting accelerated; no native executable claim.")
