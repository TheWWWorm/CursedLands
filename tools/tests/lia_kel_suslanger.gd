extends "lia_kel_support.gd"
## The paid fortune itself is a prepared input (covered by astral_fortune).
## All five downstream outcomes use the installed maps and authored threads.

func _ready() -> void: run.call_deferred()

func run() -> void:
	boot()
	await enter("gz1h")
	start(["Raja#0","Raja#1","DeadMan#1","DeadMan#3","Chest#4"])
	check(value("q.gz1h.fq2") == 0,"living torch-quest target prevents completion")
	s.state.set_var(0,"b.skelet.fq2",2); ticks()
	check(s.world.lever_sys.usable(2261640),"purchased first fortune enables actual torch")
	kill([1140714])
	check(value("q.gz1h.fq2") == 2,"actual target death completes first fortune quest")
	check(value("deadman") == 0,"missing fourth fortune cannot reveal its dead-man key")
	s.state.set_var(0,"b.skelet.fq4",2); ticks(40)
	check(value("deadman") == 50,"fourth fortune reveals the authored corpse")
	check(s.world.levers[2001539].science == [1,0,0],"original fourth-fortune chest has no key requirement")
	check(value("q.gz1h.fq4") == 0,"revealing corpse alone does not complete treasure quest")
	use(2017083)
	check(s.state.quest_items.has("traderkey1"),"using actual corpse grants its trader key")
	use(2001539)
	check(value("q.gz1h.fq4") == 2 and s.state.quest_items.has("fakedocument00"),"actual fourth-fortune chest grants document and completes quest")
	await roundtrip("lia_fortune_torch_deadman",["q.gz1h.fq2","q.gz1h.fq4"],["fakedocument00"])
	# Elder's earlier story handoff assigns this entry quest. Its original
	# Start disables the graveyard chest before any fortune is purchased.
	s.state.set_var(0,"q.gz2h.q5h",1)
	await enter("gz2h")
	vm().time_fixed = true; s.state.world_time = 12.2
	start(["BigBasket#1#1","BigBasket#2#1","BigBasket#3#1","Undead#1#1","Undead#4#1","Chest#3"])
	check(int(s.world.levers[16372].state) == 0,"no fortune keeps midday basket door closed")
	s.state.set_var(0,"b.skelet.fq3",2); s.state.world_time = 12.0; ticks()
	check(int(s.world.levers[16372].state) == 0,"midday lower boundary is strict")
	s.state.world_time = 12.2; ticks()
	check(int(s.world.levers[16372].state) == 1,"correct midday window opens basket route")
	s.state.world_time = 12.6; ticks()
	check(int(s.world.levers[16372].state) == 0,"expired midday window closes the unfinished basket route")
	var fruit_before := s.state.items.size()
	use(2135816)
	check(value("q.gz2h.fq3") == 2,"actual basket use completes third fortune")
	check(not s.world.lever_sys.usable(12133776),"inside escape switch waits for authored fruit reward sequence")
	ticks(35)
	check(s.state.items.size() == fruit_before+75,"all five delayed fruit batches grant original 75 items exactly once")
	check(s.world.lever_sys.usable(12133776),"basket completion enables the inside escape switch")
	use(12133776)
	check(int(s.world.levers[16372].state) == 1,"inside switch reopens closed basket route after completion")
	s.state.set_var(0,"b.skelet.fq5",2); s.state.world_time = 22.0; ticks()
	check(vm()._num(vm().globals.get("N")) == 0,"undead do not appear at strict night boundary")
	s.state.world_time = 22.2; ticks(8)
	check(vm()._num(vm().globals.get("N")) == 1,"night time activates authored undead encounter")
	use(1072720,false)
	kill([150058,150059,150066,1178767,150062,150063])
	check(not s.world.lever_sys.usable(1072720) and value("q.gz2h.fq5") == 0,"last living undead still blocks quest chest")
	await roundtrip("lia_fortune_last_undead",["q.gz2h.fq3","q.gz2h.fq5"])
	kill([1178500])
	check(s.world.lever_sys.usable(1072720),"last undead death enables actual quest chest")
	use(1072720)
	check(value("q.gz2h.fq5") == 2,"opening unlocked chest completes fifth fortune")
	await enter("gz4h")
	start(["VLever1#0#0","VLever1#0#1","VLever2#0#1","VLever3#0#1","VLevers#0#5","VChest#0#3"])
	for id in [16426,1047355,1088298]:
		check(not s.world.lever_sys.usable(id),"missing final fortune keeps sequence lever disabled "+str(id))
	s.state.set_var(0,"b.skelet.fq6",2); ticks()
	for id in [16426,1047355,1088298]: check(s.world.lever_sys.usable(id),"final fortune enables sequence lever "+str(id))
	use(1088298)
	check(value("CaveLever") == 30,"third lever records first sequence digit")
	await roundtrip("lia_kel_first_sequence_digit",["CaveLever","q.gz4h.fq6"])
	use(16426)
	check(value("CaveLever") == 310,"first lever appends second sequence digit after reload")
	check(not s.state.quest_items.has("kel1"),"two levers cannot grant the first Rod fragment")
	use(1047355); ticks(5)
	check(value("CaveLever") == 5000,"correct 3-1-2 order resolves chest branch")
	var chest: Node3D = s.world.objects.get(33345906)
	check(chest != null and Vector2(chest.get_meta("ei").position.x,chest.get_meta("ei").position.y).distance_to(Vector2(202,52)) < 0.01,
		"sequence physically reveals original fragment chest")
	use(33345906)
	check(value("q.gz4h.fq6") == 2 and s.state.quest_items.has("kel1"),"actual revealed chest completes first Rod fragment quest")
	await roundtrip("lia_kel_first_fragment",["q.gz4h.fq6"],["kel1"])
	var before := accounting()
	await enter("gz2h"); await enter("gz4h"); ticks(30)
	check(value("q.gz4h.fq6") == 2 and s.state.quest_items.has("kel1"),"first fragment survives real map revisit")
	check(accounting() == before,"revisiting completed fragment chest cannot replay its rewards")
	await finish("LIA_KEL_SUSLANGER","All five Suslanger fortune quest outcomes on loaded owned maps; source-paid fortune flags supplied, actual use/key/death/clock/lever sequence, missing prerequisites, save/reload and revisit. Combat and movement cheated; not native executable parity.")
