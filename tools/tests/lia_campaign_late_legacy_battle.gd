extends "lia_campaign_late_support.gd"
## Default: reconstruct only the two old saved namespace fields from an
## actual pending battle. An optional --legacy-source-dir replays untouched
## saves generated by the pre-fix engine, retained outside the repository.
const Repair = preload("res://src/game/script/story_astral_battle_saves.gd")
const ALL := "lia_legacy_battle_all_alive"
const LAST := "lia_legacy_battle_last_alive"

func _ready() -> void: run.call_deferred()

func legacy_fields(slot: String) -> void:
	check(s.save_game(slot) == OK,"save actual pending battle for legacy namespace fixture")
	var saved := CampaignState.load_from(SaveInfo.path(slot))
	var globals: Dictionary = saved.zones.gz35j.vm.globals
	for group: String in ["ArEvil","Kanians"]:
		globals[group+"_zone35battle"] = globals[group]
		globals[group] = []
	check(saved.save(SaveInfo.path(slot)) == OK,"write only the two genuine older namespace fields")

func old_globals() -> Dictionary:
	var groups := vm().globals.duplicate()
	for name: String in ["ArEvil","Kanians"]:
		groups[name+"_zone35battle"] = groups[name]
		groups[name] = []
	return groups

func guards() -> void:
	var live := vm().globals
	var old := old_globals()
	vm().globals = old.duplicate(); s.state.campaign_id = CampaignProfile.ORIGINAL
	check(not Repair.recover(vm()) and vm().globals.ArEvil.is_empty(),"base campaign never migrates LiA battle aliases")
	s.state.campaign_id = CampaignProfile.ASTRAL
	s.zone_id = "gz34j"
	check(not Repair.recover(vm()),"another LiA zone never migrates battle aliases")
	s.zone_id = "gz35j"
	var mobs: Array = s.world.get_meta("added_mobs",[])
	s.world.set_meta("added_mobs",[])
	check(not Repair.recover(vm()),"missing actual battle AddMob record prevents migration")
	s.world.set_meta("added_mobs",mobs)
	var source: String = s.world.mob.script_text
	s.world.mob.script_text += "\n// modified content\n"
	check(not Repair.recover(vm()),"modified zone script prevents migration")
	s.world.mob.script_text = source
	s.state.set_var(0,"q.gz35j.q21j.1",2)
	check(not Repair.recover(vm()),"already completed combat objective is never rewound")
	s.state.set_var(0,"q.gz35j.q21j.1",1); s.state.set_var(0,"q.gz35j.q21j",2)
	check(not Repair.recover(vm()),"already completed whole quest is never migrated")
	s.state.set_var(0,"q.gz35j.q21j",1)
	vm().globals = old.duplicate(); vm().globals.ArEvil = [s.world.units[1021101]]
	check(not Repair.recover(vm()) and vm().globals.ArEvil.size() == 1,"existing populated parent group is never replaced")
	vm().globals = old.duplicate(); vm().globals.ArEvil_zone35battle = old.ArEvil_zone35battle.slice(0,38)
	check(not Repair.recover(vm()),"partial legacy enemy alias is not guessed or filled")
	vm().globals = old.duplicate(); vm().globals.Kanians_zone35battle = old.Kanians_zone35battle.duplicate()
	vm().globals.Kanians_zone35battle[0] = s.world.units[1021101]
	check(not Repair.recover(vm()),"wrong actor in legacy ally alias prevents migration")
	vm().globals = old.duplicate(); vm().globals.ArEvil_zone35battle = old.ArEvil_zone35battle.duplicate()
	vm().globals.ArEvil_zone35battle[1] = vm().globals.ArEvil_zone35battle[0]
	check(not Repair.recover(vm()),"duplicate legacy actor cannot replace a missing enemy")
	vm().globals = old.duplicate(); vm().globals.ArEvil_zone35battle = old.ArEvil_zone35battle.duplicate()
	vm().globals.ArEvil_zone35battle[0] = 1021101
	check(not Repair.recover(vm()),"unresolved numeric actor reference is not treated as a living unit")
	vm().globals = live
	check(not Repair.recover(vm()),"current shared-group format is unchanged")

func replay(all_slot: String,last_slot: String,label: String) -> void:
	check(await s.load_game_shown(all_slot),label+": load actual pending all-alive save"); freeze()
	check(value("q.gz35j.q21j") == 1 and value("q.gz35j.q21j.1") == 1 and value("q.gz35j.q21j.2") == 0,label+": restore preserves pending objective flags")
	check(vm().globals.ArEvil.size() == 39 and vm().globals.ArEvil.all(func(u):return u is GameUnit and not u.dead),label+": restored parent group contains all 39 living enemies")
	check(vm().globals.Kanians.size() == 34,label+": restored parent ally group contains all original actors")
	check(not vm().globals.has("ArEvil_zone35battle") and not vm().globals.has("Kanians_zone35battle"),label+": migrated save drops only obsolete group aliases")
	ticks(120)
	check(value("q.gz35j.q21j.1") == 1 and value("q.gz35j.q21j.2") == 0,label+": original delayed watcher stays blocked while enemies live")
	await roundtrip(label+"_migrated_all_alive",["q.gz35j.q21j.1","q.gz35j.q21j.2"])
	check(vm().globals.ArEvil.size() == 39 and not Repair.recover(vm()),label+": resaved migration is persistent and idempotent")
	check(await s.load_game_shown(last_slot),label+": load independently saved last-enemy legacy state"); freeze()
	ticks(120)
	check(vm().globals.ArEvil.filter(func(u):return not u.dead).size() == 1 and not s.world.units[1021139].dead,label+": restore preserves the actual one survivor")
	check(value("q.gz35j.q21j.1") == 1 and value("q.gz35j.q21j.2") == 0,label+": one survivor still blocks the actual completion watcher")
	kill([1021139])
	check(value("q.gz35j.q21j.1") == 2 and value("q.gz35j.q21j.2") == 1 and value("q.gz35j.q21j") == 1,label+": actual last death advances combat but still requires portal approach")
	await roundtrip(label+"_migrated_last_death",["q.gz35j.q21j.1","q.gz35j.q21j.2","q.gz35j.q21j"])
	poll_once(label+": last death completion")

func run() -> void:
	boot(); s.state.god_modes[0] = 1
	s.state.create_party("Jigran3")
	s.state.add_party_unit("Jigran3","Hero","Hero3")
	s.state.add_party_unit("Jigran3","merc2","merc2")
	s.state.set_current_party("Jigran3")
	s.state.set_var(0,"q.gz35j.q21j",1)
	await s.enter_zone("gz35j",1,false); freeze()
	for i in 60:
		ticks(1)
		if value("q.gz35j.q21j.1") == 1: break
	check(value("q.gz35j.q21j.1") == 1 and vm().globals.ArEvil.size() == 39,"actual battle initializer reaches populated pending stage")
	guards()
	legacy_fields(ALL)
	kill(range(1021101,1021139))
	check(value("q.gz35j.q21j.1") == 1 and not s.world.units[1021139].dead,"preparation keeps original pending objective and final survivor")
	legacy_fields(LAST)
	await replay(ALL,LAST,"legacy_reconstructed")
	for arg: String in OS.get_cmdline_user_args():
		if not arg.begins_with("--legacy-source-dir="): continue
		var dir := arg.trim_prefix("--legacy-source-dir=")
		for slot: String in [ALL,LAST]:
			check(DirAccess.copy_absolute(dir.path_join(slot+".sav"),SaveInfo.path("actual_"+slot)) == OK,"copy genuine pre-fix save into isolated profile: "+slot)
			check(DirAccess.copy_absolute(dir.path_join(slot+".info.sav"),SaveInfo.path("actual_"+slot,"info.sav")) == OK,"copy genuine pre-fix save metadata: "+slot)
		await replay("actual_"+ALL,"actual_"+LAST,"legacy_actual")
	await finish("LIA_CAMPAIGN_LATE_LEGACY_BATTLE","Prepared accepted final battle; actual initializer and kills provide pending actors/flags. Default fixture reconstructs only the two known pre-fix saved namespace fields; optional legacy-source-dir additionally loads untouched saves produced by the earlier remake. Verified stock-source/zone/campaign/addon/pending/malformed-state guards, persistent/idempotent migration, living and last-survivor blocks, actual last-death transition and saves. No completed objective is rewound; no broad AddMob or mod namespace migration.")
