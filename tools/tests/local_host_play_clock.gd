extends "local_host_campaign.gd"
func _ready() -> void:
	process_mode=Node.PROCESS_MODE_ALWAYS
	GameData.options.merge({"net_upnp":0,"net_websocket":0,"net_lan":0,"net_directory":0,"autosave":0,"show_tutorial":0},true)
	var s:=Session.new();get_parent().add_child(s)
	var g:=Game.new();g.session=s;s.game=g;get_parent().add_child(g)
	check(await s.local_host.start(0,1,true)==OK,"solo authority starts")
	await s.new_campaign(false)
	check(await until(func():return s.world!=null and not s._remote_loading,30),"solo world arrives")
	for speed in [0,1]:
		for paused in [false,true]:
			s.restore_play_clock({"paused":paused,"speed":speed})
			var slot:="clock-worker-%s-%s"%[speed,paused]
			var answer:=await s.local_host.request("save",{"slot":slot,"camera":s.local_host.view()})
			check(answer.get("ok",false),"save via solo worker")
			var state:=CampaignState.load_from(SaveInfo.path(slot))
			check(state!=null and state.play_clock=={"paused":paused,"speed":speed},"worker save keeps gameplay clock")
			s.restore_play_clock({"paused":not paused,"speed":1-speed})
			answer=await s.local_host.request("load",{"slot":slot})
			check(answer.get("ok",false),"load via solo worker")
			check(await until(func():return not s._remote_loading and g.speed==speed and get_tree().paused==paused,30),"owner restores speed and pause after worker load")
			check(is_equal_approx(Engine.time_scale,55.0/27.0 if speed else 1.0),"owner simulation rate restored")
	s.restore_play_clock({})
	s.request_mod_rules({"difficulty":1}, {})
	check(await until(func():return GameData.difficulty == 1 and s.mod_config.rules.difficulty == 1), "live difficulty reaches the solo authority and owner")
	var saved_rules := await s.local_host.request("save", {"slot":"live-difficulty"})
	var saved_state := CampaignState.load_from(SaveInfo.path("live-difficulty"))
	check(saved_rules.get("ok",false) and saved_state.mod_config.rules.difficulty == 1, "authority persists live difficulty in the actual save")
	s.request_mod_rules({"difficulty":0}, {})
	check(await until(func():return GameData.difficulty == 0), "normal difficulty applies without travel")
	var loaded_rules := await s.local_host.request("load", {"slot":"live-difficulty"})
	check(loaded_rules.get("ok",false) and await until(func():return not s._remote_loading and GameData.difficulty == 1), "reload restores the saved live difficulty")
	s.restore_play_clock({"paused":true,"speed":1})
	g.hud._dialog.show_briefing({"id":"test","phrases":[{}],"staging":true})
	check(not get_tree().paused and Engine.time_scale == 1.0 and s.field_speed == 0, "solo dialogue clears pause and acceleration")
	var dialogue_save := await s.local_host.request("save", {"slot":"dialogue-clock"})
	var dialogue_state := CampaignState.load_from(SaveInfo.path("dialogue-clock"))
	check(dialogue_save.get("ok",false) and dialogue_state.play_clock == {"paused":false,"speed":0}, "solo authority saves the normal dialogue clock")
	await s.local_host.stop()
	print("LOCAL_HOST_PLAY_CLOCK ",checks," checks ",failures," failures")
	get_tree().quit(1 if failures else 0)
