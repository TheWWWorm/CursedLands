extends "base_campaign_ingos_support.gd"
## Starts with a lone protagonist arriving on Ingos. No quest outcomes or
## offers are supplied: the actual first-entry root offers q42 and K42.

func _ready() -> void: run.call_deferred()

func run() -> void:
	ingos()
	await enter("gz11k")
	start(["VCheck#0#11","VTriger#0#40"])
	check(value("q.gz11k.q42k") == 1,"original Ingos arrival starts the town quest")
	check(value("b.bz8k.K42") == 0,"town introduction is absent before reaching town")
	teleport(Vector2(195,120)); teleport(Vector2(283,205))
	check(value("q.gz11k.q42k") == 1,"arrival waypoints do not finish the town objective")
	teleport(Vector2(336,268)); ticks(8)
	done("q.gz11k.q42k","reaching the original town completes arrival")
	gate("bz8k",true,"earned arrival opens the town passage")
	if not await leave("bz8k"):
		await finish("BASE_CAMPAIGN_INGOS_ARRIVAL","Stopped at original town passage"); return
	await complete("b.bz8k.K42")
	await complete("b.Trapper.T42")
	check(value("q.gz11k.q43k") == 1,"normal Trapper offer accepts the detective investigation")
	await enter("gz11k")
	start(["VCheck#0#12","VTriger#0#40","VCheck#0#60"])
	teleport(Vector2(460,314)); near_object(3592)
	check(value("q.gz11k.q43k") == 1 and not has_item(27),"finding the detective's body requires ordinary loot")
	loot(3592); ticks(8)
	done("q.gz11k.q43k","ordinary detective loot completes investigation")
	check(value("b.Huber.G43") == 1,"detective evidence offers the governor conversation")
	await roundtrip("base_ingos_detective",["q.gz11k.q42k","q.gz11k.q43k","b.Huber.G43"],[item_name(27)])
	await enter("gz13k"); use(4375,false)
	check(value("q.gz13k.q44k") == 0,"skin-delivery mechanism rejects the missing skins before its actual offer")
	await enter("bz8k")
	start(["VCheck#0#1"])
	await complete("b.Huber.G43"); await complete("b.Shopper.Tr43_1"); await complete("b.Trapper.T43_1")
	check(value("q.gz13k.q44k") == 1 and has_item(33),"normal dialogue chain accepts skin delivery and supplies its skins")
	await enter("gz13k")
	start(["VCheck#0#60","VTriger#0#288","VCheck#0#265"])
	near_object(4276)
	check(value("q.gz13k.q44k") == 1,"approaching the buyer does not deliver the skins")
	use(4375); ticks(8)
	done("q.gz13k.q44k","ordinary delivery switch completes the skin errand")
	check(not has_item(33) and value("b.Trapper.T44") == 1,"delivery consumes skins and offers Trapper's follow-up")
	await enter("bz8k")
	await complete("b.Trapper.T44")
	check(value("q.gz13k.q48k") == 1,"actual skin hand-in accepts the document theft")
	check(vm()._by_name("mthief") != null and not vm()._by_name("mthief").hidden,"earned skin delivery reveals Lovkach on town revisit")
	await enter("gz13k")
	start(["VCheck#0#65","VTriger#0#119","VCheck#0#145","VCheck#0#148","VCheck#0#283"])
	near_object(4217)
	check(value("q.gz13k.q48k.9") == 1,"actual mill approach discovers the optional distraction objective")
	use(4217)
	check(value("q.gz13k.q48k.9") == 2,"ordinary mill-machine use completes the optional alarm distraction")
	teleport(Vector2(264,81)); near_object(4434)
	check(not has_item(67) and value("q.gz13k.q48k") == 1,"finding the decoy document does not collect it")
	use(4434)
	check(has_item(67),"normal decoy document pickup earns the authored replacement")
	teleport(Vector2(370,164)); teleport(Vector2(365,172)); near_object(4307)
	check(value("q.gz13k.q48k") == 1,"decoy and manager approach still require real document loot")
	await roundtrip("base_ingos_documents_pending",["q.gz13k.q48k"],[item_name(67)])
	steal_original(4307)
	done("q.gz13k.q48k","ordinary pickpocketing completes document theft with its manager alive")
	check(not s.world.units[4307].dead and has_item(40) and not has_item(67),"successful live theft obtains the real book and consumes the decoy")
	teleport(Vector2(276,169)); teleport(Vector2(279,173)); ticks(8)
	check(value("q.gz13k.q48k.7") == 2,"ordinary return through the authored escape points completes the theft's final subobjective")
	stable("nonlethal manager theft")
	check(await s.load_game_shown("base_ingos_documents_pending"),"restore pending manager encounter for the combat alternative")
	freeze(); await frames(); ticks(8)
	check(value("q.gz13k.q48k") == 1 and not s.world.units[4307].dead,"saved encounter restores the uncompleted theft and living manager")
	if await loot_original("zone13.mob",40):
		ticks(8); done("q.gz13k.q48k","ordinary manager loot completes document theft")
		check(not has_item(67) and value("b.Shopper.Tr48") == 1,"document recovery consumes the decoy and offers Shopper")
		gate("bz10k",false,"document theft keeps the distant camp closed until the hidden-route quest")
		await enter("bz8k"); await complete("b.Shopper.Tr48")
		check(value("q.gz12k.q49k") == 1,"actual document hand-in accepts the governor's chest quest")
		await roundtrip("base_ingos_documents",["q.gz13k.q44k","q.gz13k.q48k","q.gz12k.q49k"],[item_name(40)])
	stable("Ingos arrival and investigation")
	await finish("BASE_CAMPAIGN_INGOS_ARRIVAL","Lone protagonist at original Ingos arrival; no accepted quests/outcomes supplied. Original q42 town arrival, K42/T42 introductions, q43 body loot, Huber/Shopper/Trapper chain, q44 actual skin delivery and Lovkach reveal, q48 decoy pickup with both ordinary live pickpocket and killed/looted manager branches restored from one pending save, and actual q49 offer. Original roots only; ordinary dialogue/use/theft/loot, gate and town travel, missing skin/item negatives, saves and duplicate rewards. Combat, skills and walking accelerated; no native-executable parity claim.")
