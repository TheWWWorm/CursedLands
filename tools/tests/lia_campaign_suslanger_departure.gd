extends "lia_campaign_support.gd"
## Continues the completed bones/boss checkpoint independently earned by
## lia_campaign_early_suslanger. All later offers and departure gates are earned.

func _ready() -> void: run.call_deferred()

func run() -> void:
	boot(); chapter("FSusel","Hero2","Hero2")
	for key: String in ["q.gz1h.q01h","q.gz1h.q02h","q.gz3h.q17h","q.gz4h.q19h","q.gz4h.q20h"]: s.state.set_var(0,key,2)
	s.state.set_var(0,"b.Guru.brief_52",1); s.state.set_var(0,"b.Glav.brief_53",1)
	s.state.add_item("SackofBones")
	await report_and_ritual()
	await harpy_and_sack()
	await sergeant()
	await finish("LIA_CAMPAIGN_SUSLANGER_DEPARTURE","Starts from the separately earned bones/boss/rescuer checkpoint. Normal Guru/Glav dual hand-ins unlock the Sheriff's report quest; q22oh report unlocks q21h ritual and q21oh sack; q22h rescued harpy plus actual sack hand-in jointly unlock the northern route; q23h arrival and q24h three-site clearance unlock Sergeant88a. Pending saves, one missing prerequisite and duplicate reward checks. Actual route exit and destination loads; god mode, teleport and combat kills. Final island transfer already covered by lia_kel_departures; no native-executable claim.")

func report_and_ritual() -> void:
	await enter("bz2h"); start(["VCheck#1#7"])
	check(value("b.Sheriff.brief_82") == 0,"report offer waits for both real bones/boss hand-ins")
	await enter("bz4h"); await complete("b.Guru.brief_52")
	await enter("bz2h"); start(["VCheck#1#7"])
	check(value("b.Sheriff.brief_82") == 0,"Guru hand-in alone cannot unlock the report quest")
	await enter("bz3h"); await complete("b.Glav.brief_53")
	check(not s.state.quest_items.has("sackofbones"),"actual Glav hand-in consumes the earned bones")
	await enter("bz2h"); start(["VCheck#1#7"])
	check(value("b.Sheriff.brief_82") == 1,"both actual hand-ins offer the report quest")
	await complete("b.Sheriff.brief_82")
	check(value("q.gz3h.q22oh") == 1,"actual Sheriff offer starts report retrieval")
	await enter("gz3h"); start(["VCheck#8#1"]); ticks(25)
	use(2157896)
	check(value("q.gz3h.q22oh.2") == 1 and value("q.gz3h.q22oh") == 1,"opening the report building leaves document collection pending")
	await roundtrip("campaign_report_inside",["q.gz3h.q22oh","q.gz3h.q22oh.2"])
	use(1022101)
	check(value("q.gz3h.q22oh") == 2 and s.state.quest_items.has("report"),"normal report pickup completes retrieval")
	check(value("b.Sheriff.brief_83") == 1 and value("b.YCF.brief_63") == 1,"retrieval offers both real report follow-ups")
	await enter("bz2h"); await complete("b.Sheriff.brief_83")
	check(value("b.merc7.brief_59") == 1,"actual report hand-in offers the sack quest")
	await complete("b.YCF.brief_63")
	check(value("q.gz2h.q21h") == 1 and s.state.quest_items.has("burnbaby"),"actual YCF offer supplies the ritual item and quest")
	await enter("gz2h"); start(["VCheck#5#1"]); ticks(25)
	teleport(Vector2(287,30))
	check(value("q.gz2h.q21h.2") == 1 and value("q.gz2h.q21h") == 1,"ritual approach cannot replace using its item")
	use(1021001)
	check(not s.state.quest_items.has("burnbaby") and value("q.gz2h.q21h") == 1,"ritual use consumes its actual item but waits for the authored transformation")
	await roundtrip("campaign_necromancer_transform",["q.gz2h.q21h","q.gz2h.q21h.2"])
	ticks(100)
	check(value("q.gz2h.q21h") == 2 and value("b.Glav.brief_70") == 1,"authored transformation completes ritual and offers the next main handoff")
	stable("necromancer ritual completion")
	await enter("bz3h"); await complete("b.Glav.brief_70")
	check(value("b.Guru.brief_71") == 1,"actual Glav follow-up offers Guru's harpy quest")
	await complete("b.merc7.brief_59")
	check(value("q.gz3h.q21oh") == 1,"actual report-derived sack conversation starts its quest")
	await enter("bz4h"); await complete("b.Guru.brief_71")
	check(value("q.gz3h.q22h") == 1,"actual Guru offer starts harpy rescue")

func harpy_and_sack() -> void:
	await enter("gz3h"); start(["VCheck#6#1","VCheck#6#3","VCheck#7#1","VCheck#7#9"]); ticks(25)
	teleport(Vector2(226,188)); use(45912); ticks(20)
	var harpy: GameUnit = s.world.units.get(1022001)
	if not check(harpy != null and not harpy.dead,"opened cage leaves the actual harpy alive for escort"): return
	check(value("q.gz3h.q22h") == 1 and value("q.gz3h.q22h.3") == 1,"opening the harpy cage does not complete its return objective")
	await roundtrip("campaign_harpy_open_cage",["q.gz3h.q22h","q.gz3h.q22h.3","q.gz3h.q21oh"])
	harpy = s.world.units.get(1022001)
	teleport(Vector2(44,16),harpy); ticks(20)
	check(value("q.gz3h.q22h") == 2 and value("b.Guru.brief_72") == 1,"living harpy reaching the actual return area completes rescue")
	teleport(Vector2(44,104)); kill([1021103])
	check(value("q.gz3h.q21oh") == 1,"defeating the sack guard still requires ordinary chest use")
	use(1021101)
	check(value("q.gz3h.q21oh") == 2 and s.state.quest_items.has("thiefsack1") and value("b.merc7.brief_59a") == 1,"first original sack is sufficient for the authored alternative completion")
	await enter("bz3h"); start(["VCheck#2#4"])
	await complete("b.merc7.brief_59a")
	check(value("b.merc7.brief_85") == 2 and not s.state.quest_items.has("thiefsack1"),"real sack hand-in consumes its item and satisfies the departure prerequisite")
	check(value("b.merc2.brief_86") == 0,"sack hand-in alone cannot offer northern departure")
	await enter("bz4h"); start(["VCheck#1#1"])
	await complete("b.Guru.brief_72")
	check(value("b.merc2.brief_86") == 1,"both actual main hand-ins offer Kel's northern departure")
	await complete("b.merc2.brief_86")
	check(value("q.gz5h.q23h") == 1 and value("z.gz4h_gz5h") == 2,"actual Kel conversation starts northern arrival and opens its route")
	await roundtrip("campaign_north_route",["q.gz3h.q22h","q.gz3h.q21oh","q.gz5h.q23h","z.gz4h_gz5h"])

func sergeant() -> void:
	await enter("gz4h")
	if not await leave("gz4h_gz5h","gz5h"): return
	ticks(8); threads(["VCheck#0#1"]); ticks(25)
	teleport(Vector2(195,319))
	check(value("q.gz5h.q23h") == 1,"outside northern arrival radius does not offer the Sergeant")
	teleport(Vector2(206,319))
	check(value("q.gz5h.q23h") == 2 and value("b.Sergant.brief_87") == 1,"actual northern approach completes arrival and offers the Sergeant quest")
	if not await leave("bz7h"): return
	await complete("b.Sergant.brief_87")
	check(value("q.gz5h.q24h") == 1,"actual Sergeant conversation starts the three-site clearance")
	if not await leave("gz5h_bz7h","gz5h"): return
	ticks(8); threads(["VCheck#1#1"]); ticks(25)
	teleport(Vector2(250,126)); kill([2025967,2025970,2025965,2025964,2025966])
	check(value("q.gz5h.q24h.4") == 1,"last first-camp enemy prevents that clearance objective")
	kill([2025969])
	teleport(Vector2(261,230)); kill([2025951,2025957,2025961,2025960,2025959])
	check(value("q.gz5h.q24h") == 1 and value("b.Sergant.brief_88") == 0,"both cleared camps still require reaching the final site")
	await roundtrip("campaign_north_final_site",["q.gz5h.q24h","q.gz5h.q24h.2","q.gz5h.q24h.4","q.gz5h.q24h.5"])
	teleport(Vector2(57,260))
	check(value("q.gz5h.q24h") == 2 and value("b.Sergant.brief_88") == 1,"all three actual objectives offer the island-departure hand-in")
	stable("northern clearance")
	if not await leave("bz7h"): return
	await complete("b.Sergant.brief_88")
	check(value("b.Sergant.brief_88a") == 1,"actual final Sergeant hand-in unlocks the independently tested island transfer")
	await roundtrip("campaign_suslanger_departure",["q.gz5h.q23h","q.gz5h.q24h","b.Sergant.brief_88a"])
