extends "base_campaign_gipat_support.gd"

func _ready() -> void:
	await run()

func run() -> void:
	boot(); s.state.god_modes[0] = 1
	var alternative := "--alternative-investigation" in OS.get_cmdline_user_args()
	await offer("bz1g","b.elder.s8_2","q.gz9g.q12g")
	await enter("gz9g"); start(["VCheck#0#7","VCheck#0#90"]); watch("VCheck#0#96" if alternative else "VCheck#0#95",hero())
	var gold_exit := Vector2(138,147) if alternative else Vector2(108,127)
	teleport(gold_exit); check(value("q.gz9g.q12g") == 1,"gold-valley escape without the sack cannot finish retrieval")
	use(2051); check(s.state.quest_items.has("sackofgold") and value("q.gz9g.q12g") == 1,"gold chest yields its sack but still requires leaving the valley")
	await roundtrip("base_gipat_gold_valley",["q.gz9g.q12g","q.gz9g.q12g.2"],["sackofgold"])
	arm("q.gz9g.q12g"); teleport(gold_exit); quest("q.gz9g.q12g","gold valley escape")
	await enter("bz1g"); var purse := s.state.money
	await complete("b.elder.s12")
	check(s.state.money == purse+400 and not s.state.quest_items.has("sackofgold"),"normal Elder report exchanges the sack for exactly 400 gold")
	await complete("b.elder.s12_4")
	await enter("gz7g"); start(["VCheck#0#28"]); ticks(30)
	rearm_mob("zone7zasada.mob",["VCheck#1#4","VCheck#1#13","VCheck#1#16","VCheck#1#19","VCheck#1#20","VCheck#1#21","VCheck#1#22","VCheck#1#31","VCheck#1#34","VCheck#1#39","VCheck#1#42","VCheck#1#45","VCheck#1#51"])
	check(s.world.units.has(1000095),"actual ambush quest adds its original leader")
	var leader: GameUnit = s.world.units.get(1000095)
	teleport(leader.pos+Vector2(0.1,0)); hero().facing = PI; ticks(24)
	check(value("q.gz7g.q13ag") == 1,"seeing the original ambush leader starts the authored optional evidence branch")
	var goblins := group_ids("Goblin-Z")
	kill(goblins.slice(0,goblins.size()-1)); check(value("q.gz7g.q13g") == 1,"last ambush goblin still blocks the main combat objective")
	arm("q.gz7g.q13g"); kill([goblins[-1]]); quest("q.gz7g.q13g","ambush goblins")
	dead("ZLeader"); check(value("q.gz7g.q13ag") == 1,"ambush leader death still requires collecting his instructions")
	var ambush_groups := group_ids("Zasada"); kill(ambush_groups)
	for point in range(4,9): check(value("q.gz7g.q13ag."+str(point)) == 2,"actual ambush group clears optional point "+str(point))
	await roundtrip("base_gipat_ambush_body",["q.gz7g.q13g","q.gz7g.q13ag"])
	arm("q.gz7g.q13ag"); collect("ZLeader"); quest("q.gz7g.q13ag","ambush instructions")
	check(value("z.gz7g_gz8g") == 0 and value("z.gz7g_gz9g") == 0,"looted ambush instructions reopen the blocked regional passages")
	await enter("bz1g"); await complete("b.elder.s13_3")
	await enter("bz2g"); await complete("b.witch.z13_2")
	await enter("gz8g"); start(["VCheck#0#11","VCheck#0#16","VCheck#0#75"])
	dead("OrcShB"); check(value("q.gz8g.q14g") == 1,"alphabet quest waits for loot after shaman death")
	arm("q.gz8g.q14g"); collect("OrcShB"); quest("q.gz8g.q14g","orc alphabet")
	await enter("bz2g"); await complete("b.witch.z14")
	check(not s.state.quest_items.has("orcalphabet") and not s.state.quest_items.has("instruction4orcs00"),"Witch consumes both real pieces of deciphering evidence")
	await enter("gz7g"); start(["VCheck#0#33"]); ticks(30)
	rearm_mob("zone7letter.mob",["VCheck#2#7","VCheck#2#12","VCheck#2#15","VCheck#2#23","VCheck#2#30"])
	check(s.world.objects.has(1000101),"actual letter quest adds its paper hiding place")
	arm("q.gz7g.q19g")
	if alternative:
		var runner: GameUnit = vm().globals.get("ORunner")
		teleport(runner.pos); ticks(12)
		check(not s.world.objects.has(1000101) and value("q.gz7g.q19g.2") == 1,"actual orc detection removes the hidden letter and puts it on the runner")
		dead("ORunner"); check(value("q.gz7g.q19g") == 1,"detected runner must still be looted after his death")
		collect("ORunner")
	else: use(1000101)
	quest("q.gz7g.q19g","original hidden-letter or runner branch")
	await enter("bz1g"); await complete("b.elder.s19"); await complete("b.sheriff.v19_1")
	check(value("q.gz3g.q23g") == 1 and not s.state.quest_items.has("letter2orcs00"),"ordinary evidence report consumes the letter and grants the sheriff confrontation")
	await enter("gz3g"); start(["VCheck#0#258"]); ticks(30)
	rearm_mob("zone3obrvoev.mob",["VCheck#1#1","VCheck#1#4"])
	check(value("q.gz3g.q23g") == 1,"living former sheriff blocks his confrontation")
	arm("q.gz3g.q23g"); dead("Voevoda"); quest("q.gz3g.q23g","former sheriff")
	await enter("bz1g"); await complete("b.nsheriff.nv23"); await complete("b.elder.s21_1")
	check(value("amerc_2") == 1 and value("q.gz6g.q24g") == 1,"earned reports unlock the second companion and flower objective")
	await enter("gz6g"); start(["VCheck#0#285"]); ticks(30)
	rearm_mob("zone6flower.mob",["VCheck#1#1","VCheck#1#17"])
	arm("q.gz6g.q24g"); use(1000016); quest("q.gz6g.q24g","magic flower")
	check(s.state.quest_items.has("driadidol01"),"ordinary flower pickup gives the authored plant")
	await enter("bz1g"); await complete("b.smith.m24" if alternative else "b.elder.s24")
	await enter("bz2g"); await complete("b.witch.z24_1")
	await enter("bz1g"); await complete("b.smith.m24_2" if alternative else "b.elder.s24_2"); await complete("b.elder.s24_3" if alternative else "b.smith.m24_3")
	check(value("q.gz6g.q25g") == 1,"actual Elder-first or Smith-first flower discussion starts the provocation quest")
	await enter("gz6g"); start(["VCheck#0#267"]); ticks(30)
	rearm_mob("zone6zs.mob",["VCheck#3#1","VTriger#3#4","VCheck#3#14"])
	teleport(Vector2(61.23,121.22)); check(value("q.gz6g.q25g") == 1,"first provocation location alone is incomplete")
	await roundtrip("base_gipat_provocation_start",["q.gz6g.q25g","q.gz6g.q25g.1"])
	arm("q.gz6g.q25g"); teleport(Vector2(121.86,66.3)); quest("q.gz6g.q25g","provocation destination")
	var ambush := group_ids("Zasada"); kill(ambush)
	check(value("q.gz6g.q25g.3") == 2,"actual provocation attackers complete the optional combat point")
	await enter("bz2g"); await complete("b.witch.z25")
	await roundtrip("base_gipat_investigation_complete",["q.gz9g.q12g","q.gz7g.q13g","q.gz7g.q13ag","q.gz8g.q14g","q.gz7g.q19g","q.gz3g.q23g","q.gz6g.q24g","q.gz6g.q25g"])
	await finish_gipat("BASE_CAMPAIGN_GIPAT_INVESTIGATION","Prepared earlier s8_2 gold offer. Actual q12g chest/either escape/report→q13g ambush and q13ag all five groups/looted instructions→q14g alphabet/report→q19g hidden-letter or detected-runner/loot branch/report→q23g former sheriff/report→q24g flower and Elder-first or Smith-first discussion→q25g provocation points/ambush. Checks partial groups, missing loot, exact money, source additions, actual handoffs, saves and duplicate rewards. Combat/walking accelerated; the playable gold-refusal branch is separate; source-only timeout roots are classified as unreachable.")
