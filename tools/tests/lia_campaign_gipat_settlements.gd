extends "lia_campaign_support.gd"
## q7g offer is the earned endpoint of gip_at_arrival; do not prepare its
## outcome. Carry every quest/item/topic from q7g through opening Karh's village.
func _ready() -> void: run.call_deferred()
func run() -> void:
	boot(); chapter("Gipat","Hero3","Hero","merc2g")
	s.state.set_var(0,"b.OrcPyr.brief_110",1)
	s.state.set_var(0,"q.gz11g.q6g",2)
	await enter("bz8g"); await complete("b.OrcPyr.brief_110")
	check(value("q.gz9g.q7g") == 1,"earned prior rescue report grants q7g through actual briefing")
	await enter("gz9g"); start(["VCheck#0#1"]); ticks(30)
	check(s.save_game("campaign_gipat_orc_alive") == OK,"save living orc rescue checkpoint")
	kill([1007001])
	check(value("q.gz9g.q7g") == 3,"dead orc correctly fails his rescue quest")
	check(await s.load_game_shown("campaign_gipat_orc_alive"),"restore living orc rescue branch"); freeze()
	place_party(Vector2(157,83))
	check(value("q.gz9g.q7g.3") == 1 and value("q.gz9g.q7g") == 1,"actual close approach recruits orc but still requires escape")
	place_party(Vector2(215,55)); ticks(10)
	check(value("q.gz9g.q7g") == 2 and value("b.OrcC.brief_112") == 1,"alternate original escape point completes orc rescue and offers shell quest")
	await enter("bz8g"); await complete("b.OrcC.brief_111"); await complete("b.OrcC.brief_112")
	await enter("gz9g"); start(["VCheck#1#1"]); ticks(30)
	place_party(Vector2(142,170))
	check(value("q.gz9g.q8g.2") == 1 and not s.state.quest_items.has("shell"),"shell approach waits for actual source object")
	use(1433)
	check(value("q.gz9g.q8g") == 2 and s.state.quest_items.has("shell") and value("b.OrcPyr.brief_113") == 1,"actual shell object grants carried shell and battle continuation")
	await roundtrip("campaign_gipat_shell",["q.gz9g.q8g"],["shell"])
	await enter("bz8g"); await complete("b.OrcPyr.brief_113")
	await enter("gz9g"); start(["VCheck#2#1"]); ticks(30)
	place_party(Vector2(83,106))
	var enemies: Array[int] = []
	for group: String in ["Goblins","West","South"]:
		var members: Array = vm().globals.get(group,[])
		check(not members.is_empty(),"actual battle has populated required group "+group)
		for u: GameUnit in members:
			if not u.dead and not enemies.has(u.uid): enemies.append(u.uid)
	check(value("q.gz9g.q9g") == 1 and enemies.size()>1,"living battle population prevents premature victory")
	if enemies.size()>1:
		kill(enemies.slice(0,-1))
		check(value("q.gz9g.q9g") == 1,"last living battle enemy prevents q9g completion")
		kill([enemies[-1]])
	check(value("q.gz9g.q9g") == 2 and value("b.IZ.brief_114") == 1,"all required groups defeated completes battle and offers Rift continuation")
	stable("Gipat settlement battle")
	await enter("bz8g"); await complete("b.OrcC.brief_116"); await complete("b.IZ.brief_114")
	await enter("gz11g"); start(["VCheck#3#1"]); ticks(30)
	place_party(Vector2(41,130)); use(533093)
	check(value("q.gz11g.q10g") == 2 and not s.state.quest_items.has("shell") and value("b.IZ.brief_117") == 1,"actual Rift object consumes carried shell and completes q10g")
	await enter("bz8g"); await complete("b.OrcC.brief_115"); await complete("b.IZ.brief_117"); await complete("b.merc2.brief_117a")
	check(value("q.gz11g.q11g") == 1 and value("z.gz11g_bz14g") == 2,"actual Kel conversation grants Rick route and opens settlement travel")
	await enter("gz11g"); start(["VCheck#4#1"]); ticks(30)
	place_party(Vector2(245,260))
	check(value("q.gz11g.q11g") == 1 and value("q.gz11g.q11g.1") == 1,"Rick destination cannot bypass earlier ordered route approaches")
	place_party(Vector2(364,137)); place_party(Vector2(315,217)); place_party(Vector2(245,260))
	check(value("q.gz11g.q11g") == 2 and value("b.bz14g.brief_118") == 1,"ordered approaches complete Rick route and offer his introduction")
	await roundtrip("campaign_gipat_rick_route",["q.gz11g.q11g","b.bz14g.brief_118"])
	if not await leave("bz14g"):
		await finish("LIA_CAMPAIGN_GIPAT_SETTLEMENTS","Earned q7g..q11g but actual Rick settlement route failed."); return
	await complete("b.bz14g.brief_118"); await complete("b.Rick.brief_119")
	check(value("b.Loozer.brief_120") == 1,"actual Rick report unlocks Loozer's village quest")
	await enter("bz8g"); await complete("b.Loozer.brief_120")
	check(value("q.gz10g.q12g") == 1 and value("z.gz9g_gz10g") == 2,"actual Loozer conversation grants village quest and opens route")
	await enter("gz10g"); start(["VCheck#0#1"]); ticks(30)
	place_party(Vector2(227,88)); place_party(Vector2(174,139))
	kill([33398742,33398743,33398744,33398745])
	check(value("q.gz10g.q12g") == 1 and value("z.bz11g") != 2,"last village attacker keeps Karh's settlement closed")
	kill([33398746])
	check(value("q.gz10g.q12g") == 2 and value("z.bz11g") == 2 and value("z.gz10g_bz11g") == 2,"all required attackers defeated opens Karh village and its route")
	await roundtrip("campaign_gipat_karh_open",["q.gz10g.q12g","z.bz11g","z.gz10g_bz11g"])
	if not await leave("bz11g"):
		await finish("LIA_CAMPAIGN_GIPAT_SETTLEMENTS","Earned q12g but actual Karh settlement route failed."); return
	await complete("b.Karh.brief_121")
	check(value("q.gz10g.q13g") == 1,"actual earned Karh introduction grants hunter quest")
	await finish("LIA_CAMPAIGN_GIPAT_SETTLEMENTS","Prepared prior q6g completion/report offer. Actual q7g living-orc rescue→q8g carried shell→q9g all required battle groups→q10g shell use→q11g ordered Rick route→actual settlement introduction→q12g village defense→actual Karh settlement route and q13g grant. Negative death/partial-group/ordered-area controls, save/reload, once-only and normal dialogue/use/loot/travel. Combat and walking accelerated. Earlier chapter endpoint is declared, not re-earned here.")
