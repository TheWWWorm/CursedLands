extends "base_campaign_gipat_support.gd"

func _ready() -> void:
	await run()

func run() -> void:
	boot(); s.state.god_modes[0] = 1
	await offer("bz2g","b.witch.z38","q.gz6g.q39g")
	await enter("gz6g"); start(["VCheck#0#48"]); ticks(30)
	rearm_mob("zone6gr.mob",["VCheck#2#1","VCheck#2#20"])
	check(value("q.gz6g.q39g") == 1,"daughter remains quest waits for the physical evidence")
	arm("q.gz6g.q39g"); use(1000123); quest("q.gz6g.q39g","daughter evidence")
	await enter("bz2g"); await complete("b.witch.z39")
	check(value("q.gz8g.q40g") == 1 and not s.state.quest_items.has("girlsign"),"actual Witch evidence report starts the orc-chief route")
	await enter("gz8g"); start(["VCheck#0#88","VCheck#0#94","VCheck#0#26"]); watch("VCheck#0#99",hero())
	use(1378,false)
	check(int(s.world.levers[1088].state) != 0,"chief's drawbridge stays raised without its gear")
	collect("OrcSvKey"); use(1378)
	check(int(s.world.levers[1088].state) == 0,"looted gear permits the normal bridge mechanism")
	arm("q.gz8g.q40g"); teleport(Vector2(285,160)); quest("q.gz8g.q40g","orc chief approach")
	check(value("amerc_4") == 1,"earned orc-chief approach makes the fourth companion available")
	await enter("bz6g"); await complete("b.OrcC.Sh40")
	await enter("gz8g"); start(["VCheck#0#112","VCheck#0#113","VCheck#0#114","VCheck#0#134","VCheck#0#135","VCheck#0#141","VCheck#0#142","VCheck#0#143","VCheck#0#162"])
	use(1626,false); use(1669,false)
	check(value("q.gz8g.q40ag") == 1,"later ogre chests reject their missing chained keys")
	dead("OgreKC1"); use(1670)
	check(s.state.quest_items.has("ogrekey1") and not s.state.quest_items.has("ogrekey2"),"first original ogre chest gives only the second chest's key")
	await roundtrip("base_gipat_ogre_first_key",["q.gz8g.q40ag","OC1O"],["ogrekey1"])
	dead("OgreKC2"); use(1626)
	check(s.state.quest_items.has("ogrekey2") and value("q.gz8g.q40ag") == 1,"second chest gives the last key without awarding the treasure")
	arm("q.gz8g.q40ag"); dead("OgreKC3"); var purse := s.state.money; use(1669)
	quest("q.gz8g.q40ag","three ogre chests")
	check(s.state.money == purse+1000,"last ogre chest awards exactly 1000 gold")
	await enter("bz6g"); await complete("b.OrcC.Sh41")
	check(value("q.gz8g.q41g") == 1 and not s.state.quest_items.has("ogrekey1") and not s.state.quest_items.has("ogrekey2"),"actual chief report consumes both spent keys and starts the demon mission")
	await enter("gz8g"); start(["VCheck#0#167"]); ticks(30)
	rearm_mob("zone8demon.mob",["VCheck#1#1","VCheck#1#4"])
	check(value("q.gz8g.q41g") == 1,"living demon blocks the optional finale")
	arm("q.gz8g.q41g"); dead("Demon"); quest("q.gz8g.q41g","demon")
	await enter("bz6g"); await complete("b.OrcC.Sh41_1")
	await enter("bz2g"); await complete("b.witch.z41_1")
	await roundtrip("base_gipat_daughter_complete",["q.gz6g.q39g","q.gz8g.q40g","q.gz8g.q40ag","q.gz8g.q41g"])
	await finish_gipat("BASE_CAMPAIGN_GIPAT_DAUGHTER","Prepared earlier z38 daughter-search offer; actual q39g remains/report→q40g looted bridge gear/normal mechanism/chief approach→Sh40→q40ag three ogres/chained physical chests and exact 1000 gold→Sh41→q41g original added demon and both reports. Missing keys, partial sequence, save/load and duplicate rewards. Walking/combat accelerated; no objective, key or later topic injected.")
